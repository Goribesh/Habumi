+    esigi(s.ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GPU] == 2000000, "2 ms sommati come nanosecondi");
+    esigi(s.chiamate[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GPU] == 2, "due campioni contati");
