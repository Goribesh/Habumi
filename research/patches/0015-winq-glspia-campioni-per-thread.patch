+    winq_glspia_aggiungi(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_GL, 100, 150);    /* 50 tick = 50 us */
+    winq_glspia_aggiungi(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_GL, 200, 210);    /* 10 tick = 10 us */
+    winq_glspia_aggiungi(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_SHADER, 0, 3000); /* 3 ms */
 
     winq_glspia_leggi(&s);
-    esigi(s.ns[WINQ_SPIA_GL] == 60000, "GL: 60 us in nanosecondi");
-    esigi(s.chiamate[WINQ_SPIA_GL] == 2, "GL: due chiamate contate");
