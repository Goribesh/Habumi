@@ -207,12 +230,69 @@ vkr_dispatch_vkCreateInstance(struct vn_dispatch_context *dispatch,
    instance->api_version = app_info.apiVersion;
 
    vn_replace_vkCreateInstance_args_handle(args);
+
+   /* Ripiego sulla versione di API, e perche' serve.
+    *
+    * Il guest chiede la apiVersion della propria applicazione: vulkaninfo
+    * chiede 1.4.347. La chiede legittimamente, perche' il renderer gli ha
+    * riferito 1.4 — ma quel numero viene da vkEnumerateInstanceVersion, che
+    * risponde per il *loader* dell'host, non per l'ICD che c'e' dietro. Su
+    * questa macchina l'unico ICD e' dzn, che arriva a Vulkan 1.2.
+    *
+    * Per la specifica un ICD Vulkan 1.1+ non deve rifiutare vkCreateInstance
+    * per una apiVersion piu' alta di quella che implementa: l'applicazione
+    * riceve un'istanza e semplicemente non deve usare le funzionalita' piu'
+    * recenti. dzn invece fallisce, e con VK_ERROR_OUT_OF_HOST_MEMORY, che
+    * arriva al guest come esaurimento di memoria e manda l'indagine fuori
+    * strada.
+    *
+    * Compensare qui e' il mestiere di un ponte di compatibilita': si riprova
+    * con versioni decrescenti fino alla 1.1, che e' il minimo che Venus
+    * pretende. La versione dei device resta quella vera — la riporta
+    * vkr_physical_device dalle proprieta' del device — quindi il guest non
+    * viene indotto a credere in funzionalita' assenti.
+    */
+   static const uint32_t fallback_versions[] = {
+      VK_API_VERSION_1_3,
+      VK_API_VERSION_1_2,
+      VK_API_VERSION_1_1,
+   };
+   const uint32_t requested = app_info.apiVersion;
+
    args->ret = vk->CreateInstance(create_info, NULL, &instance->base.handle.instance);
+
+   for (uint32_t i = 0; args->ret != VK_SUCCESS && i < ARRAY_SIZE(fallback_versions);
+        i++) {
+      if (fallback_versions[i] >= app_info.apiVersion)
+         continue; /* non si sale, e non si riprova la stessa versione */
+
+      app_info.apiVersion = fallback_versions[i];
+      args->ret =
+         vk->CreateInstance(create_info, NULL, &instance->base.handle.instance);
+   }
+
    if (args->ret != VK_SUCCESS) {
+      vkr_log("vkCreateInstance: l'ICD dell'host ha fallito con %d, anche "
+              "ripiegando fino a 1.1 (richiesta %u.%u.%u)",
