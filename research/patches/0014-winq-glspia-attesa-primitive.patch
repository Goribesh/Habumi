     esigi(s.ns[WINQ_SPIA_GL] == 0, "GL dentro-finestra: intatto, fuori e' parallelo");
     esigi(s.assurde == 0, "fuori non e' un errore: nessuna assurda");
 }
@@ -341,19 +341,108 @@ static void prova_lettura_azzera_campi_nuovi(void)
     winq_glspia_freq_forza(1000000);
     winq_glspia_azzera();
 
-    winq_glspia_aggiungi_fuori(WINQ_SPIA_ATTESA, 0, 1000);
+    winq_glspia_aggiungi_fuori(WINQ_SPIA_WAITSYNC, 0, 1000);
     winq_glspia_somma_finestra(500000);
     winq_glspia_leggi(&s);
-    esigi(s.fuori_ns[WINQ_SPIA_ATTESA] == 1000000, "prima lettura: fuori(ATTESA) 1 ms");
-    esigi(s.fuori_chiamate[WINQ_SPIA_ATTESA] == 1, "prima lettura: una chiamata fuori(ATTESA)");
+    esigi(s.fuori_ns[WINQ_SPIA_WAITSYNC] == 1000000, "prima lettura: fuori(WAITSYNC) 1 ms");
+    esigi(s.fuori_chiamate[WINQ_SPIA_WAITSYNC] == 1, "prima lettura: una chiamata fuori(WAITSYNC)");
     esigi(s.finestra_ns == 500000, "prima lettura: finestra 0,5 ms");
 
     winq_glspia_leggi(&s);
-    esigi(s.fuori_ns[WINQ_SPIA_ATTESA] == 0, "seconda lettura: fuori(ATTESA) azzerato");
-    esigi(s.fuori_chiamate[WINQ_SPIA_ATTESA] == 0, "seconda lettura: zero chiamate fuori(ATTESA)");
+    esigi(s.fuori_ns[WINQ_SPIA_WAITSYNC] == 0, "seconda lettura: fuori(WAITSYNC) azzerato");
+    esigi(s.fuori_chiamate[WINQ_SPIA_WAITSYNC] == 0, "seconda lettura: zero chiamate fuori(WAITSYNC)");
     esigi(s.finestra_ns == 0, "seconda lettura: finestra azzerata");
 }
 
+/* TERZA CORREZIONE DELL'11/08/2026: ATTESA sommava glFlush, glFinish e
+ * glClientWaitSync in un solo secchio. Qui si verifica che i tre secchi
+ * nuovi (FLUSH/FINISH/WAITSYNC) siano davvero indipendenti fra loro e dai
+ * secchi preesistenti (GL/SHADER/GPU) -- il livello macro (winq-glspia.h) non
+ * e' provabile senza GL, ma l'array sottostante (ns[]/chiamate[], dimensionato
+ * su WINQ_SPIA_N) e' lo stesso che le macro useranno, quindi provarlo qui
+ * copre la parte che conta: che allungare l'enum non abbia fatto collidere
+ * due secchi sullo stesso indice. */
+static void prova_secchi_attesa_distinti(void)
+{
+    struct winq_glspia s;
+
+    printf("i tre secchi di attesa sono distinti:\n");
+    winq_glspia_freq_forza(1000000);
+    winq_glspia_azzera();
+
+    winq_glspia_aggiungi(WINQ_SPIA_FLUSH, 0, 100);      /* 100 us */
+    winq_glspia_aggiungi(WINQ_SPIA_FINISH, 0, 200);     /* 200 us */
+    winq_glspia_aggiungi(WINQ_SPIA_WAITSYNC, 0, 300);   /* 300 us */
+
+    winq_glspia_leggi(&s);
+    esigi(s.ns[WINQ_SPIA_FLUSH] == 100000, "FLUSH: 100 us, non contaminato");
+    esigi(s.ns[WINQ_SPIA_FINISH] == 200000, "FINISH: 200 us, non contaminato");
+    esigi(s.ns[WINQ_SPIA_WAITSYNC] == 300000, "WAITSYNC: 300 us, non contaminato");
+    esigi(s.chiamate[WINQ_SPIA_FLUSH] == 1, "FLUSH: una chiamata");
+    esigi(s.chiamate[WINQ_SPIA_FINISH] == 1, "FINISH: una chiamata");
+    esigi(s.chiamate[WINQ_SPIA_WAITSYNC] == 1, "WAITSYNC: una chiamata");
+    esigi(s.ns[WINQ_SPIA_GL] == 0, "GL: intatto");
+    esigi(s.ns[WINQ_SPIA_SHADER] == 0, "SHADER: intatto");
+    esigi(s.ns[WINQ_SPIA_GPU] == 0, "GPU: intatto");
+}
+
+/* SONDA glGetError, aggiunta l'11/08/2026. Qui si prova solo la logica di
+ * armo/richiesta/registrazione in winq-glspia-conta.c: le chiamate GL vere
+ * (epoxy_glGetError() dentro gpu_apri()/gpu_chiudi()) vivono in
+ * winq-glspia-gpu.c, che tocca GL e per questo resta fuori da
+ * test-glspia.sh (vedi il commento in cima al file). */
+static void prova_sonda_richiesta_e_registrazione(void)
+{
+    struct winq_glspia s;
+
+    printf("sonda: richiesta, registrazione, disarmo:\n");
+    winq_glspia_azzera();
+    /* Stato di partenza noto: forza un ciclo completo cosi' il test non
+     * dipende da come sonda_armata era lasciata dalla prova precedente. */
+    winq_glspia_sonda_registra_inizio(0);
+    winq_glspia_sonda_registra_fine(0);
+    winq_glspia_leggi(&s);   /* scarta: serve solo a riarmare in modo noto */
+
+    esigi(winq_glspia_sonda_richiesta(), "armata dopo la lettura");
+
+    winq_glspia_sonda_registra_inizio(0);
+    esigi(winq_glspia_sonda_richiesta(),
+          "ancora armata dopo registra_inizio: fine() la disarma, non inizio()");
+
+    winq_glspia_sonda_registra_fine(0x0502);   /* GL_INVALID_OPERATION */
+    esigi(!winq_glspia_sonda_richiesta(), "disarmata dopo registra_fine");
+
+    winq_glspia_leggi(&s);
+    esigi(s.sonda_eseguita == 1, "eseguita: vera");
+    esigi(s.sonda_errore_inizio == 0, "inizio: GL_NO_ERROR");
+    esigi(s.sonda_errore_fine == 0x0502, "fine: il codice passato a registra_fine");
+}
+
+/* Un ciclo senza nessuna registrazione deve leggersi come "non eseguita", non
+ * come "eseguita con successo" (i codici a zero sarebbero indistinguibili da
+ * GL_NO_ERROR senza sonda_eseguita) -- e azzera() deve davvero azzerare i tre
+ * campi, non lasciare i valori del ciclo precedente. */
+static void prova_sonda_azzerata_se_non_eseguita(void)
+{
+    struct winq_glspia s;
+
+    printf("sonda non eseguita: azzerata, non un residuo del ciclo prima:\n");
+    winq_glspia_azzera();
+
+    winq_glspia_sonda_registra_inizio(0x0500);   /* GL_INVALID_ENUM */
+    winq_glspia_sonda_registra_fine(0x0501);     /* GL_INVALID_VALUE */
+    winq_glspia_leggi(&s);
+    esigi(s.sonda_eseguita == 1, "primo ciclo: eseguita (per costruzione della prova)");
+
+    /* Secondo ciclo: la lettura sopra ha riarmato la richiesta, ma qui
+     * nessuno la consuma -- come un ciclo reale in cui nessun gpu_apri()
+     * arriva a aprire una query. */
+    winq_glspia_leggi(&s);
+    esigi(s.sonda_eseguita == 0, "secondo ciclo: non eseguita");
+    esigi(s.sonda_errore_inizio == 0, "secondo ciclo: inizio azzerato, non un residuo");
+    esigi(s.sonda_errore_fine == 0, "secondo ciclo: fine azzerata, non un residuo");
+}
+
 int main(void)
 {
     prova_accumulo();
@@ -372,6 +461,9 @@ int main(void)
     prova_aggiungi_fuori_secchio_invalido();
     prova_somma_finestra();
     prova_lettura_azzera_campi_nuovi();
+    prova_secchi_attesa_distinti();
+    prova_sonda_richiesta_e_registrazione();
+    prova_sonda_azzerata_se_non_eseguita();
 
     if (falliti) {
         printf("\n%d PROVE FALLITE\n", falliti);
diff --git a/src/winq-glspia-conta.c b/src/winq-glspia-conta.c
index 7e9cd3f..1b867b9 100644
--- a/src/winq-glspia-conta.c
+++ b/src/winq-glspia-conta.c
@@ -24,6 +24,12 @@ static int acceso = -1;
  * cronometrato in corso -- vive quanto una submit, non quanto un secondo. */
 static int in_finestra;
 
+/* Come in_finestra: non e' un accumulo che azzera() ripulisce, e' la
+ * richiesta "sondare la prossima query aperta" che vive fra due letture.
+ * Parte armata (1) cosi' che il primo ciclo di riepilogo, non solo il
+ * secondo, contenga gia' un campione. */
+static int sonda_armata = 1;
+
 int winq_glspia_accesa(void)
 {
     if (acceso < 0) {
@@ -196,6 +202,30 @@ void winq_glspia_somma_finestra(uint64_t ns)
     spia.finestra_ns += ns;
 }
 
+int winq_glspia_sonda_richiesta(void)
+{
+    return sonda_armata;
+}
+
+/* Non disarma: fine() lo fa, dopo che ANCHE il secondo glGetError() e' stato
+ * letto. Se disarmasse qui, un chiamante che leggesse la richiesta una
+ * seconda volta fra begin e end (invece di ricordare la risposta come dice
+ * il commento in winq-glspia-conta.h) la vedrebbe gia' falsa e salterebbe la
+ * sonda di fine -- ma il contratto e' "leggi una volta, ricorda", quindi qui
+ * non e' la guardia contro quel caso: e' solo che il disarmo logicamente
+ * appartiene alla fine del ciclo begin/end, non al suo inizio. */
+void winq_glspia_sonda_registra_inizio(uint64_t errore)
+{
+    spia.sonda_eseguita = 1;
+    spia.sonda_errore_inizio = errore;
+}
+
+void winq_glspia_sonda_registra_fine(uint64_t errore)
+{
+    spia.sonda_errore_fine = errore;
+    sonda_armata = 0;
+}
+
 void winq_glspia_azzera(void)
 {
     int i;
@@ -209,12 +239,19 @@ void winq_glspia_azzera(void)
     spia.saltate = 0;
     spia.assurde = 0;
     spia.finestra_ns = 0;
+    spia.sonda_eseguita = 0;
+    spia.sonda_errore_inizio = 0;
+    spia.sonda_errore_fine = 0;
 }
 
 void winq_glspia_leggi(struct winq_glspia *fuori)
 {
     *fuori = spia;
     winq_glspia_azzera();
+    /* Riarma per il ciclo che comincia ora: senza questo, dopo il primo
+     * campione la sonda si disarmerebbe per sempre (fine() la disarma, e
+     * nessuno la rialzerebbe piu'). */
+    sonda_armata = 1;
 }
 
 /* Un milione di coppie di letture a vuoto, senza niente in mezzo: e' il costo
diff --git a/src/winq-glspia-conta.h b/src/winq-glspia-conta.h
index 49702fd..4af6607 100644
--- a/src/winq-glspia-conta.h
+++ b/src/winq-glspia-conta.h
@@ -38,10 +38,21 @@
  * tutti gli altri quando c'era. */
 #define WINQ_SPIA_ESPORTA __attribute__((visibility("default")))
 
+/* TERZA CORREZIONE DELL'11/08/2026: lo split di "fuori" ha detto che dentro
+ * quel 62% del secondo, fuori/gl e fuori/shader sono zero e fuori/attesa e'
+ * 645,3 ms/s da solo. ATTESA sommava glFlush, glFinish e glClientWaitSync:
+ * tre primitive con tre cause diverse (presentazione, GPU, fence), un solo
+ * numero. Non serve un secchio nuovo con macchineria nuova: si allunga
+ * l'enum, e ns[]/chiamate[]/fuori_ns[]/fuori_chiamate[] (tutti dimensionati
+ * su WINQ_SPIA_N) portano la scomposizione da soli. ATTESA come nome sparisce
+ * dall'enum; nella sottrazione e nelle righe di riepilogo torna come somma di
+ * FLUSH+FINISH+WAITSYNC (vedi hw/display/virtio-gpu-virgl.c). */
 enum {
     WINQ_SPIA_GL = 0,      /* disegno, buffer, texture: lavoro del driver */
     WINQ_SPIA_SHADER,      /* glCompileShader, glLinkProgram: DXIL + PSO */
-    WINQ_SPIA_ATTESA,      /* glFinish, glClientWaitSync: fermi ad aspettare */
+    WINQ_SPIA_FLUSH,       /* glFlush: manda in coda, non aspetta */
+    WINQ_SPIA_FINISH,      /* glFinish (e le due letture all'indietro, vedi winq-glspia.h) */
+    WINQ_SPIA_WAITSYNC,    /* glClientWaitSync: attesa su una fence esplicita */
     WINQ_SPIA_GPU,         /* GL_TIME_ELAPSED: lavoro vero della Adreno */
     WINQ_SPIA_N
 };
@@ -79,6 +90,19 @@ struct winq_glspia {
     uint64_t fuori_ns[WINQ_SPIA_N];       /* lavoro GL per secchio, a finestra chiusa */
     uint64_t fuori_chiamate[WINQ_SPIA_N]; /* numero di quelle chiamate, per secchio */
     uint64_t finestra_ns;    /* tempo CPU del tratto cronometrato (decodifica) */
+    /* SONDA glGetError, aggiunta l'11/08/2026: t_gpu non si raccoglie quasi
+     * mai (saltate resta alto anche con l'anello a 256 caselle, smentendo
+     * l'ipotesi che fosse solo un problema di dimensione), e uno dei sospetti
+     * rimasti e' che glBeginQuery/glEndQuery falliscano in silenzio. Letta
+     * UNA volta per ciclo di riepilogo (non per submit: vedi
+     * winq_glspia_sonda_richiesta() e il commento in winq-glspia-gpu.c), non
+     * per ogni chiamata -- sarebbe percorso caldo altrimenti. sonda_eseguita
+     * dice se il ciclo appena letto ne conteneva una (0/1): senza questo
+     * campo un ciclo senza sonda e uno con GL_NO_ERROR (0) sarebbero
+     * indistinguibili leggendo solo i codici. */
+    uint64_t sonda_eseguita;
+    uint64_t sonda_errore_inizio; /* glGetError() subito dopo glBeginQuery */
+    uint64_t sonda_errore_fine;   /* glGetError() subito dopo glEndQuery */
 };
 
 /* Letta una volta sola dalla variabile WINQ_GPU_DIAG. Sul percorso caldo si
@@ -133,6 +157,27 @@ void winq_glspia_somma_gpu(uint64_t ns);
  * virgl_renderer_submit_cmd, che e' piu' largo della finestra (vedi la nota
  * sulla struct winq_glspia). */
 void winq_glspia_somma_finestra(uint64_t ns);
+
+/* La sonda glGetError, letta una volta per ciclo di riepilogo. Il ciclo di
+ * vita, per chi implementa il lato GL (winq-glspia-gpu.c):
+ *   1. winq_glspia_leggi() arma la richiesta (per il ciclo che comincia ora).
+ *   2. Il primo gpu_apri() dopo l'armamento vede winq_glspia_sonda_richiesta()
+ *      vera, e chiama davvero epoxy_glGetError() subito dopo glBeginQuery --
+ *      passandone il risultato a winq_glspia_sonda_registra_inizio().
+ *   3. Lo stesso submit, in gpu_chiudi(), chiama epoxy_glGetError() subito
+ *      dopo glEndQuery e lo passa a winq_glspia_sonda_registra_fine(), che
+ *      DISARMA la richiesta: nessun altro submit la vedra' vera finche' la
+ *      prossima winq_glspia_leggi() non la riarma.
+ * Il chiamante deve leggere winq_glspia_sonda_richiesta() una volta in
+ * gpu_apri() e ricordare la risposta (es. in un campo della propria tabella
+ * per contesto) invece di richiamarla in gpu_chiudi(): la richiesta resta
+ * vera fra le due, ma un secondo contesto che si intromettesse nel frattempo
+ * (gpu_apri()/gpu_chiudi() di un'altra submit) altrimenti la vedrebbe vera
+ * anche lui e la sonderebbe due volte nello stesso ciclo. */
+int winq_glspia_sonda_richiesta(void);
+void winq_glspia_sonda_registra_inizio(uint64_t errore);
+void winq_glspia_sonda_registra_fine(uint64_t errore);
+
 void winq_glspia_azzera(void);
 uint64_t winq_glspia_taratura_ns(void);
 
diff --git a/src/winq-glspia-gpu.c b/src/winq-glspia-gpu.c
index eecac8e..1ae678f 100644
--- a/src/winq-glspia-gpu.c
+++ b/src/winq-glspia-gpu.c
@@ -80,6 +80,14 @@ struct winq_ctx {
