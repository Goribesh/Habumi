 };
 
 static struct winq_ctx tabella[WINQ_CONTESTI];
@@ -203,7 +211,18 @@ void winq_glspia_gpu_apri(void)
         return;
     }
     raccogli(c, c->prossima);
+    /* Letta una volta, ricordata in c->sonda_in_corso: chiudi() la user
+     * senza richiamare winq_glspia_sonda_richiesta(), vedi il commento sul
