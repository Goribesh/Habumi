@@ -464,7 +464,12 @@ void vrend_renderer_check_fences(void);
 int vrend_renderer_create_ctx0_fence(uint32_t fence_id);
 int vrend_renderer_export_ctx0_fence(uint32_t fence_id, int* out_fd);
 
-bool vrend_hw_switch_context(struct vrend_context *ctx, bool now);
+/* origine: WINQ_CTX_FORCE0 se la richiesta viene da vrend_renderer_force_ctx_0(),
+ * WINQ_CTX_ALTRO per ogni altro chiamante -- vedi il commento sopra la
+ * definizione (vrend_renderer.c) per l'elenco e il perche' della QUINTA
+ * CORREZIONE dell'11/08/2026. Parametro interno al fork: questa funzione
+ * non e' nella API pubblica di virglrenderer.h. */
+bool vrend_hw_switch_context(struct vrend_context *ctx, int origine, bool now);
 uint32_t vrend_renderer_object_insert(struct vrend_context *ctx, void *data,
                                       uint32_t handle, enum virgl_object_type type);
 void vrend_renderer_object_destroy(struct vrend_context *ctx, uint32_t handle);
diff --git a/src/winq-glspia-conta.c b/src/winq-glspia-conta.c
index 69444f7..49f8d7c 100644
--- a/src/winq-glspia-conta.c
+++ b/src/winq-glspia-conta.c
@@ -310,6 +310,30 @@ void winq_glspia_sonda_registra_fine(uint64_t errore)
     sonda_armata = 0;
 }
 
+/* Un'origine fuori bounds e' un errore di chi chiama (indice invalido),
+ * esattamente come un secchio o un thread fuori bounds in aggiungi(): si
+ * conta come assurda, non come richiesta. Il chiamante (vrend_hw_switch_context())
+ * e' gia' dietro winq_glspia_accesa(), quindi qui non c'e' bisogno di
+ * un'altra guardia sulla diagnostica. */
+void winq_glspia_ctx_richiesto(int origine)
+{
+    if (origine < 0 || origine >= WINQ_CTX_N) {
+        spia.assurde++;
+        return;
+    }
+    spia.ctx_richiesti[origine]++;
+}
+
+void winq_glspia_ctx_vero(int origine, uint64_t ns)
+{
+    if (origine < 0 || origine >= WINQ_CTX_N) {
+        spia.assurde++;
+        return;
+    }
+    spia.ctx_veri[origine]++;
+    spia.ctx_ns[origine] += ns;
+}
+
 void winq_glspia_azzera(void)
 {
     int t, i;
@@ -331,6 +355,11 @@ void winq_glspia_azzera(void)
     /* thread_principale/thread_altri_* NON si azzerano: vedi il commento
      * sulla struct in winq-glspia-conta.h. Sono un registro per la vita del
      * processo, non un accumulo al secondo. */
+    for (i = 0; i < WINQ_CTX_N; i++) {
+        spia.ctx_richiesti[i] = 0;
+        spia.ctx_veri[i] = 0;
+        spia.ctx_ns[i] = 0;
+    }
 }
 
 void winq_glspia_leggi(struct winq_glspia *fuori)
diff --git a/src/winq-glspia-conta.h b/src/winq-glspia-conta.h
index 958ce0a..52e2609 100644
--- a/src/winq-glspia-conta.h
+++ b/src/winq-glspia-conta.h
@@ -98,6 +98,21 @@ enum {
  * numero va alzato -- stessa logica di WINQ_CONTESTI in winq-glspia-gpu.c. */
 #define WINQ_THREAD_TABELLA 8
 
+/* QUINTA CORREZIONE DELL'11/08/2026: chi ha richiesto lo switch di contesto
+ * GL, non "quale contesto" -- il sospetto e' su una funzione chiamante
+ * (vrend_renderer_force_ctx_0(), invocata da QEMU prima di ogni comando),
+ * non su un contesto target. WINQ_CTX_FORCE0 marca esclusivamente le
+ * richieste che passano per quella funzione; ogni altro chiamante di
+ * vrend_hw_switch_context() (il percorso di decodifica, i trasferimenti, il
+ * ripristino dopo la distruzione di un contesto) e' WINQ_CTX_ALTRO -- vedi
+ * il commento sopra vrend_hw_switch_context() in vrend_renderer.c per
+ * l'elenco esatto dei chiamanti e la loro classificazione. */
+enum {
+    WINQ_CTX_FORCE0 = 0,
+    WINQ_CTX_ALTRO,
+    WINQ_CTX_N
+};
+
 struct winq_glspia {
     uint64_t ns[WINQ_THREAD_N][WINQ_SPIA_N];
     uint64_t chiamate[WINQ_THREAD_N][WINQ_SPIA_N];
@@ -153,6 +168,28 @@ struct winq_glspia {
     uint64_t thread_altri_n;         /* quanti "altri" thread distinti in thread_altri_id[] */
     uint64_t thread_altri_id[WINQ_THREAD_TABELLA]; /* i loro id; 0 = casella non usata */
     uint64_t thread_altri_fuori_tabella; /* chiamate da un "altro" thread non riconosciuto a tabella piena */
+    /* QUINTA CORREZIONE DELL'11/08/2026: il primo consumatore del ciclo
+     * principale non era SUBMIT_3D ma 0x202 CTX_ATTACH_RESOURCE (923 us/
+     * chiamata), con un'asimmetria netta rispetto al detach (231 us) pur
+     * facendo lo stesso lavoro O(1) in tabella hash. Il sospetto, dedotto dal
+     * codice non misurato: virgl_renderer_force_ctx_0() (chiamata da QEMU
+     * incondizionatamente prima di OGNI comando, virtio-gpu-virgl.c:1471)
+     * azzera current_ctx/current_hw_ctx PRIMA di richiedere lo switch a ctx0
+     * -- quindi vrend_hw_switch_context() non puo' mai prendere la sua
+     * scorciatoia "e' gia' il contesto giusto", e vrend_finish_context_switch()
