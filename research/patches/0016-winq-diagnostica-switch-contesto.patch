 static void vrend_update_frontface_state(struct vrend_sub_context *ctx);
 static void vrend_destroy_program(struct vrend_linked_shader_program *ent);
@@ -8016,8 +8022,10 @@ void vrend_destroy_context(struct vrend_context *ctx)
 
    FREE(ctx);
 
+   /* WINQ_CTX_ALTRO: ripristino del contesto precedente dopo una distruzione,
+    * non force_ctx_0(). */
    if (!switch_0 && cur)
-      vrend_hw_switch_context(cur, true);
+      vrend_hw_switch_context(cur, WINQ_CTX_ALTRO, true);
 }
 
 struct vrend_context *vrend_create_context(int id, uint32_t nlen, const char *debug_name)
@@ -10024,7 +10032,8 @@ static int vrend_renderer_transfer_internal(struct vrend_context *ctx,
    if (!info->box)
       return EINVAL;
 
-   if (!vrend_hw_switch_context(ctx, true))
+   /* WINQ_CTX_ALTRO: i trasferimenti, non force_ctx_0(). */
+   if (!vrend_hw_switch_context(ctx, WINQ_CTX_ALTRO, true))
       return EINVAL;
 
    assert(check_transfer_iovec(res, info));
@@ -11634,11 +11643,74 @@ static void vrend_renderer_check_queries(void)
                 !list_is_empty(&vrend_state.waiting_query_list));
 }
 
-bool vrend_hw_switch_context(struct vrend_context *ctx, bool now)
-{
+/* QUINTA CORREZIONE DELL'11/08/2026, dietro WINQ_GPU_DIAG: il primo
+ * consumatore del ciclo principale, misurato con la finestra e il thread
+ * corretti (i giri precedenti), non era SUBMIT_3D ma 0x202
+ * CTX_ATTACH_RESOURCE -- 923 us/chiamata contro 231 del detach, pur
+ * facendo lo stesso lavoro O(1) in tabella hash (vrend_ctx_resource_insert,
+ * niente scansioni, niente lock: l'ipotesi del lock condiviso col thread
+ * delle fence e' stata verificata e respinta, fence_mutex si rilascia prima
+ * di glClientWaitSync).
+ *
+ * Il sospetto, dedotto dal codice: virgl_renderer_force_ctx_0() (chiamata
+ * da QEMU incondizionatamente prima di OGNI comando,
+ * virtio_gpu_virgl_process_cmd, hw/display/virtio-gpu-virgl.c:1471) passa
+ * per vrend_renderer_force_ctx_0() (sotto in questo file), che azzera
+ * vrend_state.current_ctx/current_hw_ctx PRIMA di chiedere lo switch a
+ * ctx0. La scorciatoia qui sotto ("e' gia' il contesto giusto, non fare
+ * niente") non puo' quindi mai scattare per una richiesta arrivata da li':
+ * ogni chiamata da force_ctx_0() arriva sempre a
+ * vrend_finish_context_switch(), che arriva sempre a
+ * vrend_clicbs->make_current() -- anche quando il contesto GL a livello di
+ * sistema operativo era gia' quello giusto. L'asimmetria attach/detach si
+ * spiegherebbe con l'ordine dei comandi: SUBMIT_3D commuta al contesto
+ * dell'app (vrend_decode_ctx_submit_cmd), l'attach subito dopo trova
+ * quell'altro contesto e il suo force_ctx_0() paga lo switch vero verso
+ * ctx0, il detach lo trova gia' li' e il suo force_ctx_0() ritorna in
+ * fretta (anche se, come appena detto, "ritorna in fretta" e' una
+ * questione di wglMakeCurrent lato sistema operativo, non della
+ * scorciatoia qui sotto: quella e' comunque saltata da entrambi).
+ *
+ * DEDOTTO, NON MISURATO -- questo e' il conteggio che lo confermerebbe o lo
+ * smentirebbe. Origine (WINQ_CTX_FORCE0 contro WINQ_CTX_ALTRO) e' un
+ * parametro nuovo su questa funzione: e' interna al fork (dichiarata in
+ * vrend_renderer.h, non nella API pubblica virglrenderer.h), quindi
+ * aggiungerlo non tocca il confine con QEMU. I cinque chiamanti:
+ *   - vrend_decode.c:2062 (vrend_decode_ctx_submit_cmd, il percorso di
+ *     decodifica) -> WINQ_CTX_ALTRO;
+ *   - vrend_renderer.c, dentro vrend_destroy_context() (il ripristino del
+ *     contesto precedente dopo aver distrutto quello corrente) -> ALTRO;
+ *   - vrend_renderer.c, dentro vrend_renderer_transfer_internal() (i
+ *     trasferimenti) -> ALTRO;
+ *   - vrend_renderer_force_ctx_0() qui sotto -> FORCE0, l'unico;
+ *   - vrend_renderer_prepare_reset() (piu' in basso in questo file): chiama
+ *     vrend_hw_switch_context(ctx0, true) DIRETTAMENTE, non passando per
+ *     vrend_renderer_force_ctx_0() -- e' un evento di reset del renderer,
+ *     non il percorso caldo per-comando che il sospetto riguarda, quindi
+ *     -> ALTRO. L'origine segue "e' passato per force_ctx_0()?", non "il
+ *     contesto di destinazione e' ctx0?": sono domande diverse, e la
+ *     seconda avrebbe messo prepare_reset() nel secchio sbagliato.
+ *
+ * FUORI SCOPE, deliberatamente: vrend_hw_switch_context_with_sub() (usata
+ * solo da vrend_renderer_check_queries()) chiama
+ * vrend_finish_context_switch() direttamente, non attraverso questa
+ * funzione -- non e' "vrend_hw_switch_context", che e' esattamente cosa
+ * questa diagnostica misura, letteralmente. Le sue chiamate a make_current()
+ * non sono contate qui. Idem le chiamate DIRETTE a
+ * vrend_clicbs->make_current() dentro vrend_destroy_sub_context() e
+ * vrend_renderer_set_sub_ctx() (switch di SUB-contesto entro lo stesso
+ * vrend_context, un meccanismo diverso da questo). */
+bool vrend_hw_switch_context(struct vrend_context *ctx, int origine, bool now)
+{
+   int accesa = winq_glspia_accesa();
+
    if (!ctx)
       return false;
 
+   if (accesa) {
+      winq_glspia_ctx_richiesto(origine);
+   }
+
    if (ctx == vrend_state.current_ctx && ctx->ctx_switch_pending == false)
       return true;
 
@@ -11648,24 +11720,30 @@ bool vrend_hw_switch_context(struct vrend_context *ctx, bool now)
 
    ctx->ctx_switch_pending = true;
    if (now == true) {
-      vrend_finish_context_switch(ctx);
+      uint64_t t0 = accesa ? winq_glspia_ora() : 0;
+      bool vero = vrend_finish_context_switch(ctx);
+
+      if (t0 && vero) {
+         winq_glspia_ctx_vero(origine, winq_glspia_intervallo_ns(t0, winq_glspia_ora()));
+      }
    }
    vrend_state.current_ctx = ctx;
    return true;
 }
 
-static void vrend_finish_context_switch(struct vrend_context *ctx)
+static bool vrend_finish_context_switch(struct vrend_context *ctx)
 {
    if (ctx->ctx_switch_pending == false)
-      return;
+      return false;
    ctx->ctx_switch_pending = false;
 
    if (vrend_state.current_hw_ctx == ctx)
-      return;
+      return false;
 
    vrend_state.current_hw_ctx = ctx;
 
    vrend_clicbs->make_current(ctx->sub->gl_context);
+   return true;
 }
 
 void
@@ -13040,7 +13118,9 @@ void vrend_renderer_force_ctx_0(void)
    TRACE_FUNC();
    vrend_state.current_ctx = NULL;
    vrend_state.current_hw_ctx = NULL;
-   vrend_hw_switch_context(vrend_state.ctx0, true);
+   /* WINQ_CTX_FORCE0: l'unico chiamante classificato cosi', vedi il commento
+    * sopra vrend_hw_switch_context(). */
+   vrend_hw_switch_context(vrend_state.ctx0, WINQ_CTX_FORCE0, true);
 }
 
 void vrend_renderer_get_rect(struct pipe_resource *pres,
@@ -13319,7 +13399,10 @@ void vrend_renderer_prepare_reset(void)
 {
    /* make sure user contexts are no longer accessed */
    vrend_free_sync_thread();
-   vrend_hw_switch_context(vrend_state.ctx0, true);
+   /* WINQ_CTX_ALTRO: va a ctx0 come force_ctx_0(), ma non passa per
+    * quella funzione -- e' un evento di reset, non il percorso caldo
+    * per-comando. Vedi il commento sopra vrend_hw_switch_context(). */
+   vrend_hw_switch_context(vrend_state.ctx0, WINQ_CTX_ALTRO, true);
 }
 
 void vrend_renderer_reset(void)
