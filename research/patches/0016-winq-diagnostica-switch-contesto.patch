index 562efdc..aae3e21 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -54,6 +54,7 @@
 #include "vrend_debug.h"
 #include "vrend_winsys.h"
 #include "vrend_blitter.h"
+#include "winq-glspia-conta.h"
 
 #include "virgl_util.h"
 
@@ -887,7 +888,12 @@ static void vrend_pause_render_condition(struct vrend_context *ctx, bool pause);
