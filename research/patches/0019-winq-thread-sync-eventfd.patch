 src/proxy/proxy_context.c      |   7 ++-
 src/test-winq-glspia-conta.exe | Bin 0 -> 96768 bytes
 src/virgl_util.c               |  86 ++++++++++++++++++++++++++++++---
 src/virgl_util.h               |  18 +++++++
 src/virglrenderer.c            |  28 ++++++++++-
 src/vrend/vrend_renderer.c     |  82 +++++++++++++++++++++++++++++--
 6 files changed, 206 insertions(+), 15 deletions(-)
 create mode 100644 src/test-winq-glspia-conta.exe

diff --git a/src/proxy/proxy_context.c b/src/proxy/proxy_context.c
index c6b6d81..e44c424 100644
--- a/src/proxy/proxy_context.c
+++ b/src/proxy/proxy_context.c
@@ -178,7 +178,10 @@ proxy_context_sync_thread(void *arg)
 
    while (!ctx->sync_thread.stop) {
 #ifdef _WIN32
-      HANDLE event = (HANDLE)_get_osfhandle(ctx->sync_thread.fence_eventfd);
+      /* Non _get_osfhandle: su Windows il fence eventfd non e' un
+       * descrittore della CRT, e' l'indice di un HANDLE nella tabella di
+       * virgl_util. Vedi create_eventfd. */
+      HANDLE event = (HANDLE)eventfd_handle(ctx->sync_thread.fence_eventfd);
       DWORD wait_ret = WaitForSingleObject(event, 100); /* 100ms timeout */
       if (wait_ret == WAIT_FAILED) {
          proxy_log("failed to wait on fence event");
@@ -541,7 +544,7 @@ proxy_context_destroy(struct virgl_context *base)
          thrd_join(ctx->sync_thread.thread, NULL);
       }
 
-      os_close_fd(ctx->sync_thread.fence_eventfd);
+      close_eventfd(ctx->sync_thread.fence_eventfd);
    }
 
    if (ctx->shmem.ptr)
