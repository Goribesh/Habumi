diff --git a/src/virgl_util.c b/src/virgl_util.c
index be2903f..d5c71dd 100644
--- a/src/virgl_util.c
+++ b/src/virgl_util.c
@@ -102,30 +102,100 @@ bool has_eventfd(void)
 #endif
 }
 
+#ifdef _WIN32
+/*
+ * Emulazione di eventfd su Windows.
+ *
+ * L'implementazione precedente avvolgeva un HANDLE di Event in un
+ * descrittore con _open_osfhandle. Non puo' funzionare: la UCRT chiama
+ * GetFileType sull'handle, per un Event ottiene FILE_TYPE_UNKNOWN con
+ * ERROR_INVALID_HANDLE, e rifiuta con EBADF. Verificato in isolamento su
+ * Windows 11 ARM64 con UCRT: _open_osfhandle su un Event ritorna sempre -1.
+ * Di conseguenza create_eventfd falliva sempre, e con essa ogni percorso
+ * che dipende da VIRGL_RENDERER_THREAD_SYNC — che QEMU imposta da se',
+ * senza modo di disattivarlo.
+ *
+ * Qui l'HANDLE non viene travestito da descrittore: sta in una tabella e
+ * il valore restituito e' un indice riconoscibile. I chiamanti continuano a
+ * maneggiare un int, come su Linux, ma non lo passano piu' a funzioni della
+ * CRT: per chiuderlo c'e' close_eventfd, per ottenere l'HANDLE
+ * eventfd_handle.
+ *
+ * L'allocazione degli slot e' senza lock, con InterlockedCompareExchange
+ * su ciascuno: evita di dover inizializzare un mutex prima del primo uso,
+ * cosa che in questo file non avrebbe un punto naturale in cui avvenire.
+ *
+ * Il valore restituito e' >= 0 e ben oltre qualunque descrittore reale,
+ * perche' il codice esistente usa `fd >= 0` e `fd != -1` come test di
+ * validita' e li deve continuare a superare.
+ */
+#define VIRGL_EVENTFD_BASE 0x10000000
+#define VIRGL_EVENTFD_MAX  256
+
+static PVOID virgl_eventfd_table[VIRGL_EVENTFD_MAX];
+
+static bool virgl_is_eventfd(int fd)
+{
+   return fd >= VIRGL_EVENTFD_BASE &&
+          fd < VIRGL_EVENTFD_BASE + VIRGL_EVENTFD_MAX;
+}
+
+void *eventfd_handle(int fd)
+{
+   if (!virgl_is_eventfd(fd))
+      return NULL;
+   return virgl_eventfd_table[fd - VIRGL_EVENTFD_BASE];
+}
+#endif /* _WIN32 */
+
 int create_eventfd(unsigned int initval)
 {
 #ifdef HAVE_EVENTFD_H
    return eventfd(initval, EFD_CLOEXEC | EFD_NONBLOCK);
 #elif defined(_WIN32)
+   /* Manual reset: flush_eventfd deve poter azzerare esplicitamente lo
+    * stato, come fa la read su un eventfd Linux. */
    HANDLE event = CreateEventA(NULL, TRUE, initval ? TRUE : FALSE, NULL);
    if (!event)
       return -1;
-   int fd = _open_osfhandle((intptr_t)event, 0);
-   if (fd < 0)
-      CloseHandle(event);
-   return fd;
+
+   for (int i = 0; i < VIRGL_EVENTFD_MAX; i++) {
+      if (!InterlockedCompareExchangePointer(&virgl_eventfd_table[i],
+                                             event, NULL))
+         return VIRGL_EVENTFD_BASE + i;
+   }
+
+   /* Tabella piena: nessuno slot libero. Meglio fallire che perdere
+    * l'handle. */
+   CloseHandle(event);
+   return -1;
 #else
    (void)initval;
    return -1;
 #endif
 }
 
+void close_eventfd(int fd)
+{
+#ifdef _WIN32
+   if (!virgl_is_eventfd(fd))
+      return;
+   HANDLE event = InterlockedExchangePointer(
+      &virgl_eventfd_table[fd - VIRGL_EVENTFD_BASE], NULL);
+   if (event)
+      CloseHandle(event);
+#else
+   if (fd >= 0)
+      close(fd);
+#endif
+}
+
 int write_eventfd(int fd, uint64_t val)
 {
 #ifdef _WIN32
    (void)val;
-   HANDLE event = (HANDLE)_get_osfhandle(fd);
-   if (event == INVALID_HANDLE_VALUE)
+   HANDLE event = eventfd_handle(fd);
+   if (!event)
       return -1;
    return SetEvent(event) ? 0 : -1;
 #else
@@ -151,8 +221,8 @@ int write_eventfd(int fd, uint64_t val)
 void flush_eventfd(int fd)
 {
 #ifdef _WIN32
-   HANDLE event = (HANDLE)_get_osfhandle(fd);
-   if (event != INVALID_HANDLE_VALUE)
+   HANDLE event = eventfd_handle(fd);
+   if (event)
       ResetEvent(event);
 #else
     ssize_t len;
diff --git a/src/virgl_util.h b/src/virgl_util.h
index a4fb7c7..3dbbd1b 100644
--- a/src/virgl_util.h
+++ b/src/virgl_util.h
@@ -70,6 +70,24 @@ int create_eventfd(unsigned int initval);
 int write_eventfd(int fd, uint64_t val);
 void flush_eventfd(int fd);
 
+/*
+ * Il valore restituito da create_eventfd va chiuso con questa, non con
+ * close() ne' os_close_fd(): su Windows non e' un descrittore della CRT ma
+ * l'indice di un HANDLE in una tabella interna. Su POSIX equivale a
+ * close().
+ */
+void close_eventfd(int fd);
+
+#ifdef _WIN32
+/*
+ * HANDLE associato a un eventfd, per i chiamanti che devono attenderlo con
+ * le primitive Win32. Ritorna NULL se il descrittore non viene da
+ * create_eventfd. Dichiarato void* per non tirare windows.h in questo
+ * header.
+ */
+void *eventfd_handle(int fd);
+#endif
+
 /*
  * Returns true once WINQ_DIAG=1 (or any non-empty, non-"0" value) has been
  * observed in the environment. Modules that have their own VIRGL_*_DIAG
diff --git a/src/virglrenderer.c b/src/virglrenderer.c
index 0608101..3a6d1fc 100644
--- a/src/virglrenderer.c
+++ b/src/virglrenderer.c
@@ -700,10 +700,34 @@ static int make_current_surfaceless(virgl_renderer_gl_context ctx)
       return vrend_winsys_make_context_current(ctx);
 
    ret = state.cbs->make_current(state.cookie, 0, ctx);
-   if (ret && state.cbs->version >= 4) {
+   if (ret) {
+      /* IL FALLIMENTO SI PROPAGA SEMPRE, non solo da versione 4 in su.
+       *
+       * Prima, con callback a versione < 4, questa funzione restituiva 0 --
+       * cioe' "riuscito" -- anche quando make_current era fallita, e senza
+       * stampare niente. Su WGL la versione delle callback resta 3
+       * deliberatamente (vedi il commento in hw/display/virtio-gpu-virgl.c:
+       * a 4 l'assert qui sotto farebbe abortire QEMU), quindi su questa
+       * piattaforma il fallimento era invisibile per costruzione, e nessun
+       * controllo del chiamante poteva vederlo.
+       *
+       * Perche' importa: l'unico chiamante che lo controlla e' thread_sync()
+       * (vrend_renderer.c). Un thread di sync che parte SENZA contesto GL
+       * corrente non fallisce in modo rumoroso -- glClientWaitSync senza
+       * contesto restituisce zero, che non e' GL_TIMEOUT_EXPIRED, quindi
+       * do_wait() conclude "fence pronta" e la ritira subito. Tutte le fence
+       * verrebbero ritirate all'istante: il guest crederebbe che la GPU
+       * abbia finito quando non ha finito, e il sintomo sarebbe a schermo,
+       * non nel registro.
+       *
+       * L'assert resta legato alla versione: abortire e' una decisione che
+       * appartiene a chi ha dichiarato di poterla reggere. Restituire un
+       * errore, no. */
       virgl_error("%s: Error switching surfaceless context: %d\n",
                   __func__, ret);
-      assert(!ret && "Failed to switch GL context");
+      if (state.cbs->version >= 4) {
+         assert(!ret && "Failed to switch GL context");
+      }
       return -1;
    }
 
diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index faaf8b4..bcc8dc9 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -7404,6 +7404,25 @@ static void wait_sync(struct vrend_fence *fence)
       mtx_unlock(&vrend_state.poll_mutex);
 }
 
+/* Esito dell'avvio del thread di sync, per la stretta di mano con
+ * vrend_renderer_use_threaded_sync(): 0 = in corso, 1 = pronto, -1 = fallito.
+ *
+ * PERCHE' UNA STRETTA DI MANO E NON UN RITORNO MUTO. Se il thread esce dopo
+ * essere stato creato, u_thread_create ha comunque avuto successo:
+ * vrend_state.sync_thread resta non nullo, il ripiego di :7500 non scatta, e
+ * use_async_fence_cb resta VERO. Il ciclo principale prenderebbe allora il
+ * ramo asincrono di vrend_renderer_poll(), che non ritira nessuna fence --
+ * e nessun altro le ritira, perche' il thread che doveva farlo e' morto.
+ * Il guest si pianta, in silenzio, senza una riga nel registro che colleghi
+ * il sintomo alla causa. Il creatore deve sapere se il thread e' vivo prima
+ * di lasciare che il resto del programma ci conti sopra.
+ *
+ * Si protegge con fence_mutex e si annuncia con fence_cond, che esistono gia'
+ * e sono gli stessi che il thread usa subito dopo: nessuna primitiva nuova, e
+ * il predicato si legge sotto il lock, quindi un annuncio arrivato prima che
+ * il creatore si metta ad aspettare non va perso. */
+static int vrend_sync_avvio;
+
 static int thread_sync(UNUSED void *arg)
 {
    virgl_gl_context gl_context = vrend_state.sync_context;
@@ -7411,7 +7430,41 @@ static int thread_sync(UNUSED void *arg)
    u_thread_setname("vrend-sync");
 
    mtx_lock(&vrend_state.fence_mutex);
-   vrend_clicbs->make_current_surfaceless(gl_context);
+
+   /* IL RITORNO SI CONTROLLA, e non e' pedanteria: senza questo un
+    * make_current fallito qui e' SILENZIOSO.
+    *
+    * virglrenderer ha gia' un assert su questo ritorno (virglrenderer.c,
+    * dentro virgl_renderer_make_current), ma scatta solo con le callback a
+    * versione >= 4. Su WGL la versione resta 3 -- deliberatamente, vedi il
+    * commento in hw/display/virtio-gpu-virgl.c -- quindi quell'assert non
+    * copre questo percorso. E in una build release b_ndebug spegne comunque
+    * gli assert.
+    *
+    * Senza contesto corrente, il glClientWaitSync di do_wait() piu' sotto
+    * non fallisce in modo rumoroso: epoxy risolve l'entry point sul contesto
+    * corrente, e senza contesto o aborta o restituisce zero -- e zero non e'
+    * GL_TIMEOUT_EXPIRED, quindi do_wait() conclude "fence pronta" e la
+    * ritira. Le fence verrebbero ritirate tutte all'istante, il guest
+    * vedrebbe "la GPU ha finito" quando non ha finito, e il sintomo sarebbe
+    * a schermo (tearing, frame vecchi, HUD) invece che nel registro.
+    *
+    * Meglio un thread che non parte e un errore leggibile: chi chiama torna
+    * al ramo sincrono, che e' lento ma corretto. */
+   if (vrend_clicbs->make_current_surfaceless(gl_context) != 0) {
+      virgl_error("sync thread: make_current_surfaceless failed, "
+                  "il thread esce -- si resta sul ritiro fence sincrono\n");
+      vrend_sync_avvio = -1;
+      cnd_broadcast(&vrend_state.fence_cond);
+      mtx_unlock(&vrend_state.fence_mutex);
+      return 0;
+   }
+
+   /* Riuscito: lo si dice al creatore, che sta aspettando questo. La
+    * cnd_wait del ciclo qui sotto rilascia il mutex, quindi il creatore puo'
+    * prenderlo e proseguire. */
+   vrend_sync_avvio = 1;
+   cnd_broadcast(&vrend_state.fence_cond);
 
    while (!vrend_state.stop_sync_thread) {
       if (list_is_empty(&vrend_state.fence_wait_list) &&
@@ -7470,9 +7523,32 @@ static void vrend_renderer_use_threaded_sync(void)
 
    assert(!vrend_state.sync_thread);
 
+   vrend_sync_avvio = 0;
    vrend_state.sync_thread = u_thread_create(thread_sync, NULL);
+
+   /* Si aspetta che il thread dica se e' riuscito a rendere corrente il
+    * proprio contesto GL. Vedi il commento sopra vrend_sync_avvio: senza
+    * questa attesa un thread nato e morto subito lascerebbe il ritiro delle
+    * fence a nessuno. L'attesa dura quanto una make_current, una volta per
+    * processo. */
+   if (vrend_state.sync_thread) {
+      mtx_lock(&vrend_state.fence_mutex);
+      while (vrend_sync_avvio == 0) {
+         cnd_wait(&vrend_state.fence_cond, &vrend_state.fence_mutex);
+      }
+      mtx_unlock(&vrend_state.fence_mutex);
+
+      if (vrend_sync_avvio < 0) {
+         /* Il thread e' gia' uscito da se': si raccoglie e si azzera, cosi'
+          * il ripiego qui sotto e' lo STESSO percorso gia' collaudato del
+          * caso "u_thread_create ha fallito" -- un solo smontaggio, non due. */
+         thrd_join(vrend_state.sync_thread, NULL);
+         vrend_state.sync_thread = 0;
+      }
+   }
+
    if (!vrend_state.sync_thread) {
-      close(vrend_state.eventfd);
+      close_eventfd(vrend_state.eventfd);
       vrend_state.eventfd = -1;
       vrend_clicbs->destroy_gl_context_surfaceless(vrend_state.sync_context);
       cnd_destroy(&vrend_state.fence_cond);
@@ -7825,7 +7901,7 @@ vrend_renderer_fini(void)
    vrend_state.finishing = true;
 
    if (vrend_state.eventfd != -1) {
-      close(vrend_state.eventfd);
+      close_eventfd(vrend_state.eventfd);
       vrend_state.eventfd = -1;
    }
 
