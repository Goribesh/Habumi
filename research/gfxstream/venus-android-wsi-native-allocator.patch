diff --git a/src/venus/vkr_win32_foreign.h b/src/venus/vkr_win32_foreign.h
new file mode 100644
--- /dev/null
+++ b/src/venus/vkr_win32_foreign.h
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef VKR_WIN32_FOREIGN_H
+#define VKR_WIN32_FOREIGN_H
+
+#include <stdbool.h>
+#include "venus-protocol/vulkan_core.h"
+
+/* The experimental Win32 dma-buf domain exports only bridge-owned resources
+ * on the same adapter/driver. The host therefore uses EXTERNAL ownership.
+ * Do not use this translation for arbitrary foreign devices or drivers. */
+static inline uint32_t
+vkr_win32_foreign_index(uint32_t index)
+{
+   return index == VK_QUEUE_FAMILY_FOREIGN_EXT ? VK_QUEUE_FAMILY_EXTERNAL : index;
+}
+
+static inline void
+vkr_win32_foreign_barriers(bool enabled, uint32_t buffer_count,
+                           const VkBufferMemoryBarrier *buffers,
+                           uint32_t image_count, const VkImageMemoryBarrier *images)
+{
+   if (!enabled)
+      return;
+   for (uint32_t i = 0; i < buffer_count; i++) {
+      VkBufferMemoryBarrier *barrier = (VkBufferMemoryBarrier *)&buffers[i];
+      barrier->srcQueueFamilyIndex = vkr_win32_foreign_index(barrier->srcQueueFamilyIndex);
+      barrier->dstQueueFamilyIndex = vkr_win32_foreign_index(barrier->dstQueueFamilyIndex);
+   }
+   for (uint32_t i = 0; i < image_count; i++) {
+      VkImageMemoryBarrier *barrier = (VkImageMemoryBarrier *)&images[i];
+      barrier->srcQueueFamilyIndex = vkr_win32_foreign_index(barrier->srcQueueFamilyIndex);
+      barrier->dstQueueFamilyIndex = vkr_win32_foreign_index(barrier->dstQueueFamilyIndex);
+   }
+}
+
+static inline void
+vkr_win32_foreign_dependencies(bool enabled, uint32_t count,
+                               const VkDependencyInfo *dependencies)
+{
+   if (!enabled)
+      return;
+   for (uint32_t d = 0; d < count; d++) {
+      const VkDependencyInfo *info = &dependencies[d];
+      for (uint32_t i = 0; i < info->bufferMemoryBarrierCount; i++) {
+         VkBufferMemoryBarrier2 *barrier = (VkBufferMemoryBarrier2 *)&info->pBufferMemoryBarriers[i];
+         barrier->srcQueueFamilyIndex = vkr_win32_foreign_index(barrier->srcQueueFamilyIndex);
+         barrier->dstQueueFamilyIndex = vkr_win32_foreign_index(barrier->dstQueueFamilyIndex);
+      }
+      for (uint32_t i = 0; i < info->imageMemoryBarrierCount; i++) {
+         VkImageMemoryBarrier2 *barrier = (VkImageMemoryBarrier2 *)&info->pImageMemoryBarriers[i];
+         barrier->srcQueueFamilyIndex = vkr_win32_foreign_index(barrier->srcQueueFamilyIndex);
+         barrier->dstQueueFamilyIndex = vkr_win32_foreign_index(barrier->dstQueueFamilyIndex);
+      }
+   }
+}
+#endif
diff --git a/src/vrend/vrend_win32_wsi.c b/src/vrend/vrend_win32_wsi.c
new file mode 100644
--- /dev/null
+++ b/src/vrend/vrend_win32_wsi.c
@@ -0,0 +1,206 @@
+/* SPDX-License-Identifier: MIT */
+/* Opt-in RGBA8 linear storage shared by native Qualcomm Vulkan and Zink. */
+#define VK_NO_PROTOTYPES
+#define VK_USE_PLATFORM_WIN32_KHR
+#include <windows.h>
+#include <vulkan/vulkan.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "util/os_file.h"
+#include "vrend_win32_wsi.h"
+
+struct vrend_win32_wsi {
+   VkImage image;
+   VkDeviceMemory memory;
+   HANDLE handle;
+   struct virgl_resource_vulkan_info info;
+};
+static struct {
+   HMODULE loader;
+   VkInstance instance;
+   VkPhysicalDevice physical;
+   VkDevice device;
+   VkPhysicalDeviceMemoryProperties memory;
+   VkPhysicalDeviceIDProperties identity;
+   uint32_t live;
+   PFN_vkDestroyInstance DestroyInstance;
+   PFN_vkDestroyDevice DestroyDevice;
+   PFN_vkCreateImage CreateImage;
+   PFN_vkDestroyImage DestroyImage;
+   PFN_vkGetImageMemoryRequirements GetImageMemoryRequirements;
+   PFN_vkGetImageSubresourceLayout GetImageSubresourceLayout;
+   PFN_vkAllocateMemory AllocateMemory;
+   PFN_vkFreeMemory FreeMemory;
+   PFN_vkBindImageMemory BindImageMemory;
+   PFN_vkGetMemoryWin32HandleKHR GetMemoryWin32HandleKHR;
+} wsi;
+
+void vrend_win32_wsi_fini(void)
+{
+   /* Destroyed textures release their allocation first. Never invalidate live imports. */
+   if (wsi.live) return;
+   if (wsi.device && wsi.DestroyDevice) wsi.DestroyDevice(wsi.device, NULL);
+   if (wsi.instance && wsi.DestroyInstance) wsi.DestroyInstance(wsi.instance, NULL);
+   if (wsi.loader) FreeLibrary(wsi.loader);
+   memset(&wsi, 0, sizeof(wsi));
+}
+
+static bool vrend_win32_wsi_init(void)
+{
+   if (wsi.device) return true;
+   wsi.loader = LoadLibraryExW(L"vulkan-1.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32);
+   if (!wsi.loader) return false;
+   PFN_vkGetInstanceProcAddr get_instance =
+      (PFN_vkGetInstanceProcAddr)(void *)GetProcAddress(wsi.loader, "vkGetInstanceProcAddr");
+   if (!get_instance) goto fail;
+   PFN_vkCreateInstance create_instance = (PFN_vkCreateInstance)get_instance(NULL, "vkCreateInstance");
+   if (!create_instance) goto fail;
+   const VkApplicationInfo app = {.sType=VK_STRUCTURE_TYPE_APPLICATION_INFO,
+      .pApplicationName="Habumi shared screen storage", .apiVersion=VK_API_VERSION_1_1};
+   const VkInstanceCreateInfo ici = {.sType=VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,.pApplicationInfo=&app};
+   if (create_instance(&ici, NULL, &wsi.instance) != VK_SUCCESS) goto fail;
+#define INSTANCE(name) (PFN_vk##name)get_instance(wsi.instance, "vk" #name)
+   wsi.DestroyInstance = INSTANCE(DestroyInstance);
+   PFN_vkEnumeratePhysicalDevices enumerate = INSTANCE(EnumeratePhysicalDevices);
+   PFN_vkGetPhysicalDeviceProperties properties = INSTANCE(GetPhysicalDeviceProperties);
+   PFN_vkGetPhysicalDeviceProperties2 properties2 = INSTANCE(GetPhysicalDeviceProperties2);
+   PFN_vkGetPhysicalDeviceMemoryProperties memory = INSTANCE(GetPhysicalDeviceMemoryProperties);
+   PFN_vkGetPhysicalDeviceQueueFamilyProperties queues = INSTANCE(GetPhysicalDeviceQueueFamilyProperties);
+   PFN_vkGetPhysicalDeviceImageFormatProperties2 image_properties = INSTANCE(GetPhysicalDeviceImageFormatProperties2);
+   PFN_vkCreateDevice create_device = INSTANCE(CreateDevice);
+   PFN_vkGetDeviceProcAddr get_device = INSTANCE(GetDeviceProcAddr);
+   if (!wsi.DestroyInstance || !enumerate || !properties || !properties2 || !memory ||
+       !queues || !create_device || !get_device || !image_properties) goto fail;
+   VkPhysicalDevice devices[16]; uint32_t count=16;
+   if (enumerate(wsi.instance, &count, devices) != VK_SUCCESS) goto fail;
+   for (uint32_t i=0;i<count;i++) {
+      VkPhysicalDeviceProperties props;
+      properties(devices[i], &props);
+      if (props.vendorID == 0x5143 && props.deviceType == VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU) {
+         wsi.physical = devices[i]; break;
+      }
+   }
+   if (!wsi.physical) goto fail;
+   const VkPhysicalDeviceExternalImageFormatInfo external = {
+      .sType=VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_IMAGE_FORMAT_INFO,
+      .handleType=VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT};
+   const VkPhysicalDeviceImageFormatInfo2 image = {
+      .sType=VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2,.pNext=&external,
+      .format=VK_FORMAT_R8G8B8A8_UNORM,.type=VK_IMAGE_TYPE_2D,.tiling=VK_IMAGE_TILING_LINEAR,
+      .usage=VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT|VK_IMAGE_USAGE_SAMPLED_BIT|
+             VK_IMAGE_USAGE_TRANSFER_SRC_BIT|VK_IMAGE_USAGE_TRANSFER_DST_BIT};
+   VkExternalImageFormatProperties ep = {.sType=VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES};
+   VkImageFormatProperties2 ip = {.sType=VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2,.pNext=&ep};
+   if (image_properties(wsi.physical,&image,&ip) != VK_SUCCESS ||
+       !(ep.externalMemoryProperties.externalMemoryFeatures & VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT)) goto fail;
+   VkQueueFamilyProperties families[32]; uint32_t num=32, family=UINT32_MAX;
+   queues(wsi.physical,&num,families);
+   for(uint32_t i=0;i<num;i++) if(families[i].queueFlags & VK_QUEUE_GRAPHICS_BIT) {family=i;break;}
+   if(family==UINT32_MAX) goto fail;
+   wsi.identity.sType=VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES;
+   VkPhysicalDeviceProperties2 id={.sType=VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,.pNext=&wsi.identity};
+   properties2(wsi.physical,&id);
+   memory(wsi.physical,&wsi.memory);
+   const float priority=1;
+   const VkDeviceQueueCreateInfo qci={.sType=VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex=family,.queueCount=1,.pQueuePriorities=&priority};
+   const char *extensions[]={VK_KHR_EXTERNAL_MEMORY_WIN32_EXTENSION_NAME};
+   const VkDeviceCreateInfo dci={.sType=VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,.queueCreateInfoCount=1,
+      .pQueueCreateInfos=&qci,.enabledExtensionCount=1,.ppEnabledExtensionNames=extensions};
+   if(create_device(wsi.physical,&dci,NULL,&wsi.device)!=VK_SUCCESS) goto fail;
+#define DEVICE(name) do { wsi.name=(PFN_vk##name)get_device(wsi.device,"vk" #name); if(!wsi.name) goto fail; } while(0)
+   DEVICE(DestroyDevice); DEVICE(CreateImage); DEVICE(DestroyImage); DEVICE(GetImageMemoryRequirements);
+   DEVICE(GetImageSubresourceLayout); DEVICE(AllocateMemory); DEVICE(FreeMemory);
+   DEVICE(BindImageMemory); DEVICE(GetMemoryWin32HandleKHR);
+   return true;
+fail:
+   vrend_win32_wsi_fini();
+   return false;
+}
+
+struct vrend_win32_wsi *vrend_win32_wsi_create(uint32_t width, uint32_t height,
+                                             bool *unsupported_layout)
+{
+   *unsupported_layout=false;
+   if (!width || !height || !vrend_win32_wsi_init()) return NULL;
+   struct vrend_win32_wsi *allocation=calloc(1,sizeof(*allocation));
+   if (!allocation) return NULL;
+   wsi.live++;
+   const VkExternalMemoryImageCreateInfo external={.sType=VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO,
+      .handleTypes=VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT};
+   const VkImageCreateInfo image={.sType=VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,.pNext=&external,
+      .imageType=VK_IMAGE_TYPE_2D,.format=VK_FORMAT_R8G8B8A8_UNORM,.extent={width,height,1},
+      .mipLevels=1,.arrayLayers=1,.samples=VK_SAMPLE_COUNT_1_BIT,.tiling=VK_IMAGE_TILING_LINEAR,
+      .usage=VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT|VK_IMAGE_USAGE_SAMPLED_BIT|
+             VK_IMAGE_USAGE_TRANSFER_SRC_BIT|VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+      .sharingMode=VK_SHARING_MODE_EXCLUSIVE,.initialLayout=VK_IMAGE_LAYOUT_UNDEFINED};
+   if(wsi.CreateImage(wsi.device,&image,NULL,&allocation->image)!=VK_SUCCESS) goto fail;
+   VkMemoryRequirements req;
+   wsi.GetImageMemoryRequirements(wsi.device,allocation->image,&req);
+   uint32_t type=UINT32_MAX;
+   for(uint32_t i=0;i<wsi.memory.memoryTypeCount;i++)
+      if((req.memoryTypeBits & (1u<<i)) &&
+         (wsi.memory.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) {type=i;break;}
+   if(type==UINT32_MAX) goto fail;
+   const VkMemoryDedicatedAllocateInfo dedicated={.sType=VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+      .image=allocation->image};
+   const VkExportMemoryAllocateInfo export={.sType=VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO,
+      .pNext=&dedicated,.handleTypes=VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT};
+   const VkMemoryAllocateInfo alloc={.sType=VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,.pNext=&export,
+      .allocationSize=req.size,.memoryTypeIndex=type};
+   if(wsi.AllocateMemory(wsi.device,&alloc,NULL,&allocation->memory)!=VK_SUCCESS ||
+      wsi.BindImageMemory(wsi.device,allocation->image,allocation->memory,0)!=VK_SUCCESS) goto fail;
+   const VkImageSubresource sub={.aspectMask=VK_IMAGE_ASPECT_COLOR_BIT};
+   VkSubresourceLayout layout;
+   wsi.GetImageSubresourceLayout(wsi.device,allocation->image,&sub,&layout);
+   /* Guest GBM assumes tightly packed LINEAR RGBA8 at offset zero. */
+   if(layout.offset || layout.rowPitch != (uint64_t)width*4) {
+      fprintf(stderr,"[venus-wsi] native layout unavailable %ux%u offset=%llu pitch=%llu expected=%llu\n",
+              width,height,(unsigned long long)layout.offset,(unsigned long long)layout.rowPitch,
+              (unsigned long long)width*4);
+      *unsupported_layout=true;
+      goto fail;
+   }
+   const VkMemoryGetWin32HandleInfoKHR get_handle={.sType=VK_STRUCTURE_TYPE_MEMORY_GET_WIN32_HANDLE_INFO_KHR,
+      .memory=allocation->memory,.handleType=VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT};
+   if(wsi.GetMemoryWin32HandleKHR(wsi.device,&get_handle,&allocation->handle)!=VK_SUCCESS) goto fail;
+   memcpy(allocation->info.device_uuid,wsi.identity.deviceUUID,VK_UUID_SIZE);
+   memcpy(allocation->info.driver_uuid,wsi.identity.driverUUID,VK_UUID_SIZE);
+   allocation->info.allocation_size=req.size;
+   allocation->info.memory_type_index=type;
+   fprintf(stderr,"[venus-wsi] allocated native RGBA8 %ux%u bytes=%llu type=%u\n",
+      width,height,(unsigned long long)req.size,type);
+   return allocation;
+fail:
+   vrend_win32_wsi_destroy(allocation);
+   return NULL;
+}
+
+void vrend_win32_wsi_destroy(struct vrend_win32_wsi *allocation)
+{
+   if(!allocation) return;
+   if(allocation->handle) CloseHandle(allocation->handle);
+   if(allocation->image) wsi.DestroyImage(wsi.device,allocation->image,NULL);
+   if(allocation->memory) wsi.FreeMemory(wsi.device,allocation->memory,NULL);
+   free(allocation);
+   wsi.live--;
+}
+
+int vrend_win32_wsi_export(struct vrend_win32_wsi *allocation)
+{
+   HANDLE handle=NULL;
+   if(!allocation || !DuplicateHandle(GetCurrentProcess(),allocation->handle,
+       GetCurrentProcess(),&handle,0,FALSE,DUPLICATE_SAME_ACCESS)) return -1;
+   int fd=os_wrap_win32_handle(handle);
+   if(fd<0) CloseHandle(handle);
+   return fd;
+}
+
+bool vrend_win32_wsi_info(struct vrend_win32_wsi *allocation,
+                         struct virgl_resource_vulkan_info *info)
+{
+   if(!allocation) return false;
+   *info=allocation->info;
+   return true;
+}
