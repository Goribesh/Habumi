diff --git a/src/winq_venus_trace.h b/src/winq_venus_trace.h
new file mode 100644
--- /dev/null
+++ b/src/winq_venus_trace.h
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef WINQ_VENUS_TRACE_H
+#define WINQ_VENUS_TRACE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+/* Diagnostic only. Each metric has one writer or an existing owning lock.
+ * Dump after its writers have stopped. No per-frame I/O or new timer thread. */
+struct winq_trace_metric {
+   uint64_t count, ticks, max_ticks;
+};
+
+static inline bool
+winq_trace_enabled(void)
+{
+#ifdef _WIN32
+   const char *enabled = getenv("WINQ_VENUS_TRACE");
+   if (enabled && !strcmp(enabled, "1"))
+      return true;
+   const char *path = getenv("WINQ_VENUS_TRACE_FILE");
+   if (!path || !path[0])
+      return false;
+   FILE *file = fopen(path, "rb");
+   if (!file)
+      return false;
+   int value = fgetc(file);
+   fclose(file);
+   return value == '1';
+#else
+   return false;
+#endif
+}
+
+static inline uint64_t
+winq_trace_now(bool enabled)
+{
+#ifdef _WIN32
+   LARGE_INTEGER value;
+   if (enabled && QueryPerformanceCounter(&value))
+      return (uint64_t)value.QuadPart;
+#else
+   (void)enabled;
+#endif
+   return 0;
+}
+
+static inline void
+winq_trace_add(struct winq_trace_metric *metric, uint64_t begin, uint64_t end)
+{
+   if (!begin || end < begin)
+      return;
+   uint64_t delta = end - begin;
+   metric->count++;
+   metric->ticks += delta;
+   if (delta > metric->max_ticks)
+      metric->max_ticks = delta;
+}
+
+static inline void
+winq_trace_dump(uint32_t ctx, uint32_t ring, const char *name,
+                const struct winq_trace_metric *metric)
+{
+#ifdef _WIN32
+   LARGE_INTEGER frequency;
+   if (!metric->count || !QueryPerformanceFrequency(&frequency))
+      return;
+   double us_per_tick = 1000000.0 / (double)frequency.QuadPart;
+   fprintf(stderr, "[venus-trace] ctx=%u ring=%u stage=%s count=%" PRIu64
+           " mean_us=%.3f max_us=%.3f\n", ctx, ring, name, metric->count,
+           (double)metric->ticks * us_per_tick / (double)metric->count,
+           (double)metric->max_ticks * us_per_tick);
+#else
+   (void)ctx; (void)ring; (void)name; (void)metric;
+#endif
+}
+#endif
