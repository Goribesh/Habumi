+{
+    prova_accumulo();
+    prova_intervallo_negativo();
+    prova_lettura_azzera();
+    prova_secchio_invalido();
+    prova_thread_invalido();
+    prova_taratura();
+    prova_costo_thread_id();
+    prova_frequenza_non_impostata();
+    prova_taratura_frequenza_non_impostata();
+    prova_intervallo_ns();
+    prova_somma_gpu();
+    prova_finestra_flag();
+    prova_aggiungi_fuori();
+    prova_aggiungi_fuori_orologio_indietro();
+    prova_aggiungi_fuori_frequenza_non_impostata();
+    prova_aggiungi_fuori_secchio_invalido();
+    prova_aggiungi_fuori_thread_invalido();
+    prova_somma_finestra();
+    prova_lettura_azzera_campi_nuovi();
+    prova_secchi_attesa_distinti();
+    prova_sonda_richiesta_e_registrazione();
+    prova_sonda_azzerata_se_non_eseguita();
+    prova_thread_id_forzato();
+    prova_thread_registrazione_principale();
+    prova_thread_indice_principale_e_altri();
+    prova_thread_registro_tabella();
+    prova_thread_registro_persiste();
+    prova_dentro_e_fuori_per_thread_indipendenti();
+    prova_ctx_richiesto_e_vero();
+    prova_ctx_origine_invalida();
+    prova_ctx_azzerato_da_leggi();
+
+    if (falliti) {
+        printf("\n%d PROVE FALLITE\n", falliti);
+        return 1;
+    }
+    printf("\ntutte le prove passate\n");
+    return 0;
+}
