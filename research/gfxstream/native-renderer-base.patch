+#define glDrawArraysInstancedARB(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glDrawArraysInstancedARB(__VA_ARGS__))
+#undef glDrawArraysInstancedBaseInstance
+#define glDrawArraysInstancedBaseInstance(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glDrawArraysInstancedBaseInstance(__VA_ARGS__))
+#undef glDrawElementsBaseVertex
+#define glDrawElementsBaseVertex(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glDrawElementsBaseVertex(__VA_ARGS__))
+#undef glDrawElementsIndirect
+#define glDrawElementsIndirect(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glDrawElementsIndirect(__VA_ARGS__))
+#undef glDrawElementsInstancedARB
+#define glDrawElementsInstancedARB(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glDrawElementsInstancedARB(__VA_ARGS__))
+#undef glDrawElementsInstancedBaseInstance
+#define glDrawElementsInstancedBaseInstance(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glDrawElementsInstancedBaseInstance(__VA_ARGS__))
+#undef glDrawElementsInstancedBaseVertex
+#define glDrawElementsInstancedBaseVertex(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glDrawElementsInstancedBaseVertex(__VA_ARGS__))
+#undef glDrawElementsInstancedBaseVertexBaseInstance
+#define glDrawElementsInstancedBaseVertexBaseInstance(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glDrawElementsInstancedBaseVertexBaseInstance(__VA_ARGS__))
+#undef glDrawRangeElements
+#define glDrawRangeElements(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glDrawRangeElements(__VA_ARGS__))
+#undef glDrawRangeElementsBaseVertex
+#define glDrawRangeElementsBaseVertex(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glDrawRangeElementsBaseVertex(__VA_ARGS__))
+#undef glDrawBuffers
+#define glDrawBuffers(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glDrawBuffers(__VA_ARGS__))
+#undef glDrawPixels
+#define glDrawPixels(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glDrawPixels(__VA_ARGS__))
+#undef glMultiDrawArraysIndirect
+#define glMultiDrawArraysIndirect(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glMultiDrawArraysIndirect(__VA_ARGS__))
+#undef glMultiDrawArraysIndirectCountARB
+#define glMultiDrawArraysIndirectCountARB(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glMultiDrawArraysIndirectCountARB(__VA_ARGS__))
+#undef glMultiDrawElementsIndirect
+#define glMultiDrawElementsIndirect(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glMultiDrawElementsIndirect(__VA_ARGS__))
+#undef glMultiDrawElementsIndirectCountARB
+#define glMultiDrawElementsIndirectCountARB(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glMultiDrawElementsIndirectCountARB(__VA_ARGS__))
+
+/* --- calcolo: stesso ruolo del disegno, ma per gli shader di calcolo ----- *
+ * vrend_launch_grid (vrend_renderer.c riga ~6297) e' il dispatch del calcolo
+ * cosi' come vrend_draw_vbo lo e' per il disegno: stessa sottrazione, stesso
+ * rischio di finire in t_virgl se non avvolto. */
+#undef glDispatchCompute
+#define glDispatchCompute(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glDispatchCompute(__VA_ARGS__))
+#undef glDispatchComputeIndirect
+#define glDispatchComputeIndirect(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glDispatchComputeIndirect(__VA_ARGS__))
+
+/* --- framebuffer: l'aggancio delle render target, a ogni cambio ---------- *
+ * Rilievo verificato dal coordinatore: glFramebufferTexture2DMultisampleEXT
+ * e glRenderbufferStorageMultisampleEXT erano finite fra le esclusioni come
+ * "creazione di risorse, una tantum". Falso: la catena e'
+ * vrend_set_framebuffer_state (riga 3183, il gestore del comando guest "set
+ * framebuffer state") -> vrend_hw_set_zsurf_texture/vrend_hw_set_color_surface
+ * (righe 3076/3093) -> vrend_fb_bind_texture_id (riga 2992) ->
+ * vrend_framebuffer_texture_2d (riga 2931, dove stanno le due macro). Scatta
+ * a ogni cambio di render target, non alla creazione. Peggio: dentro la
+ * stessa funzione, glGenRenderbuffers (riga 2949) e' incondizionato -- non
+ * controlla mai res->rbo_id prima di generarne uno nuovo -- quindi rialloca
+ * un renderbuffer ogni volta che ci passa (bug di risorse a se', fuori
+ * scope per questo file: segnalato separatamente, non toccato qui).
+ *
+ * Spostate qui, in WINQ_SPIA_GL. Con loro le sorelle dirette nello stesso
+ * sito, incluse per lo stesso motivo per cui i giri precedenti hanno chiuso
+ * i buchi analoghi su glDraw* e glTexSubImage* (non lasciare una sorella
+ * scoperta sullo stesso dispatch): glFramebufferTexture2D (la stessa
+ * funzione, ramo non-MSAA, di gran lunga il piu' usato), glFramebufferTexture/
+ * glFramebufferTextureLayer/glFramebufferTexture1D/glFramebufferTexture3D/
+ * glFramebufferTexture3DOES (vrend_fb_bind_texture_id, righe 3017-3057, il
+ * dispatch per target array/cubemap/3D/1D), glFramebufferRenderbuffer (riga
+ * 2954, tre righe sotto la Multisample, stesso ramo). glCheckFramebufferStatus
+ * (riga 3273 qui, anche in vrend_formats.c) e' incluso perche' e' letteralmente
+ * "il driver valida lo stato" -- la stessa frase che il commento del secchio
+ * disegno usa per giustificare se stesso; ritorna GLenum, quindi WINQ_SPIA_VAL.
+ *
+ * NON incluse, con la ragione vera e non una frequenza indovinata:
+ * glGenRenderbuffers (genera solo un nome intero, l'allocazione vera e'
+ * glRenderbufferStorageMultisampleEXT tre righe sotto, gia' inclusa -- stessa
+ * ragione per cui glGenBuffersARB/glGenFramebuffers/glGenTextures non sono
+ * mai stati in questo file), glBindRenderbuffer/glBindFramebuffer (bind,
+ * scambiano un puntatore di stato, non validano ne' allocano -- stessa
+ * ragione di glBindBuffer/glBindTexture altrove nel file, mai avvolte),
+ * glReadBuffer (imposta quale buffer leggere, puntatore di stato come i
+ * bind, non esegue lavoro). */
+#undef glFramebufferTexture2D
+#define glFramebufferTexture2D(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glFramebufferTexture2D(__VA_ARGS__))
+#undef glFramebufferTexture2DMultisampleEXT
+#define glFramebufferTexture2DMultisampleEXT(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glFramebufferTexture2DMultisampleEXT(__VA_ARGS__))
+#undef glFramebufferTexture
+#define glFramebufferTexture(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glFramebufferTexture(__VA_ARGS__))
+#undef glFramebufferTextureLayer
+#define glFramebufferTextureLayer(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glFramebufferTextureLayer(__VA_ARGS__))
+#undef glFramebufferTexture1D
+#define glFramebufferTexture1D(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glFramebufferTexture1D(__VA_ARGS__))
+#undef glFramebufferTexture3D
+#define glFramebufferTexture3D(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glFramebufferTexture3D(__VA_ARGS__))
+#undef glFramebufferTexture3DOES
+#define glFramebufferTexture3DOES(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glFramebufferTexture3DOES(__VA_ARGS__))
+#undef glFramebufferRenderbuffer
+#define glFramebufferRenderbuffer(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glFramebufferRenderbuffer(__VA_ARGS__))
+#undef glRenderbufferStorageMultisampleEXT
+#define glRenderbufferStorageMultisampleEXT(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glRenderbufferStorageMultisampleEXT(__VA_ARGS__))
+#undef glCheckFramebufferStatus
+#define glCheckFramebufferStatus(...) \
+    WINQ_SPIA_VAL(WINQ_SPIA_GL, epoxy_glCheckFramebufferStatus(__VA_ARGS__))
+
+/* --- buffer: il traffico di dati guest -> host --------------------------- */
+#undef glBufferData
+#define glBufferData(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glBufferData(__VA_ARGS__))
+#undef glBufferSubData
+#define glBufferSubData(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glBufferSubData(__VA_ARGS__))
+#undef glMapBufferRange
+#define glMapBufferRange(...) \
+    WINQ_SPIA_VAL(WINQ_SPIA_GL, epoxy_glMapBufferRange(__VA_ARGS__))
+#undef glUnmapBuffer
+#define glUnmapBuffer(...) \
+    WINQ_SPIA_VAL(WINQ_SPIA_GL, epoxy_glUnmapBuffer(__VA_ARGS__))
+#undef glCopyBufferSubData
