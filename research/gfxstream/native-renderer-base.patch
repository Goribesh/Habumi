+/* TERZA CORREZIONE DELL'11/08/2026: ATTESA sommava glFlush, glFinish e
+ * glClientWaitSync in un solo secchio. Qui si verifica che i tre secchi
+ * nuovi (FLUSH/FINISH/WAITSYNC) siano davvero indipendenti fra loro e dai
+ * secchi preesistenti (GL/SHADER/GPU) -- il livello macro (winq-glspia.h) non
+ * e' provabile senza GL, ma l'array sottostante (ns[]/chiamate[], dimensionato
+ * su WINQ_SPIA_N) e' lo stesso che le macro useranno, quindi provarlo qui
+ * copre la parte che conta: che allungare l'enum non abbia fatto collidere
+ * due secchi sullo stesso indice. */
+static void prova_secchi_attesa_distinti(void)
+{
+    struct winq_glspia s;
+
+    printf("i tre secchi di attesa sono distinti:\n");
+    winq_glspia_freq_forza(1000000);
+    winq_glspia_azzera();
+
+    winq_glspia_aggiungi(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_FLUSH, 0, 100);      /* 100 us */
+    winq_glspia_aggiungi(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_FINISH, 0, 200);     /* 200 us */
+    winq_glspia_aggiungi(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_WAITSYNC, 0, 300);   /* 300 us */
+
+    winq_glspia_leggi(&s);
+    esigi(s.ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_FLUSH] == 100000, "FLUSH: 100 us, non contaminato");
+    esigi(s.ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_FINISH] == 200000, "FINISH: 200 us, non contaminato");
+    esigi(s.ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_WAITSYNC] == 300000, "WAITSYNC: 300 us, non contaminato");
+    esigi(s.chiamate[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_FLUSH] == 1, "FLUSH: una chiamata");
+    esigi(s.chiamate[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_FINISH] == 1, "FINISH: una chiamata");
+    esigi(s.chiamate[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_WAITSYNC] == 1, "WAITSYNC: una chiamata");
+    esigi(s.ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GL] == 0, "GL: intatto");
+    esigi(s.ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_SHADER] == 0, "SHADER: intatto");
+    esigi(s.ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GPU] == 0, "GPU: intatto");
+}
