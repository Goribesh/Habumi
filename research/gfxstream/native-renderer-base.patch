+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glCompressedTexSubImage1D(__VA_ARGS__))
+#undef glCompressedTexSubImage2D
+#define glCompressedTexSubImage2D(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glCompressedTexSubImage2D(__VA_ARGS__))
+#undef glCompressedTexSubImage3D
+#define glCompressedTexSubImage3D(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glCompressedTexSubImage3D(__VA_ARGS__))
+#undef glCopyImageSubData
