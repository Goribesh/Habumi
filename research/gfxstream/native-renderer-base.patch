+/* SONDA glGetError, aggiunta l'11/08/2026. Qui si prova solo la logica di
+ * armo/richiesta/registrazione in winq-glspia-conta.c: le chiamate GL vere
+ * (epoxy_glGetError() dentro gpu_apri()/gpu_chiudi()) vivono in
+ * winq-glspia-gpu.c, che tocca GL e per questo resta fuori da
+ * test-glspia.sh (vedi il commento in cima al file). */
+static void prova_sonda_richiesta_e_registrazione(void)
+{
+    struct winq_glspia s;
+
+    printf("sonda: richiesta, registrazione, disarmo:\n");
+    winq_glspia_azzera();
+    /* Stato di partenza noto: forza un ciclo completo cosi' il test non
+     * dipende da come sonda_armata era lasciata dalla prova precedente. */
+    winq_glspia_sonda_registra_inizio(0);
+    winq_glspia_sonda_registra_fine(0);
+    winq_glspia_leggi(&s);   /* scarta: serve solo a riarmare in modo noto */
+
+    esigi(winq_glspia_sonda_richiesta(), "armata dopo la lettura");
+
+    winq_glspia_sonda_registra_inizio(0);
+    esigi(winq_glspia_sonda_richiesta(),
+          "ancora armata dopo registra_inizio: fine() la disarma, non inizio()");
+
+    winq_glspia_sonda_registra_fine(0x0502);   /* GL_INVALID_OPERATION */
+    esigi(!winq_glspia_sonda_richiesta(), "disarmata dopo registra_fine");
+
+    winq_glspia_leggi(&s);
+    esigi(s.sonda_eseguita == 1, "eseguita: vera");
+    esigi(s.sonda_errore_inizio == 0, "inizio: GL_NO_ERROR");
+    esigi(s.sonda_errore_fine == 0x0502, "fine: il codice passato a registra_fine");
+}
+
+/* Un ciclo senza nessuna registrazione deve leggersi come "non eseguita", non
+ * come "eseguita con successo" (i codici a zero sarebbero indistinguibili da
+ * GL_NO_ERROR senza sonda_eseguita) -- e azzera() deve davvero azzerare i tre
+ * campi, non lasciare i valori del ciclo precedente. */
+static void prova_sonda_azzerata_se_non_eseguita(void)
+{
+    struct winq_glspia s;
+
+    printf("sonda non eseguita: azzerata, non un residuo del ciclo prima:\n");
+    winq_glspia_azzera();
+
+    winq_glspia_sonda_registra_inizio(0x0500);   /* GL_INVALID_ENUM */
+    winq_glspia_sonda_registra_fine(0x0501);     /* GL_INVALID_VALUE */
+    winq_glspia_leggi(&s);
+    esigi(s.sonda_eseguita == 1, "primo ciclo: eseguita (per costruzione della prova)");
+
+    /* Secondo ciclo: la lettura sopra ha riarmato la richiesta, ma qui
+     * nessuno la consuma -- come un ciclo reale in cui nessun gpu_apri()
+     * arriva a aprire una query. */
+    winq_glspia_leggi(&s);
+    esigi(s.sonda_eseguita == 0, "secondo ciclo: non eseguita");
+    esigi(s.sonda_errore_inizio == 0, "secondo ciclo: inizio azzerato, non un residuo");
+    esigi(s.sonda_errore_fine == 0, "secondo ciclo: fine azzerata, non un residuo");
+}
+
+/* QUARTA CORREZIONE DELL'11/08/2026. winq_glspia_thread_forza()/thread_vero()
+ * rendono deterministico cio' che winq_glspia_thread_id() restituisce, senza
+ * dover creare un secondo thread vero: la prova base che il seme funziona. */
+static void prova_thread_id_forzato(void)
+{
+    printf("thread id forzato per le prove:\n");
+
+    winq_glspia_thread_forza(777);
+    esigi(winq_glspia_thread_id() == 777, "restituisce il valore forzato");
+
+    winq_glspia_thread_forza(42);
+    esigi(winq_glspia_thread_id() == 42, "cambia se forzato di nuovo");
+
+    winq_glspia_thread_vero();
+    esigi(winq_glspia_thread_id() != 777 && winq_glspia_thread_id() != 42,
+          "tornato al vero GetCurrentThreadId(), non piu' al valore forzato");
+    esigi(winq_glspia_thread_id() != 0, "il vero thread id non e' mai zero");
+}
+
+/* winq_glspia_finestra_apri() registra il thread principale SOLO alla prima
+ * chiamata: chiamate successive, anche da un "thread" (forzato) diverso, non
+ * lo devono riscrivere -- altrimenti un secondo thread che needlessly
+ * chiamasse questa funzione soppianterebbe quello vero. */
+static void prova_thread_registrazione_principale(void)
+{
+    struct winq_glspia s;
+
+    printf("registrazione del thread principale:\n");
+    winq_glspia_thread_azzera_registro();
+
+    winq_glspia_thread_forza(1001);
+    winq_glspia_finestra_apri();
+    winq_glspia_finestra_chiudi();
+    winq_glspia_leggi(&s);
+    esigi(s.thread_principale == 1001, "registrato alla prima chiamata");
+
+    /* Una "seconda" chiamata da un thread diverso (forzato): non deve
+     * cambiare chi e' il principale. */
+    winq_glspia_thread_forza(2002);
+    winq_glspia_finestra_apri();
+    winq_glspia_finestra_chiudi();
+    winq_glspia_leggi(&s);
+    esigi(s.thread_principale == 1001, "non riscritto da una chiamata successiva");
+
+    winq_glspia_thread_azzera_registro();
+    winq_glspia_thread_vero();
+}
+
+/* Il cuore della correzione: lo stesso thread che ha aperto la finestra e'
+ * WINQ_THREAD_PRINCIPALE, un thread diverso e' WINQ_THREAD_ALTRI -- e
+ * l'effetto collaterale di thread_indice() lo registra nel piccolo insieme. */
+static void prova_thread_indice_principale_e_altri(void)
+{
+    struct winq_glspia s;
+
+    printf("thread_indice: principale contro altri:\n");
+    winq_glspia_thread_azzera_registro();
+
+    winq_glspia_thread_forza(5000);
+    winq_glspia_finestra_apri();   /* registra 5000 come principale */
+    winq_glspia_finestra_chiudi();
+    esigi(winq_glspia_thread_indice() == WINQ_THREAD_PRINCIPALE,
+          "lo stesso thread che ha aperto la finestra e' principale");
+
+    winq_glspia_thread_forza(6000);
+    esigi(winq_glspia_thread_indice() == WINQ_THREAD_ALTRI,
+          "un thread diverso e' altri");
+
+    winq_glspia_leggi(&s);
+    esigi(s.thread_principale == 5000, "il principale registrato e' 5000");
+    esigi(s.thread_altri_n == 1, "un solo altro thread visto");
+    esigi(s.thread_altri_id[0] == 6000, "il suo id e' 6000");
+
+    winq_glspia_thread_azzera_registro();
+    winq_glspia_thread_vero();
+}
+
+/* Il piccolo insieme regge fino a WINQ_THREAD_TABELLA identita' distinte; un
+ * thread ulteriore, distinto, non trova posto e si conta in
+ * thread_altri_fuori_tabella -- senza scrivere fuori dall'array
+ * thread_altri_id[]. Un thread GIA' visto, richiamato dopo che la tabella e'
+ * piena, non deve incrementare fuori_tabella: e' riconosciuto dalla scansione
+ * prima di provare a inserirlo. */
+static void prova_thread_registro_tabella(void)
+{
+    struct winq_glspia s;
+    int i;
+
+    printf("registro degli altri thread: tabella e overflow:\n");
+    winq_glspia_thread_azzera_registro();
+
+    winq_glspia_thread_forza(1);
+    winq_glspia_finestra_apri();   /* thread 1 = principale */
+    winq_glspia_finestra_chiudi();
+
+    for (i = 0; i < WINQ_THREAD_TABELLA; i++) {
+        winq_glspia_thread_forza((uint64_t)(100 + i));
+        (void)winq_glspia_thread_indice();
+    }
+    winq_glspia_leggi(&s);
+    esigi(s.thread_altri_n == WINQ_THREAD_TABELLA, "tabella piena: 8 altri thread distinti");
+    esigi(s.thread_altri_fuori_tabella == 0, "nessun overflow finche' la tabella non e' piena");
+
+    /* Un nono thread, distinto: non trova posto. */
+    winq_glspia_thread_forza(999);
+    esigi(winq_glspia_thread_indice() == WINQ_THREAD_ALTRI,
+          "resta 'altri' anche senza posto in tabella");
+    winq_glspia_leggi(&s);
+    esigi(s.thread_altri_n == WINQ_THREAD_TABELLA, "il conteggio in tabella non supera 8");
+    esigi(s.thread_altri_fuori_tabella == 1, "un overflow contato");
+
+    /* Un thread GIA' in tabella (100), richiamato ora: riconosciuto dalla
+     * scansione, nessun NUOVO overflow. thread_altri_fuori_tabella e'
+     * persistente (leggi() non lo azzera, vedi prova_thread_registro_persiste):
+     * resta 1, quello del thread 999 sopra -- se la scansione non
+     * riconoscesse 100 diventerebbe 2. */
+    winq_glspia_thread_forza(100);
+    (void)winq_glspia_thread_indice();
+    winq_glspia_leggi(&s);
+    esigi(s.thread_altri_fuori_tabella == 1,
+          "un thread gia' noto non aggiunge un secondo overflow");
+
+    winq_glspia_thread_azzera_registro();
+    winq_glspia_thread_vero();
+}
+
+/* Il registro (thread_principale, thread_altri_*) e' un'identita' di
+ * processo, non un accumulo al secondo: winq_glspia_azzera()/leggi() NON lo
+ * devono azzerare, a differenza di tutti gli altri campi della struct. Solo
+ * winq_glspia_thread_azzera_registro() (solo per le prove) lo fa. */
+static void prova_thread_registro_persiste(void)
+{
+    struct winq_glspia s;
+
+    printf("il registro dei thread persiste attraverso leggi()/azzera():\n");
+    winq_glspia_thread_azzera_registro();
+
+    winq_glspia_thread_forza(3003);
+    winq_glspia_finestra_apri();
+    winq_glspia_finestra_chiudi();
+    winq_glspia_thread_forza(4004);
+    (void)winq_glspia_thread_indice();
+
+    winq_glspia_azzera();   /* azzera i secchi, non deve toccare il registro */
+    winq_glspia_leggi(&s);
+    esigi(s.thread_principale == 3003, "principale intatto dopo azzera()/leggi()");
+    esigi(s.thread_altri_n == 1, "altri visti intatti dopo azzera()/leggi()");
+    esigi(s.thread_altri_id[0] == 4004, "il loro id e' intatto");
+
+    winq_glspia_leggi(&s);   /* una seconda lettura, stesso discorso */
+    esigi(s.thread_principale == 3003, "principale intatto anche alla seconda lettura");
+    esigi(s.thread_altri_n == 1, "altri visti intatti anche alla seconda lettura");
+
+    winq_glspia_thread_azzera_registro();
+    winq_glspia_thread_vero();
+}
+
+/* Il cuore della quarta correzione: dentro/altri e fuori/altri sono secchi
+ * indipendenti da dentro/principale e fuori/principale. Un thread "altri"
+ * che accumula non deve toccare le celle del principale, e viceversa --
+ * altrimenti la contaminazione che questa correzione esiste per rivelare
+ * sarebbe ancora invisibile, solo spostata. */
+static void prova_dentro_e_fuori_per_thread_indipendenti(void)
+{
+    struct winq_glspia s;
+
+    printf("dentro/altri e fuori/altri non contaminano il principale:\n");
+    winq_glspia_freq_forza(1000000);
+    winq_glspia_azzera();
+
+    winq_glspia_aggiungi(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_WAITSYNC, 0, 100);       /* 100 us */
+    winq_glspia_aggiungi(WINQ_THREAD_ALTRI, WINQ_SPIA_WAITSYNC, 0, 900);            /* 900 us */
+    winq_glspia_aggiungi_fuori(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_WAITSYNC, 0, 50);  /* 50 us */
+    winq_glspia_aggiungi_fuori(WINQ_THREAD_ALTRI, WINQ_SPIA_WAITSYNC, 0, 950);      /* 950 us */
+
+    winq_glspia_leggi(&s);
+    esigi(s.ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_WAITSYNC] == 100000,
+          "dentro/principale: 100 us, non contaminato da altri");
+    esigi(s.ns[WINQ_THREAD_ALTRI][WINQ_SPIA_WAITSYNC] == 900000,
+          "dentro/altri: 900 us, non nel secchio del principale");
+    esigi(s.fuori_ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_WAITSYNC] == 50000,
+          "fuori/principale: 50 us, non contaminato da altri");
+    esigi(s.fuori_ns[WINQ_THREAD_ALTRI][WINQ_SPIA_WAITSYNC] == 950000,
+          "fuori/altri: 950 us, non nel secchio del principale");
+}
+
+/* QUINTA CORREZIONE DELL'11/08/2026: winq_glspia_ctx_richiesto()/ctx_vero()
+ * sono incrementi banali (un confronto sui bordi, poi ++ o +=) -- non c'e'
+ * comportamento interessante da provare oltre a "scrivono nella casella
+ * giusta" e "un indice invalido non scrive fuori dall'array". Non invento
+ * prove piu' elaborate di quello che il codice fa davvero: la logica vera di
+ * questo giro (dove vrend_hw_switch_context() classifica l'origine e quando
+ * chiama davvero make_current) vive in vrend_renderer.c, tocca GL/vrend, e
+ * resta fuori da test-glspia.sh per lo stesso motivo di sempre -- vedi il
+ * commento in cima al file. */
+static void prova_ctx_richiesto_e_vero(void)
+{
+    struct winq_glspia s;
+
+    printf("switch di contesto: richiesto e vero, per origine:\n");
+    winq_glspia_azzera();
+
+    winq_glspia_ctx_richiesto(WINQ_CTX_FORCE0);
+    winq_glspia_ctx_richiesto(WINQ_CTX_FORCE0);
+    winq_glspia_ctx_richiesto(WINQ_CTX_ALTRO);
+    winq_glspia_ctx_vero(WINQ_CTX_FORCE0, 1000000);   /* 1 ms */
+    winq_glspia_ctx_vero(WINQ_CTX_ALTRO, 250000);     /* 0,25 ms */
+
+    winq_glspia_leggi(&s);
+    esigi(s.ctx_richiesti[WINQ_CTX_FORCE0] == 2, "FORCE0: due richieste");
+    esigi(s.ctx_richiesti[WINQ_CTX_ALTRO] == 1, "ALTRO: una richiesta, non contaminata da FORCE0");
+    esigi(s.ctx_veri[WINQ_CTX_FORCE0] == 1, "FORCE0: un switch vero");
+    esigi(s.ctx_veri[WINQ_CTX_ALTRO] == 1, "ALTRO: un switch vero, non contaminato da FORCE0");
+    esigi(s.ctx_ns[WINQ_CTX_FORCE0] == 1000000, "FORCE0: 1 ms cumulativo");
+    esigi(s.ctx_ns[WINQ_CTX_ALTRO] == 250000, "ALTRO: 0,25 ms cumulativo");
+    esigi(s.assurde == 0, "nessuna assurda su un origine valido");
+}
+
+/* Stesso rischio di ogni altro indice in questa struttura: un'origine fuori
+ * bounds deve scartarsi come assurda, non scrivere fuori da ctx_richiesti[]/
+ * ctx_veri[]/ctx_ns[]. */
+static void prova_ctx_origine_invalida(void)
+{
+    struct winq_glspia s;
+
+    printf("switch di contesto: origine invalida:\n");
+    winq_glspia_azzera();
+
+    winq_glspia_ctx_richiesto(-1);
+    winq_glspia_ctx_richiesto(WINQ_CTX_N);
+    winq_glspia_ctx_vero(-1, 1000);
+    winq_glspia_ctx_vero(WINQ_CTX_N + 99, 1000);
+
+    winq_glspia_leggi(&s);
+    esigi(s.assurde == 4, "quattro scarti contati, nessuna scrittura fuori dall'array");
+    esigi(s.ctx_richiesti[WINQ_CTX_FORCE0] == 0, "FORCE0 intatto");
+    esigi(s.ctx_richiesti[WINQ_CTX_ALTRO] == 0, "ALTRO intatto");
+}
+
+/* leggi()/azzera() devono ripulire anche questi tre campi: sono un accumulo
+ * al secondo come ns[]/chiamate[], non un registro persistente come
+ * thread_principale/thread_altri_*. */
+static void prova_ctx_azzerato_da_leggi(void)
+{
+    struct winq_glspia s;
+
+    printf("switch di contesto: azzerato dalla lettura:\n");
+    winq_glspia_azzera();
+
+    winq_glspia_ctx_richiesto(WINQ_CTX_FORCE0);
+    winq_glspia_ctx_vero(WINQ_CTX_FORCE0, 500000);
+    winq_glspia_leggi(&s);
+    esigi(s.ctx_richiesti[WINQ_CTX_FORCE0] == 1, "prima lettura: una richiesta");
+
+    winq_glspia_leggi(&s);
+    esigi(s.ctx_richiesti[WINQ_CTX_FORCE0] == 0, "seconda lettura: azzerato");
+    esigi(s.ctx_veri[WINQ_CTX_FORCE0] == 0, "seconda lettura: azzerato");
+    esigi(s.ctx_ns[WINQ_CTX_FORCE0] == 0, "seconda lettura: azzerato");
+}
