+ * vrend_decode.c. I nanosecondi arrivano gia' convertiti da
+ * winq_glspia_intervallo_ns(), quindi si sommano direttamente, come
+ * winq_glspia_somma_gpu(). */
+static void prova_somma_finestra(void)
