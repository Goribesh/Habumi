+    esigi(s.fuori_ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_WAITSYNC] == 1000000, "prima lettura: fuori(WAITSYNC) 1 ms");
+    esigi(s.fuori_chiamate[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_WAITSYNC] == 1, "prima lettura: una chiamata fuori(WAITSYNC)");
+    esigi(s.finestra_ns == 500000, "prima lettura: finestra 0,5 ms");
+
+    winq_glspia_leggi(&s);
+    esigi(s.fuori_ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_WAITSYNC] == 0, "seconda lettura: fuori(WAITSYNC) azzerato");
+    esigi(s.fuori_chiamate[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_WAITSYNC] == 0, "seconda lettura: zero chiamate fuori(WAITSYNC)");
+    esigi(s.finestra_ns == 0, "seconda lettura: finestra azzerata");
+}
