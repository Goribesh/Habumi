+/* winq-glspia.h -- cronometra le entry point GL calde.
+ *
+ * COME FUNZIONA. virglrenderer chiama GL attraverso libepoxy, dove ogni glFoo
+ * e' gia' una macro verso epoxy_glFoo (verificato: meson.build:88 dichiara
+ * dependency('epoxy', >= 1.5.4), src/meson.build:172 la lega, ed epoxy/gl.h e'
+ * incluso da virglrenderer.c, vrend/vrend_decode.c, vrend/vrend_renderer.h).
+ * Si toglie quella macro e se ne mette una che chiama epoxy_glFoo in mezzo a
+ * due letture dell'orologio. Nessun sito di chiamata cambia.
+ *
+ * Questo file viene FORCE-INCLUSO da src/meson.build con -include, quindi
+ * arriva prima di qualunque #include del file compilato. epoxy/gl.h ha le
+ * proprie guardie, percio' l'inclusione successiva nei sorgenti e' innocua.
+ *
+ * PERCHE' PIU' SECCHI E NON UNO. glFinish, glFlush e glClientWaitSync non
+ * sono lavoro: sono attesa, e per giunta attesa su tre cose diverse
+ * (rispettivamente: che la GPU smaltisca la coda, niente -- non aspetta --,
+ * una fence esplicita). Sommarle a glDrawElements gonfierebbe il costo del
+ * driver con tempo speso fermi, e la sottrazione della spec §3 attribuirebbe
+ * a virglrenderer un tempo che non ha speso lui; sommarle fra loro (com'era
+ * fino alla correzione dell'11/08/2026, un solo secchio ATTESA) nascondeva
+ * quale delle tre dominasse -- e lo split di "fuori" aveva appena mostrato
+ * che il grosso del secondo (64%, fuori/attesa) sta in una di queste tre,
+ * senza dire quale: la scomposizione qui e' apposta per rispondere a quella
+ * domanda, non per confermare un sospetto gia' deciso. glCompileShader e
+ * glLinkProgram sono lavoro ma di prima volta, e mescolarle al regime
+ * nasconderebbe proprio il fenomeno che si vuole vedere.
+ *
+ * PERCHE' PROPRIO QUESTI NOMI. Il criterio non e' "il nome inizia per glDraw"
+ * ne' un elenco copiato dall'API GL generica: e' "e' lavoro caldo del driver
+ * che oggi, se non avvolto, cade dentro t_virgl per sottrazione (spec §3) pur
+ * non essendo tempo speso da virglrenderer". Questo copre il dispatch del
+ * disegno (glDraw* e glMultiDraw*), il dispatch del calcolo (glDispatchCompute*,
+ * stesso ruolo del disegno ma per gli shader di calcolo), l'aggancio delle
+ * render target (glFramebufferTexture*, glFramebufferRenderbuffer,
+ * glRenderbufferStorageMultisampleEXT, glCheckFramebufferStatus: scattano a
+ * ogni cambio di framebuffer, non solo alla creazione, vedi il commento sopra
+ * quelle macro per la catena di chiamata verificata), il trasferimento dati
+ * guest -> host che passa da buffer/texture reali (glBufferSubData,
+ * glTexSubImage*, glCopyBufferSubData: dati veri che si spostano, non
+ * allocazione di storage con puntatore NULL), l'azzeramento di un target
+ * (glClear e sorelle, glClearTexSubImage: lavoro reale sullo stesso piano
+ * CPU del disegno, non solo impostazione di stato) e la lettura all'indietro
+ * host <- GPU (glGetTexImage, glReadPixels), messa in FINISH come
+ * approssimazione dichiarata: vedi il commento sopra quelle due macro, piu'
+ * sotto, per il perche'. Non copre invece la sola creazione di risorse
+ * (glTexStorage*, glTexImage* usate qui solo per allocare senza dati,
+ * glBufferStorage -- quasi sempre una tantum, con un'eccezione stretta
+ * documentata in fondo al file) ne' le barriere di sincronizzazione: vedi in
+ * fondo al file la lista di esclusioni motivate, con il sito di chiamata che
+ * giustifica ciascuna.
+ *
+ * Ogni nome qui sotto e' verificato sui siti di chiamata reali sotto
+ * src/vrend/ (non ricavato a memoria ne' copiato da un elenco di
+ * riferimento). Se il fork cambia -- una nuova estensione usata da
+ * vrend_renderer.c, un percorso di disegno o di trasferimento diverso --
+ * questo elenco va riverificato con una ricerca dei siti di chiamata e
+ * rivalutato con lo stesso criterio, non esteso a occhio rimettendo i nomi
+ * "ovvi" (es. glDrawArraysInstanced, o glTexStorage2D per simmetria con
+ * glTexImage2D) ne' escluso a occhio con una motivazione di categoria o di
+ * frequenza non verificata sul sito di chiamata: l'elenco e' gia' stato
+ * sbagliato piu' volte cosi', sia per difetto (nomi mancanti) sia per
+ * eccesso (esclusioni con la ragione sbagliata).
+ */
+#ifndef WINQ_GLSPIA_H
+#define WINQ_GLSPIA_H
+
+#include <epoxy/gl.h>
+#include "winq-glspia-conta.h"
+
+/* Le espressioni di statement sono un'estensione GNU, e questo albero si
+ * compila con clang in modalita' gnu11: sono disponibili. Servono perche' le
+ * funzioni GL avvolte hanno tipi di ritorno diversi e il wrapper deve
+ * restituirne il valore senza conoscerlo.
+ *
+ * LA SENTINELLA E' LO ZERO. winq_t0_ == 0 vuol dire "diagnostica spenta, non
+ * cronometrare". E' sicuro perche' winq_glspia_ora() legge QueryPerformanceCounter,
+ * che conta i tick da un riferimento fisso all'avvio del sistema: su hardware
+ * reale non e' mai zero, quindi una lettura vera con la diagnostica accesa non
+ * puo' mai essere scambiata per "spenta". Se in futuro winq_glspia_ora() venisse
+ * ricollegata a un orologio che *puo'* restituire zero, questa sentinella
+ * andrebbe rivista insieme a lei.
+ *
+ * CORREZIONE DELL'11/08/2026: la chiamata avvolta si cronometra sempre (se la
+ * diagnostica e' accesa), ma il risultato va nel secchio del suo gruppo solo
+ * se winq_glspia_in_finestra() dice che siamo dentro il tratto che
+ * vrend_decode_ctx_submit_cmd cronometra (vrend_decode.c, fra
+ * winq_glspia_finestra_apri() e finestra_chiudi()). Fuori da li' virglrenderer
+ * chiama GL comunque -- attesa sulle fence, trasferimenti di risorse,
+ * creazione di oggetti -- e quel tempo cadeva silenziosamente nel "cpu" che la
+ * riga di riepilogo sottrae, senza mai essere stato incluso: la causa della
+ * maggioranza dei campioni con virgl=0. winq_glspia_aggiungi_fuori() lo conta
+ * a parte, nello stesso secchio del gruppo ma nell'array "fuori" (vedi la
+ * struct in winq-glspia-conta.h): non e' un errore da scartare, e' lavoro
+ * fuori perimetro, e la seconda correzione dell'11/08/2026 l'ha reso
+ * distinto per GL/SHADER/ATTESA invece di un unico contenitore cieco.
+ *
+ * QUARTA CORREZIONE, STESSO GIORNO, LA PIU' SERIA: in_finestra e' un flag
+ * GLOBALE, alzato e abbassato solo dal thread che decodifica -- ma qualunque
+ * thread puo' chiamare una di queste macro. "Fuori" non vuol dire "sul thread
+ * principale", vuol dire "mentre il principale non decodificava"; e "dentro"
+ * non vuol dire "e' il principale che ha lavorato", vuol dire "e' successo
+ * mentre il principale teneva la finestra aperta" -- un altro thread (in
+ * questo fork, vrend-sync) che chiami nel frattempo finisce comunque in
+ * ns[]/chiamate[], contaminandoli. winq_glspia_thread_indice() risolve
+ * l'ambiguita': dice se il thread corrente e' quello registrato da
+ * winq_glspia_finestra_apri() o no, e il risultato va ad aggiungi()/
+ * aggiungi_fuori() come indice aggiuntivo, non come un secchio in piu' --
+ * vedi l'enum WINQ_THREAD_* in winq-glspia-conta.h. */
+#define WINQ_SPIA_VAL(secchio, espr) __extension__({                        \
+    uint64_t winq_t0_ = winq_glspia_accesa() ? winq_glspia_ora() : 0;       \
+    __typeof__(espr) winq_r_ = (espr);                                      \
+    if (winq_t0_) {                                                         \
+        uint64_t winq_t1_ = winq_glspia_ora();                              \
+        int winq_th_ = winq_glspia_thread_indice();                        \
+        if (winq_glspia_in_finestra()) {                                    \
+            winq_glspia_aggiungi(winq_th_, (secchio), winq_t0_, winq_t1_);  \
+        } else {                                                            \
+            winq_glspia_aggiungi_fuori(winq_th_, (secchio), winq_t0_, winq_t1_); \
+        }                                                                    \
+    }                                                                       \
+    winq_r_;                                                                \
+})
+
+#define WINQ_SPIA_VOID(secchio, espr) do {                                  \
+    uint64_t winq_t0_ = winq_glspia_accesa() ? winq_glspia_ora() : 0;       \
+    (espr);                                                                 \
+    if (winq_t0_) {                                                         \
+        uint64_t winq_t1_ = winq_glspia_ora();                              \
+        int winq_th_ = winq_glspia_thread_indice();                        \
+        if (winq_glspia_in_finestra()) {                                    \
+            winq_glspia_aggiungi(winq_th_, (secchio), winq_t0_, winq_t1_);  \
+        } else {                                                            \
+            winq_glspia_aggiungi_fuori(winq_th_, (secchio), winq_t0_, winq_t1_); \
+        }                                                                    \
+    }                                                                       \
+} while (0)
+
+/* --- disegno: il grosso del lavoro, e dove il driver valida lo stato ------ *
+ * Elenco ricavato dai siti di chiamata reali in src/vrend/vrend_renderer.c
+ * (il dispatch di vrend_draw_vbo attorno alla riga 6130) e src/vrend/vrend_blitter.c,
+ * vrend_formats.c, vrend_video.c. glDrawArraysInstanced e glDrawElementsInstanced
+ * NON compaiono: questo fork chiama sempre le varianti ARB/BaseInstance/BaseVertex,
+ * mai la forma "base" dell'API. */
