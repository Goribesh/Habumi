diff --git a/src/test-winq-glspia-conta.c b/src/test-winq-glspia-conta.c
new file mode 100644
index 0000000..27b4400
--- /dev/null
+++ b/src/test-winq-glspia-conta.c
@@ -0,0 +1,824 @@
+/* Prove dei contatori dello shim GL. Nessun GL, nessun contesto, nessuna VM:
+ * e' la ragione per cui la logica di accumulo sta in un file separato da
+ * winq-glspia.h, che invece e' solo macro.
+ *
+ * Compilare ed eseguire con research/scripts/test-glspia.sh. */
+#include <stdio.h>
+#include <string.h>
+#include "winq-glspia-conta.h"
+
+static int falliti;
+
+static void esigi(int condizione, const char *cosa)
+{
+    printf("  %-58s %s\n", cosa, condizione ? "ok" : "FALLITA");
+    if (!condizione) {
+        falliti++;
+    }
+}
+
+/* Con la frequenza forzata a 1 MHz un tick vale 1000 ns, cosi' i conti
+ * dell'aritmetica si leggono a occhio invece di dipendere dall'orologio
+ * della macchina -- che renderebbe la prova non deterministica. */
+static void prova_accumulo(void)
+{
+    struct winq_glspia s;
+
+    printf("accumulo:\n");
+    winq_glspia_freq_forza(1000000);
+    winq_glspia_azzera();
+
+    winq_glspia_aggiungi(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_GL, 100, 150);    /* 50 tick = 50 us */
+    winq_glspia_aggiungi(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_GL, 200, 210);    /* 10 tick = 10 us */
+    winq_glspia_aggiungi(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_SHADER, 0, 3000); /* 3 ms */
+
+    winq_glspia_leggi(&s);
+    esigi(s.ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GL] == 60000, "GL: 60 us in nanosecondi");
+    esigi(s.chiamate[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GL] == 2, "GL: due chiamate contate");
+    esigi(s.ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_SHADER] == 3000000, "SHADER: 3 ms in nanosecondi");
+    esigi(s.chiamate[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_SHADER] == 1, "SHADER: una chiamata contata");
+    esigi(s.ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_WAITSYNC] == 0, "WAITSYNC: intatta");
+}
+
+/* Un orologio che torna indietro esiste davvero: QueryPerformanceCounter puo'
+ * dare valori non monotoni fra core su alcune macchine. Un intervallo negativo
+ * sottratto come unsigned diventerebbe un numero enorme, e una sola occorrenza
+ * falserebbe l'intero secondo. Si scarta e si conta. */
+static void prova_intervallo_negativo(void)
+{
+    struct winq_glspia s;
+
+    printf("intervallo negativo:\n");
+    winq_glspia_freq_forza(1000000);
+    winq_glspia_azzera();
+
+    winq_glspia_aggiungi(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_GL, 500, 400);
+
+    winq_glspia_leggi(&s);
+    esigi(s.ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GL] == 0, "nessun tempo accumulato");
+    esigi(s.chiamate[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GL] == 0, "nessuna chiamata contata");
+    esigi(s.assurde == 1, "contata come assurda");
+}
+
+/* La lettura e' una FOTOGRAFIA che azzera: la riga al secondo di QEMU deve
+ * poter chiedere "quanto da quando ho chiesto l'ultima volta" senza tenere
+ * lei lo stato precedente. */
+static void prova_lettura_azzera(void)
+{
+    struct winq_glspia s;
+
+    printf("la lettura azzera:\n");
+    winq_glspia_freq_forza(1000000);
+    winq_glspia_azzera();
+
+    winq_glspia_aggiungi(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_WAITSYNC, 0, 1000);
+    winq_glspia_leggi(&s);
+    esigi(s.ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_WAITSYNC] == 1000000, "prima lettura: 1 ms");
+
+    winq_glspia_leggi(&s);
+    esigi(s.ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_WAITSYNC] == 0, "seconda lettura: azzerata");
+    esigi(s.chiamate[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_WAITSYNC] == 0, "seconda lettura: zero chiamate");
+}
+
+/* Il secchio fuori intervallo non deve scrivere fuori dall'array. Se questa
+ * prova sparisce, torna un buco di memoria in un percorso caldo. */
+static void prova_secchio_invalido(void)
+{
+    struct winq_glspia s;
+
+    printf("secchio invalido:\n");
+    winq_glspia_freq_forza(1000000);
+    winq_glspia_azzera();
+
+    winq_glspia_aggiungi(WINQ_THREAD_PRINCIPALE, -1, 0, 1000);
+    winq_glspia_aggiungi(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_N, 0, 1000);
+    winq_glspia_aggiungi(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_N + 99, 0, 1000);
+
+    winq_glspia_leggi(&s);
+    esigi(s.assurde == 3, "tre scarti contati, nessuna scrittura fuori");
+}
+
+/* QUARTA CORREZIONE DELL'11/08/2026: aggiungi() ora indicizza un array a due
+ * dimensioni (thread e secchio). Lo stesso rischio di prova_secchio_invalido(),
+ * sull'altro asse: un thread fuori bounds deve scartarsi come assurda, non
+ * scrivere fuori dall'array. */
+static void prova_thread_invalido(void)
+{
+    struct winq_glspia s;
+
+    printf("thread invalido:\n");
+    winq_glspia_freq_forza(1000000);
+    winq_glspia_azzera();
+
+    winq_glspia_aggiungi(-1, WINQ_SPIA_GL, 0, 1000);
+    winq_glspia_aggiungi(WINQ_THREAD_N, WINQ_SPIA_GL, 0, 1000);
+    winq_glspia_aggiungi(WINQ_THREAD_N + 99, WINQ_SPIA_GL, 0, 1000);
+
+    winq_glspia_leggi(&s);
+    esigi(s.assurde == 3, "tre scarti contati, nessuna scrittura fuori dall'array");
+}
+
+/* La taratura deve dare un numero, e un numero piccolo: se una coppia di
+ * letture dell'orologio costasse quanto una chiamata GL, lo strumento
+ * misurerebbe se stesso. La soglia e' larga apposta -- qui si esclude
+ * l'ordine di grandezza sbagliato, non si certifica una prestazione.
+ *
+ * QUARTA CORREZIONE DELL'11/08/2026: il numero ora include anche una lettura
+ * di winq_glspia_thread_id() per giro (vedi il commento sopra
+ * winq_glspia_taratura_ns()), perche' e' quello che il percorso caldo fa
+ * davvero da questa correzione in poi. La soglia non cambia: GetCurrentThreadId()
+ * e' una lettura del TEB, non sposta l'ordine di grandezza. */
+static void prova_taratura(void)
+{
+    uint64_t costo;
+
+    printf("taratura:\n");
+    winq_glspia_freq_vera();
+    costo = winq_glspia_taratura_ns();
+    printf("  costo di una tripletta di letture (ora+ora+thread_id): %llu ns\n",
+           (unsigned long long)costo);
+    esigi(costo > 0, "la taratura restituisce un valore");
+    esigi(costo < 10000, "sotto i 10 us per tripletta");
+}
+
+/* Misura isolata di winq_glspia_thread_id() da solo, separata dal numero
+ * combinato di taratura_ns(): il rapporto deve poter citare il costo della
+ * sola lettura del thread id, non solo il totale con le due letture
+ * dell'orologio incluse. Non e' una prova di correttezza (nessun esigi()
+ * sul valore stesso oltre alla soglia larga): e' la misura dichiarata nel
+ * compito. */
+static void prova_costo_thread_id(void)
+{
+    const uint64_t giri = 1000000;
+    uint64_t i, a, b, costo;
+    volatile uint64_t anti_ottimizzazione = 0;
+
+    printf("costo isolato di winq_glspia_thread_id():\n");
+    winq_glspia_freq_vera();
+
+    a = winq_glspia_ora();
+    for (i = 0; i < giri; i++) {
+        uint64_t t = winq_glspia_thread_id();
+
+        if (t == 0) {
+            anti_ottimizzazione++;
+        }
+    }
+    (void)anti_ottimizzazione;
+    b = winq_glspia_ora();
+
+    costo = winq_glspia_intervallo_ns(a, b) / giri;
+    printf("  costo di una lettura: %llu ns\n", (unsigned long long)costo);
+    esigi(costo < 10000, "sotto i 10 us per lettura");
+}
+
+/* Il buco che il brief non copre: prima che winq_glspia_accesa() o
+ * winq_glspia_freq_forza() vengano chiamate, freq_hz vale zero. Una divisione
+ * per freq_hz in quello stato manderebbe in crash il processo che ospita lo
+ * shim -- cioe' QEMU. Serve un processo separato per osservare freq_hz==0
+ * davvero, perche' tutte le prove sopra lo impostano; qui si verifica solo
+ * che con freq_hz a zero forzato esplicitamente la chiamata non trabocchi ne'
+ * faccia una divisione per zero, e che il campione sia contato come assurdo. */
+static void prova_frequenza_non_impostata(void)
+{
+    struct winq_glspia s;
+
+    printf("frequenza non impostata:\n");
+    winq_glspia_freq_forza(0);
+    winq_glspia_azzera();
+
+    winq_glspia_aggiungi(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_GL, 100, 200);
+
+    winq_glspia_leggi(&s);
+    esigi(s.ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GL] == 0, "nessun tempo accumulato senza frequenza");
+    esigi(s.chiamate[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GL] == 0, "nessuna chiamata contata");
+    esigi(s.assurde == 1, "contata come assurda invece di dividere per zero");
+}
+
+/* Stesso buco della prova precedente, ma sull'altra funzione che divide per
+ * freq_hz. winq_glspia_taratura_ns() pero' non ha un contatore "assurde" da
+ * incrementare: deve solo restituire 0 con garbo invece di dividere per
+ * zero, senza toccare spia. */
+static void prova_taratura_frequenza_non_impostata(void)
+{
+    struct winq_glspia s;
+    uint64_t costo;
+
+    printf("taratura con frequenza non impostata:\n");
+    winq_glspia_freq_forza(0);
+    winq_glspia_azzera();
+
+    costo = winq_glspia_taratura_ns();
+
+    esigi(costo == 0, "nessuna divisione per zero: restituisce 0");
+
+    winq_glspia_leggi(&s);
+    esigi(s.assurde == 0, "la taratura non conta il campione come assurdo");
+    esigi(s.ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GL] == 0, "nessun contatore ns toccato");
+    esigi(s.chiamate[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GL] == 0, "nessun contatore chiamate toccato");
+}
+
+/* winq_glspia_gpu_chiudi() passa il proprio argomento alla banda di
+ * plausibilita' di winq-glspia-gpu.c come tempo CPU vero, in nanosecondi, da
+ * confrontare con i nanosecondi veri della query GL. QueryPerformanceFrequency
+ * su Windows non e' mai 1 GHz (tipicamente 10 MHz: qemu/probe/sonda-gltimer.c
+ * lo converte esplicitamente con lo stesso schema). Se l'aggancio passasse i
+ * tick grezzi invece dei nanosecondi convertiti, la banda confronterebbe
+ * numeri di ordini di grandezza diversi e scarterebbe come "assurdi" quasi
+ * tutti i campioni validi -- silenziosamente, perche' "assurda" e' comunque
+ * un conteggio valido e nessuno lo leggerebbe come sintomo di un bug di unita'
+ * di misura. Questa prova blocca la regressione a quell'errore. */
+static void prova_intervallo_ns(void)
+{
+    printf("intervallo in nanosecondi:\n");
+    winq_glspia_freq_forza(1000000);   /* 1 MHz: un tick vale 1000 ns */
+
+    esigi(winq_glspia_intervallo_ns(100, 150) == 50000,
+          "50 tick a 1 MHz sono 50000 ns, non 50");
+    esigi(winq_glspia_intervallo_ns(500, 400) == 0,
+          "intervallo negativo: zero, non un numero enorme");
+}
+
+/* I nanosecondi della query non passano dalla conversione da tick: se un
+ * giorno qualcuno li facesse passare da aggiungi(), questa prova lo prende.
+ * Sempre nel secchio WINQ_THREAD_PRINCIPALE: somma_gpu() non prende un
+ * thread, vedi il commento sulla funzione. */
+static void prova_somma_gpu(void)
+{
+    struct winq_glspia s;
+
+    printf("somma GPU:\n");
+    winq_glspia_freq_forza(1000000);
+    winq_glspia_azzera();
+
+    winq_glspia_somma_gpu(1500000);
+    winq_glspia_somma_gpu(500000);
+
+    winq_glspia_leggi(&s);
+    esigi(s.ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GPU] == 2000000, "2 ms sommati come nanosecondi");
+    esigi(s.chiamate[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GPU] == 2, "due campioni contati");
+}
+
+/* L'interruttore di finestra: acceso da winq_glspia_finestra_apri(), spento
+ * da winq_glspia_finestra_chiudi(). Non e' parte della fotografia che
+ * winq_glspia_leggi() restituisce e winq_glspia_azzera() ripulisce: e' lo
+ * stato del tratto cronometrato in corso, non un accumulo al secondo -- per
+ * questo qui non si passa da azzera()/leggi(), si legge solo
+ * winq_glspia_in_finestra(). */
+static void prova_finestra_flag(void)
+{
+    printf("interruttore di finestra:\n");
+
+    winq_glspia_finestra_chiudi();
+    esigi(!winq_glspia_in_finestra(), "chiusa: la lettura dice chiusa");
+
+    winq_glspia_finestra_apri();
+    esigi(winq_glspia_in_finestra(), "aperta: la lettura dice aperta");
+
+    winq_glspia_finestra_chiudi();
+    esigi(!winq_glspia_in_finestra(), "richiusa: la lettura torna a dire chiusa");
+}
+
+/* CORREZIONE DEL 11/08/2026: sul campo la raccolta reale ha detto che "fuori"
+ * e' il 62% del secondo (623,9 ms/s contro 19,0 ms/s dentro), ma essendo un
+ * unico contenitore diceva solo quanto, non cosa. Ora e' parallelo ai secchi
+ * dentro-finestra (WINQ_SPIA_GL/SHADER/FLUSH/FINISH/WAITSYNC): winq_glspia_aggiungi_fuori()
+ * prende un thread e un secchio come aggiungi(), e scrive in
+ * fuori_ns[thread][secchio]/fuori_chiamate[thread][secchio]. WINQ_SPIA_GPU
+ * non ha mai un campione fuori: le query GL_TIME_ELAPSED si aprono solo
+ * dentro la finestra (winq-glspia-gpu.c), quindi quella riga dell'array
+ * resta sempre zero, e non e' un caso da testare qui perche' nessun
+ * chiamante puo' produrlo. Non e' nemmeno un campione scartato: assurde
+ * resta a zero. */
+static void prova_aggiungi_fuori(void)
+{
+    struct winq_glspia s;
+
+    printf("fuori dalla finestra:\n");
+    winq_glspia_freq_forza(1000000);
+    winq_glspia_azzera();
+
+    winq_glspia_aggiungi_fuori(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_GL, 100, 150);    /* 50 tick = 50 us */
+    winq_glspia_aggiungi_fuori(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_GL, 0, 3000);     /* 3000 tick = 3 ms */
+    winq_glspia_aggiungi_fuori(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_SHADER, 0, 500);  /* 500 tick = 0,5 ms */
+
+    winq_glspia_leggi(&s);
+    esigi(s.fuori_ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GL] == 3050000, "GL fuori: 3,05 ms in nanosecondi");
+    esigi(s.fuori_chiamate[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GL] == 2, "GL fuori: due chiamate contate");
+    esigi(s.fuori_ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_SHADER] == 500000, "SHADER fuori: 0,5 ms in nanosecondi");
+    esigi(s.fuori_chiamate[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_SHADER] == 1, "SHADER fuori: una chiamata contata");
+    esigi(s.fuori_ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_WAITSYNC] == 0, "WAITSYNC fuori: intatto, nessuna chiamata");
+    esigi(s.ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GL] == 0, "GL dentro-finestra: intatto, fuori e' parallelo");
+    esigi(s.assurde == 0, "fuori non e' un errore: nessuna assurda");
+}
+
+/* Stessa guardia di aggiungi() sull'orologio che torna indietro, ma qui un
+ * campione scartato non e' un errore da contare in assurde: e' lavoro fuori
+ * dalla finestra, e si ignora in silenzio senza toccare nessun contatore. */
+static void prova_aggiungi_fuori_orologio_indietro(void)
+{
+    struct winq_glspia s;
+
+    printf("fuori dalla finestra, orologio indietro:\n");
+    winq_glspia_freq_forza(1000000);
+    winq_glspia_azzera();
+
+    winq_glspia_aggiungi_fuori(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_GL, 500, 400);
+
+    winq_glspia_leggi(&s);
+    esigi(s.fuori_ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GL] == 0, "nessun tempo accumulato");
+    esigi(s.fuori_chiamate[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GL] == 0, "nessuna chiamata contata");
+    esigi(s.assurde == 0, "non e' un errore, quindi nessuna assurda");
+}
+
+/* Stesso buco di prova_frequenza_non_impostata(), sull'altra funzione che
+ * divide per freq_hz. */
+static void prova_aggiungi_fuori_frequenza_non_impostata(void)
+{
+    struct winq_glspia s;
+
+    printf("fuori dalla finestra, frequenza non impostata:\n");
+    winq_glspia_freq_forza(0);
+    winq_glspia_azzera();
+
+    winq_glspia_aggiungi_fuori(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_GL, 100, 200);
+
+    winq_glspia_leggi(&s);
+    esigi(s.fuori_ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GL] == 0, "nessun tempo accumulato senza frequenza");
+    esigi(s.fuori_chiamate[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GL] == 0, "nessuna chiamata contata");
+    esigi(s.assurde == 0, "non e' un errore, quindi nessuna assurda");
+}
+
+/* Il secchio fuori intervallo non deve scrivere fuori dall'array
+ * fuori_ns[]/fuori_chiamate[]: stesso rischio di prova_secchio_invalido(),
+ * ora raddoppiato perche' i campi sono array e non piu' scalari. Qui un
+ * secchio invalido E' un errore di chi chiama (indice fuori bounds), non
+ * lavoro fuori perimetro: si conta come assurda, come in aggiungi(). */
+static void prova_aggiungi_fuori_secchio_invalido(void)
+{
+    struct winq_glspia s;
+
+    printf("fuori dalla finestra, secchio invalido:\n");
+    winq_glspia_freq_forza(1000000);
+    winq_glspia_azzera();
+
+    winq_glspia_aggiungi_fuori(WINQ_THREAD_PRINCIPALE, -1, 0, 1000);
+    winq_glspia_aggiungi_fuori(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_N, 0, 1000);
+    winq_glspia_aggiungi_fuori(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_N + 99, 0, 1000);
+
+    winq_glspia_leggi(&s);
+    esigi(s.assurde == 3, "tre scarti contati, nessuna scrittura fuori dall'array");
+}
+
+/* Come prova_thread_invalido(), ma per aggiungi_fuori(): l'array e' a due
+ * dimensioni anche qui. */
