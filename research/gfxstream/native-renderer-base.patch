+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glBlitFramebuffer(__VA_ARGS__))
+
+/* --- clear: azzerare un target e' lavoro reale, non solo stato ----------- *
+ * glClear stava fra le esclusioni con la motivazione "non e' ne' dispatch
+ * ne' trasferimento dati": vera, ma e' una motivazione di categoria, non di
+ * evidenza, e non risponde alla domanda che conta. glClear vive in
+ * vrend_clear (riga 4828, il gestore del comando guest CLEAR) e glClear
+ * ricompare in vrend_clear_surface (riga 4929, comando CLEAR_SURFACE): due
+ * gestori di comando di primo livello, non dettagli interni, chiamati a ogni
+ * clear di un render target -- una o piu' volte a frame come glDraw* e
+ * glDispatchCompute*, che sono gia' incluse. E' comunque una chiamata GL con
+ * validazione di stato lato driver, sullo stesso piano CPU delle altre:
+ * la ragione vera per includerla, non la categoria "clear" in se'.
+ *
+ * Incluse le sorelle dirette nello stesso sito: glClearBufferuiv/iv/fv
+ * (vrend_clear, righe 4871/4875/4877) sono i rami alternativi dello stesso
+ * if quando i colorbuffer hanno formati diversi da quello atteso da
+ * glClear(bits). glClearTexSubImage (vrend_clear_texture, riga 4921) e la
+ * sua variante GLES glClearTexSubImageEXT (riga 4916) scrivono dati veri in
+ * una regione di texture: stessa natura di glTexSubImage*, gia' incluse.
+ *
+ * NON incluse: glClearColor/glClearDepth/glClearStencil (vrend_clear_prepare,
+ * righe 4737-4774) impostano il VALORE da usare al prossimo clear, non
+ * eseguono il clear -- puntatori di stato come i bind, non lavoro. */
+#undef glClear
+#define glClear(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glClear(__VA_ARGS__))
+#undef glClearBufferuiv
+#define glClearBufferuiv(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glClearBufferuiv(__VA_ARGS__))
+#undef glClearBufferiv
+#define glClearBufferiv(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glClearBufferiv(__VA_ARGS__))
+#undef glClearBufferfv
+#define glClearBufferfv(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glClearBufferfv(__VA_ARGS__))
+#undef glClearTexSubImage
+#define glClearTexSubImage(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glClearTexSubImage(__VA_ARGS__))
+#undef glClearTexSubImageEXT
+#define glClearTexSubImageEXT(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_GL, epoxy_glClearTexSubImageEXT(__VA_ARGS__))
+
+/* --- sincronizzazione: ATTESA, non lavoro --------------------------------
+ * TERZA CORREZIONE DELL'11/08/2026: ATTESA sommava tre primitive con tre
+ * cause diverse -- glFlush manda in coda senza aspettare (presentazione),
+ * glFinish blocca finche' la GPU non ha smaltito tutto (GPU), glClientWaitSync
+ * blocca su una fence esplicita (fence) -- e lo split di "fuori" aveva appena
+ * mostrato che il grosso del tempo sta proprio qui dentro, senza dire quale
+ * dei tre. Ora tre secchi distinti, non uno: vedi l'enum in
+ * winq-glspia-conta.h. */
+#undef glFlush
+#define glFlush(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_FLUSH, epoxy_glFlush(__VA_ARGS__))
+#undef glFinish
+#define glFinish(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_FINISH, epoxy_glFinish(__VA_ARGS__))
+#undef glClientWaitSync
+#define glClientWaitSync(...) \
+    WINQ_SPIA_VAL(WINQ_SPIA_WAITSYNC, epoxy_glClientWaitSync(__VA_ARGS__))
+
+/* --- lettura all'indietro: FINISH, per approssimazione dichiarata -------- *
+ * glReadPixels e glGetTexImage sono sincrone: un readback e' insieme una
+ * copia (lavoro) e un blocco finche' la coda GPU non arriva a quel punto
+ * (attesa), e i secchi non hanno una casella per "tutti e due". Le mettiamo
+ * intere in attesa, non in GL, perche' delle due componenti l'attesa domina
+ * largamente: la copia costa microsecondi, il blocco costa quanto ci mette
+ * la GPU a smaltire la coda davanti. L'alternativa vera qui non e' "attesa
+ * oppure GL": e' "attesa oppure NIENTE", perche' senza questo wrapper le due
+ * chiamate cadrebbero in t_virgl per sottrazione, attribuendo tempo di
+ * blocco alla traduzione di virglrenderer -- la distorsione peggiore delle
+ * due, e proprio quella per cui esistono questi giri di correzione.
+ *
+ * TERZA CORREZIONE DELL'11/08/2026: con ATTESA sparita dall'enum, queste due
+ * vanno in uno dei tre secchi nuovi. FINISH, non FLUSH ne' WAITSYNC: un
+ * readback sincrono blocca la CPU finche' la GPU non ha smaltito la coda
+ * fino a quel punto -- la stessa semantica di "aspetta che la GPU finisca"
+ * di glFinish, non il "manda e non aspettare" di glFlush ne' l'attesa su una
+ * fence esplicita di glClientWaitSync. E' la scelta piu' vicina fra tre
+ * caselle nate per altro, non una quarta primitiva reale: chi legge i numeri
+ * deve sapere che, per queste due funzioni soltanto, il secchio FINISH
+ * include anche del lavoro di copia. Un quinto secchio "lettura all'indietro"
+ * sarebbe piu' preciso, ma cambierebbe di nuovo l'aritmetica e il formato
+ * della riga di riepilogo, quindi non si introduce qui. */
+#undef glReadPixels
+#define glReadPixels(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_FINISH, epoxy_glReadPixels(__VA_ARGS__))
+#undef glGetTexImage
+#define glGetTexImage(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_FINISH, epoxy_glGetTexImage(__VA_ARGS__))
+
+/* --- shader: DXIL + PSO, costo di prima volta ---------------------------- */
+#undef glCompileShader
+#define glCompileShader(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_SHADER, epoxy_glCompileShader(__VA_ARGS__))
+#undef glLinkProgram
+#define glLinkProgram(...) \
+    WINQ_SPIA_VOID(WINQ_SPIA_SHADER, epoxy_glLinkProgram(__VA_ARGS__))
+
+/* --- esclusioni motivate ---------------------------------------------------
+ * Chiamate davvero presenti in src/vrend/ e scartate di proposito, non per
+ * dimenticanza. Ogni esclusione qui sotto cita il sito di chiamata che la
+ * giustifica, non solo una categoria o una frequenza presunta -- due
+ * esclusioni di un giro precedente si reggevano su "una tantum" che il
+ * grafo delle chiamate smentiva (vedi la sezione framebuffer sopra), quindi
+ * questo elenco e' stato riverificato riga per riga. Se una di queste va
+ * rivista, cambiare qui il ragionamento, non solo l'elenco sopra.
+ *
+ * Creazione di buffer (allocano storage, non spostano dati): glBufferStorage,
+ * glBufferStorageMemEXT. Verificato: unico chiamante e' vrend_create_buffer
+ * (riga 8324), a sua volta chiamata solo da vrend_resource_alloc_buffer
+ * (riga 8394), a sua volta chiamata solo dal dispatch di resource-create
+ * (riga 8926, dentro la funzione invocata da vrend_renderer_pipe_resource_create
+ * / vrend_decode.c:1598, un gestore di comando guest RESOURCE_CREATE). Un solo
+ * chiamante, un solo comando: davvero una tantum per risorsa.
+ *
+ * Creazione di texture: glTexImage1D/3D, glTexImage2DMultisample/3DMultisample,
+ * glTexStorage1D/2D/3D, glTexStorage2DMultisample/3DMultisample,
+ * glTexStorageMem2DEXT. Vivono in vrend_resource_alloc_texture (riga 8694).
+ * Qui la frequenza NON e' pulita come per i buffer: il chiamante principale
+ * (riga 8929, dispatch di resource-create, stesso comando guest di sopra) e'
+ * una tantum per risorsa, ma esiste un'eccezione stretta in
+ * vrend_renderer_blit_fbo (riga 11084): quando GLES + blit con maschera
+ * depth/stencil + campionamento multisample diverso fra sorgente e
+ * destinazione + rettangoli non coincidenti, alloca una texture "intermediate_copy"
+ * a ogni blit che soddisfa quella condizione, non alla creazione della
+ * risorsa. E' un fallback di workaround (vedi il commento alle righe
+ * 11045-11054), non il percorso comune del disegno: restano escluse, ma la
+ * riga precedente che diceva "chiamate una volta per risorsa, non ad ogni
+ * frame" senza qualificarla era essa stessa il tipo di affermazione che
+ * questo giro doveva controllare. Se quel percorso GLES risultasse piu'
+ * caldo del previsto, va misurato separatamente, non infilato qui dentro.
+ * (glTexImage2D e' gia' nell'elenco incluso sopra pur passando anch'essa da
+ * questa stessa funzione: e' dell'elenco originale, non toccata da questo
+ * giro di correzioni.)
+ *
+ * glGetTexImage e glReadPixels NON sono escluse: sono in ATTESA, vedi il
+ * commento sopra a quelle due macro per il ragionamento (approssimazione
+ * dichiarata, decisa esplicitamente e non scelta qui in silenzio).
+ *
+ * glCopyTexSubImage2D (solo in vrend_video.c): quel file si compila solo con
+ * `meson -Dvideo=true` (src/meson.build: `if with_video`), e questa build ha
+ * video disattivato (virgl-build.json: "videoEnabled": false) -- oggi non
+ * fa nemmeno parte del binario. Non e' una frequenza, e' un flag di build:
+ * verificabile con certezza, non un'ipotesi. Da rivedere se e quando video
+ * viene acceso.
+ *
+ * glClear e glClearTexSubImage NON sono escluse: sono in WINQ_SPIA_GL, vedi
+ * il commento sopra a quel gruppo di macro.
+ *
+ * glMemoryBarrier (vrend_memory_barrier, riga 3982) e la sorella
+ * glTextureBarrier (vrend_texture_barrier, riga 3989, notata durante questa
+ * verifica) sono gestori di comando guest a se' stanti, quindi non rare: il
+ * pattern dispatch-compute-poi-barriera le rende potenzialmente frequenti
+ * quanto glDispatchCompute, che e' inclusa. Restano fuori non per rarita' ma
+ * per natura: la spec GL dice esplicitamente che glMemoryBarrier "does not
+ * block execution" -- e' l'inserimento di un ordine nel flusso di comandi,
+ * non una validazione di stato ne' uno spostamento di dati ne' un blocco
+ * della CPU. Diverso da glCheckFramebufferStatus (inclusa sopra), che valida
+ * davvero lo stato del framebuffer.
+ */
+
+#endif /* WINQ_GLSPIA_H */
