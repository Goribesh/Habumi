@@ -0,0 +1,422 @@
+/* winq-glspia-conta.c -- accumulo, orologio, taratura.
+ *
+ * Sul percorso caldo qui dentro succedono due somme e un confronto. Niente
+ * allocazioni, niente formattazione, niente lock: lo strumento deve costare
+ * meno di cio' che misura, e il cancello §7c della spec lo verifica.
+ *
+ * NIENTE GL IN QUESTO FILE. Vedi il commento in cima a winq-glspia-conta.h.
+ */
+#include "winq-glspia-conta.h"
+
+#include <stdlib.h>
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#endif
+
+static struct winq_glspia spia;
+static uint64_t freq_hz;
+static int acceso = -1;
+
+/* Non e' parte di 'spia': non e' un accumulo al secondo che winq_glspia_leggi()
+ * fotografa e winq_glspia_azzera() ripulisce, e' lo stato del tratto
+ * cronometrato in corso -- vive quanto una submit, non quanto un secondo. */
+static int in_finestra;
+
+/* Come in_finestra: non e' un accumulo che azzera() ripulisce, e' la
+ * richiesta "sondare la prossima query aperta" che vive fra due letture.
+ * Parte armata (1) cosi' che il primo ciclo di riepilogo, non solo il
+ * secondo, contenga gia' un campione. */
+static int sonda_armata = 1;
+
+/* Solo per le prove (winq_glspia_thread_forza()): 0 vuol dire "usa il vero
+ * GetCurrentThreadId()", esattamente come freq_hz==0 vuol dire "non ancora
+ * tarata" -- 0 non e' mai un id di thread vero su Windows. */
+static uint64_t thread_forzato;
+
+int winq_glspia_accesa(void)
+{
+    if (acceso < 0) {
+        const char *v = getenv("WINQ_GPU_DIAG");
+
+        acceso = (v && *v == '1') ? 1 : 0;
+        if (acceso) {
+            winq_glspia_freq_vera();
+        }
+    }
+    return acceso;
+}
+
+void winq_glspia_freq_vera(void)
+{
+#ifdef _WIN32
+    LARGE_INTEGER f;
+
+    QueryPerformanceFrequency(&f);
+    freq_hz = (uint64_t)f.QuadPart;
+#else
+    freq_hz = 1000000000ull;
+#endif
+}
+
+void winq_glspia_freq_forza(uint64_t hz)
+{
+    freq_hz = hz;
+}
+
+uint64_t winq_glspia_ora(void)
+{
+#ifdef _WIN32
+    LARGE_INTEGER t;
+
+    QueryPerformanceCounter(&t);
+    return (uint64_t)t.QuadPart;
+#else
+    return 0;
+#endif
+}
+
+/* Converte un intervallo in tick di QueryPerformanceCounter in nanosecondi.
+ *
+ * Divide-prima-poi-resto: moltiplicare subito per un miliardo trabocca a 18
+ * secondi di tick su un orologio a 1 GHz. Il resto e' cio' che rende utile
+ * la misura, perche' i singoli intervalli sono microsecondi e la divisione
+ * secca li azzererebbe tutti.
+ *
+ * Se freq_hz e' ancora zero (nessuno ha chiamato winq_glspia_accesa() o
+ * winq_glspia_freq_forza()) restituisce 0 invece di dividere per zero: qui
+ * dentro non si decide se uno zero cosi' e' un campione da scartare o una
+ * taratura innocua, quella distinzione resta ai chiamanti. */
+static uint64_t winq_tick_a_ns(uint64_t tick)
+{
+    if (freq_hz == 0) {
+        return 0;
+    }
+    return (tick / freq_hz) * 1000000000ull +
+           (tick % freq_hz) * 1000000000ull / freq_hz;
+}
+
+uint64_t winq_glspia_thread_id(void)
+{
+    if (thread_forzato) {
+        return thread_forzato;
+    }
+#ifdef _WIN32
+    return (uint64_t)GetCurrentThreadId();
+#else
+    return 0;
+#endif
+}
+
+void winq_glspia_thread_forza(uint64_t tid)
+{
+    thread_forzato = tid;
+}
+
+void winq_glspia_thread_vero(void)
+{
+    thread_forzato = 0;
+}
+
+void winq_glspia_thread_azzera_registro(void)
+{
+    int i;
+
+    spia.thread_principale = 0;
+    spia.thread_altri_n = 0;
+    for (i = 0; i < WINQ_THREAD_TABELLA; i++) {
+        spia.thread_altri_id[i] = 0;
+    }
+    spia.thread_altri_fuori_tabella = 0;
+}
+
+/* Effetto collaterale se il thread corrente non e' il principale: lo
+ * registra nel piccolo insieme thread_altri_id[] se non e' gia' li' --
+ * scansione lineare di al piu' WINQ_THREAD_TABELLA elementi, il chiamante
+ * (winq-glspia.h) la fa una volta per chiamata GL avvolta, non di piu'. Se
+ * il thread e' nuovo e la tabella e' piena, non lo sappiamo distinguere da
+ * un thread gia' visto che non entrava: si conta la chiamata in
+ * thread_altri_fuori_tabella, non un'identita' -- stessa rinuncia di
+ * trova_o_crea() in winq-glspia-gpu.c quando WINQ_CONTESTI e' pieno. */
+int winq_glspia_thread_indice(void)
+{
+    uint64_t tid = winq_glspia_thread_id();
+    int n = (int)spia.thread_altri_n;
+    int i;
+
+    if (tid == spia.thread_principale) {
+        return WINQ_THREAD_PRINCIPALE;
+    }
+    for (i = 0; i < n; i++) {
+        if (spia.thread_altri_id[i] == tid) {
+            return WINQ_THREAD_ALTRI;
+        }
+    }
+    if (n < WINQ_THREAD_TABELLA) {
+        spia.thread_altri_id[n] = tid;
+        spia.thread_altri_n = (uint64_t)(n + 1);
+    } else {
+        spia.thread_altri_fuori_tabella++;
+    }
+    return WINQ_THREAD_ALTRI;
+}
+
+void winq_glspia_aggiungi(int thread, int secchio, uint64_t t0, uint64_t t1)
+{
+    uint64_t tick;
+
+    if (thread < 0 || thread >= WINQ_THREAD_N || secchio < 0 || secchio >= WINQ_SPIA_N) {
+        spia.assurde++;
+        return;
+    }
+    /* L'orologio puo' tornare indietro fra core su alcune macchine. Sottratto
+     * come unsigned, un intervallo negativo diventerebbe un numero enorme e
+     * un solo campione falserebbe l'intero secondo. */
+    if (t1 < t0) {
+        spia.assurde++;
+        return;
+    }
+    /* freq_hz e' zero finche' nessuno ha ancora chiamato winq_glspia_accesa()
+     * o winq_glspia_freq_forza(): succede se una chiamata GL arriva prima che
+     * lo shim si sia inizializzato. winq_tick_a_ns() da sola restituirebbe un
+     * innocuo zero, ma qui il campione va anche contato come assurdo e non
+     * come "zero secondi di lavoro GL": senza questo controllo esplicito la
+     * chiamata verrebbe conteggiata in spia.chiamate come se fosse valida. */
+    if (freq_hz == 0) {
+        spia.assurde++;
+        return;
+    }
+    tick = t1 - t0;
+
+    spia.ns[thread][secchio] += winq_tick_a_ns(tick);
+    spia.chiamate[thread][secchio]++;
+}
+
+uint64_t winq_glspia_intervallo_ns(uint64_t t0, uint64_t t1)
+{
+    /* Stessa guardia di aggiungi(): un orologio che torna indietro non deve
+     * diventare, sottratto come unsigned, un numero enorme. */
+    if (t1 < t0) {
+        return 0;
+    }
+    return winq_tick_a_ns(t1 - t0);
+}
+
+void winq_glspia_finestra_apri(void)
+{
+    /* Alla PRIMA chiamata, e solo alla prima: e' per definizione il thread
+     * che decodifica (vrend_decode_ctx_submit_cmd chiama solo questa
+     * funzione, mai da un altro thread -- vedi il commento sopra l'enum
+     * WINQ_THREAD_* in winq-glspia-conta.h). Chiamate successive non lo
+     * riscrivono: se lo facessero, un secondo thread che per qualche motivo
+     * chiamasse questa funzione soppianterebbe il principale vero. */
+    if (!spia.thread_principale) {
+        spia.thread_principale = winq_glspia_thread_id();
+    }
+    in_finestra = 1;
+}
+
+void winq_glspia_finestra_chiudi(void)
+{
+    in_finestra = 0;
+}
+
+int winq_glspia_in_finestra(void)
+{
+    return in_finestra;
+}
+
+/* Come aggiungi(), ma scrive in fuori_ns[secchio]/fuori_chiamate[secchio]
+ * invece di ns[secchio]/chiamate[secchio]: e' lavoro che virglrenderer fa
+ * fuori dalla finestra cronometrata, non dentro. Il secchio fuori bounds e'
+ * un errore di chi chiama (scriverebbe fuori dall'array senza questa
+ * guardia) e si conta come assurda, come in aggiungi(); l'orologio che torna
+ * indietro e la frequenza non tarata restano invece guardie silenziose: un
+ * campione scartato per quelle non e' un errore di misura, e' solo lavoro
+ * fuori perimetro che si perde senza toccare spia.assurde -- esattamente come
+ * dice il commento sopra la dichiarazione in winq-glspia-conta.h. */
+void winq_glspia_aggiungi_fuori(int thread, int secchio, uint64_t t0, uint64_t t1)
+{
+    uint64_t tick;
+
+    if (thread < 0 || thread >= WINQ_THREAD_N || secchio < 0 || secchio >= WINQ_SPIA_N) {
+        spia.assurde++;
+        return;
+    }
+    if (t1 < t0) {
+        return;
+    }
+    if (freq_hz == 0) {
+        return;
+    }
+    tick = t1 - t0;
+
+    spia.fuori_ns[thread][secchio] += winq_tick_a_ns(tick);
+    spia.fuori_chiamate[thread][secchio]++;
+}
+
+void winq_glspia_conta_saltata(void)
+{
+    spia.saltate++;
+}
+
+void winq_glspia_conta_assurda(void)
+{
+    spia.assurde++;
+}
+
+void winq_glspia_somma_gpu(uint64_t ns)
+{
+    /* Sempre WINQ_THREAD_PRINCIPALE, senza bisogno di chiedere: le query
+     * GL_TIME_ELAPSED si aprono solo dentro la finestra (winq-glspia-gpu.c),
+     * e la finestra la apre solo il thread che decodifica -- nessuna
+     * ambiguita' di thread da risolvere qui, a differenza di ns[]/chiamate[]
+     * degli altri secchi. */
+    spia.ns[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GPU] += ns;
+    spia.chiamate[WINQ_THREAD_PRINCIPALE][WINQ_SPIA_GPU]++;
+}
+
+/* ns e' gia' il tempo CPU della finestra, convertito da winq_glspia_intervallo_ns()
+ * sugli stessi t0/t1 che l'aggancio passa a winq_glspia_gpu_chiudi(): si
+ * somma senza passare da aggiungi(), che si aspetta tick grezzi e non ns
+ * gia' convertiti -- stessa ragione per cui somma_gpu() non usa aggiungi(). */
+void winq_glspia_somma_finestra(uint64_t ns)
+{
+    spia.finestra_ns += ns;
+}
+
+int winq_glspia_sonda_richiesta(void)
+{
+    return sonda_armata;
+}
+
+/* Non disarma: fine() lo fa, dopo che ANCHE il secondo glGetError() e' stato
+ * letto. Se disarmasse qui, un chiamante che leggesse la richiesta una
+ * seconda volta fra begin e end (invece di ricordare la risposta come dice
+ * il commento in winq-glspia-conta.h) la vedrebbe gia' falsa e salterebbe la
+ * sonda di fine -- ma il contratto e' "leggi una volta, ricorda", quindi qui
+ * non e' la guardia contro quel caso: e' solo che il disarmo logicamente
+ * appartiene alla fine del ciclo begin/end, non al suo inizio. */
+void winq_glspia_sonda_registra_inizio(uint64_t errore)
+{
+    spia.sonda_eseguita = 1;
+    spia.sonda_errore_inizio = errore;
+}
+
+void winq_glspia_sonda_registra_fine(uint64_t errore)
+{
+    spia.sonda_errore_fine = errore;
+    sonda_armata = 0;
+}
+
+/* Un'origine fuori bounds e' un errore di chi chiama (indice invalido),
+ * esattamente come un secchio o un thread fuori bounds in aggiungi(): si
+ * conta come assurda, non come richiesta. Il chiamante (vrend_hw_switch_context())
+ * e' gia' dietro winq_glspia_accesa(), quindi qui non c'e' bisogno di
+ * un'altra guardia sulla diagnostica. */
+void winq_glspia_ctx_richiesto(int origine)
+{
+    if (origine < 0 || origine >= WINQ_CTX_N) {
+        spia.assurde++;
+        return;
+    }
+    spia.ctx_richiesti[origine]++;
+}
+
+void winq_glspia_ctx_vero(int origine, uint64_t ns)
+{
+    if (origine < 0 || origine >= WINQ_CTX_N) {
+        spia.assurde++;
+        return;
+    }
+    spia.ctx_veri[origine]++;
+    spia.ctx_ns[origine] += ns;
+}
+
+void winq_glspia_azzera(void)
+{
+    int t, i;
+
+    for (t = 0; t < WINQ_THREAD_N; t++) {
+        for (i = 0; i < WINQ_SPIA_N; i++) {
+            spia.ns[t][i] = 0;
+            spia.chiamate[t][i] = 0;
+            spia.fuori_ns[t][i] = 0;
+            spia.fuori_chiamate[t][i] = 0;
+        }
+    }
+    spia.saltate = 0;
+    spia.assurde = 0;
+    spia.finestra_ns = 0;
+    spia.sonda_eseguita = 0;
+    spia.sonda_errore_inizio = 0;
+    spia.sonda_errore_fine = 0;
+    /* thread_principale/thread_altri_* NON si azzerano: vedi il commento
+     * sulla struct in winq-glspia-conta.h. Sono un registro per la vita del
+     * processo, non un accumulo al secondo. */
+    for (i = 0; i < WINQ_CTX_N; i++) {
+        spia.ctx_richiesti[i] = 0;
+        spia.ctx_veri[i] = 0;
+        spia.ctx_ns[i] = 0;
+    }
+}
+
+void winq_glspia_leggi(struct winq_glspia *fuori)
+{
+    *fuori = spia;
+    winq_glspia_azzera();
+    /* Riarma per il ciclo che comincia ora: senza questo, dopo il primo
+     * campione la sonda si disarmerebbe per sempre (fine() la disarma, e
+     * nessuno la rialzerebbe piu'). */
+    sonda_armata = 1;
+}
+
+/* Un milione di iterazioni a vuoto, senza niente in mezzo: e' il costo che lo
+ * strumento aggiunge a ogni chiamata GL avvolta. Va confrontato con t_virgl
+ * (spec §7c): se e' dello stesso ordine, la misura non regge e la lista
+ * delle funzioni avvolte va accorciata.
+ *
+ * QUARTA CORREZIONE DELL'11/08/2026: il ciclo ora legge anche
+ * winq_glspia_thread_id() insieme alle due letture dell'orologio, perche' da
+ * questa correzione in poi e' quello che il percorso caldo fa davvero a ogni
+ * chiamata avvolta (via winq_glspia_thread_indice(), che pero' NON e' quello
+ * che si chiama qui: quella ha l'effetto collaterale di registrare il thread
+ * nel registro, e chiamarla un milione di volte da un thread "forzato" o
+ * vero riempirebbe o sporcherebbe il registro. thread_id() e' la primitiva
+ * pura sotto, senza effetti collaterali, e misura lo stesso costo perche' e'
+ * la stessa chiamata a GetCurrentThreadId() -- solo il confronto e la
+ * scansione della tabella, che thread_indice() fa in piu', non sono qui:
+ * quel costo e' un confronto e una scansione di al piu' 8 elementi, ordini
+ * di grandezza sotto una lettura del TEB). */
+uint64_t winq_glspia_taratura_ns(void)
+{
+    const uint64_t giri = 1000000;
+    uint64_t i, a, b, tick;
+    /* Accumulatore locale per impedire al compilatore di buttare via le
+     * letture del ciclo: volatile forza una scrittura in memoria a ogni
+     * iterazione, quindi le chiamate a winq_glspia_ora()/thread_id() non
+     * sono eliminabili come codice morto. Locale e non spia.assurde: la
+     * taratura e' una misura, non un evento da contare nelle statistiche di
+     * produzione che QEMU legge. */
+    volatile uint64_t anti_ottimizzazione = 0;
+
+    a = winq_glspia_ora();
+    for (i = 0; i < giri; i++) {
+        uint64_t x = winq_glspia_ora();
+        uint64_t y = winq_glspia_ora();
+        uint64_t t = winq_glspia_thread_id();
+
+        if (y < x || t == 0) {
+            anti_ottimizzazione++;
+        }
+    }
+    (void)anti_ottimizzazione;
+    b = winq_glspia_ora();
+    tick = b - a;
+
+    /* freq_hz a zero qui non e' un campione assurdo da contare: e' solo una
+     * taratura chiamata troppo presto. winq_tick_a_ns() restituisce 0 in quel
+     * caso, senza toccare spia. */
+    return winq_tick_a_ns(tick) / giri;
+}
diff --git a/src/winq-glspia-conta.h b/src/winq-glspia-conta.h
new file mode 100644
index 0000000..52e2609
--- /dev/null
+++ b/src/winq-glspia-conta.h
@@ -0,0 +1,330 @@
+/* winq-glspia-conta.h -- i contatori dello shim GL.
+ *
+ * Nessun GL qui dentro, e nemmeno in winq-glspia-conta.c: e' cio' che rende
+ * questa parte provabile senza contesto grafico (research/scripts/test-glspia.sh).
+ * Le macro che avvolgono le entry point stanno in winq-glspia.h, che invece
+ * include epoxy.
+ *
+ * Spec: docs/superpowers/specs/2026-08-11-attribuzione-tempo-gpu-design.md
+ */
+#ifndef WINQ_GLSPIA_CONTA_H
+#define WINQ_GLSPIA_CONTA_H
+
+#include <stdint.h>
+
+/* WINQ_SPIA_ESPORTA -- NON rimetterci __declspec(dllexport) su _WIN32, e non
+ * lasciarla vuota: la causa vera e' piu' a fondo di "dllexport spegne
+ * l'auto-export", ed entrambi gli errori la mancano.
+ *
+ * Questo albero compila con -fvisibility=hidden (research/winq-virgl/meson.build:74),
+ * globale, tutte le piattaforme. Sotto -fvisibility=hidden ogni simbolo e'
+ * nascosto per default: su MinGW/Clang questo si traduce, per ciascun
+ * simbolo senza visibilita' esplicita, in una direttiva
+ * "-exclude-symbols:<nome>" scritta nella sezione .drectve dell'oggetto --
+ * verificato con objdump -s -j .drectve sull'oggetto compilato. Quella
+ * direttiva dice al linker "non esportare questo, MAI", indipendentemente
+ * da dllexport o dall'auto-export di ld/lld: e' per questo che togliere
+ * dllexport da solo NON basta, e winq_glspia_leggi resta escluso comunque
+ * (verificato: la DLL ricompilata senza dllexport aveva ancora zero
+ * occorrenze di winq_glspia_leggi nella sua Export Table).
+ *
+ * Le 49 virgl_renderer_* arrivano a QEMU non per l'auto-export di ld/lld ma
+ * perche' sono marcate VIRGL_EXPORT (virglrenderer.h), che e'
+ * __attribute__((visibility("default"))) su ogni piattaforma: quell'oggetto
+ * (virglrenderer.c.obj) non ha nessuna sezione .drectve, perche' Clang non
+ * genera "-exclude-symbols" per un simbolo che ha visibilita' esplicita.
+ * WINQ_SPIA_ESPORTA deve fare la STESSA cosa, con lo stesso meccanismo, non
+ * un secondo meccanismo (dllexport) che in piu' spegneva l'auto-export per
+ * tutti gli altri quando c'era. */
+#define WINQ_SPIA_ESPORTA __attribute__((visibility("default")))
+
+/* TERZA CORREZIONE DELL'11/08/2026: lo split di "fuori" ha detto che dentro
+ * quel 62% del secondo, fuori/gl e fuori/shader sono zero e fuori/attesa e'
+ * 645,3 ms/s da solo. ATTESA sommava glFlush, glFinish e glClientWaitSync:
+ * tre primitive con tre cause diverse (presentazione, GPU, fence), un solo
+ * numero. Non serve un secchio nuovo con macchineria nuova: si allunga
+ * l'enum, e ns[]/chiamate[]/fuori_ns[]/fuori_chiamate[] (tutti dimensionati
+ * su WINQ_SPIA_N) portano la scomposizione da soli. ATTESA come nome sparisce
+ * dall'enum; nella sottrazione e nelle righe di riepilogo torna come somma di
+ * FLUSH+FINISH+WAITSYNC (vedi hw/display/virtio-gpu-virgl.c). */
+enum {
+    WINQ_SPIA_GL = 0,      /* disegno, buffer, texture: lavoro del driver */
+    WINQ_SPIA_SHADER,      /* glCompileShader, glLinkProgram: DXIL + PSO */
+    WINQ_SPIA_FLUSH,       /* glFlush: manda in coda, non aspetta */
+    WINQ_SPIA_FINISH,      /* glFinish (e le due letture all'indietro, vedi winq-glspia.h) */
+    WINQ_SPIA_WAITSYNC,    /* glClientWaitSync: attesa su una fence esplicita */
+    WINQ_SPIA_GPU,         /* GL_TIME_ELAPSED: lavoro vero della Adreno */
+    WINQ_SPIA_N
+};
+
+/* QUARTA CORREZIONE DELL'11/08/2026, la piu' seria delle quattro: i contatori
+ * sono static globali SENZA affinita' di thread, e in_finestra lo alzano e
+ * abbassano solo winq_glspia_finestra_apri()/chiudi(), chiamate solo dal
+ * thread che decodifica (vrend_decode_ctx_submit_cmd). Due conseguenze:
+ *
+ * 1. "fuori dalla finestra" non vuol dire "sul thread principale": vuol dire
+ *    "mentre il thread principale non stava decodificando". Qualunque altro
+ *    thread che chiami una entry point avvolta -- in questo fork, il thread
+ *    dedicato "vrend-sync" che fa i wait bloccanti veri su glClientWaitSync
+ *    (vrend_renderer.c:7312, do_wait con can_block=true; il thread principale
+ *    ci arriva solo con can_block=false e timeout zero via
+ *    vrend_renderer_check_fences) -- finisce in fuori_ns/fuori_chiamate,
+ *    attribuendo al "fuori" del thread principale un tempo che non e' suo.
+ * 2. Anche i secchi "dentro" sono contaminati: se il thread di sync chiama un
+ *    wrapper mentre il thread principale tiene la finestra aperta, quel
+ *    tempo finisce in ns[]/chiamate[] -- il flag e' globale, non sa quale
+ *    thread lo sta leggendo.
+ *
+ * Percio' ogni secchio (dentro E fuori) si sdoppia per thread:
+ * WINQ_THREAD_PRINCIPALE e WINQ_THREAD_ALTRI. Non un terzo, un quarto... per
+ * ogni thread reale: quello risponderebbe a "quale thread" con una
+ * granularita' che nessuno ha chiesto e complicherebbe la struct (e la sua
+ * ridichiarazione a mano in QEMU) senza necessita' -- la domanda che conta e'
+ * "principale o non principale", perche' solo il thread principale possiede
+ * la finestra e solo i suoi campioni "dentro" hanno senso nella sottrazione
+ * (vedi virgl in hw/display/virtio-gpu-virgl.c). "Quali sono gli altri" e
+ * "quanti sono" restano una domanda aperta, a cui risponde il piccolo
+ * registro thread_altri_* piu' sotto, non un secchio per identita'. */
+enum {
+    WINQ_THREAD_PRINCIPALE = 0,
+    WINQ_THREAD_ALTRI,
+    WINQ_THREAD_N
+};
+
+/* Quante identita' di thread "altri" il registro (sotto) ricorda per nome.
+ * Oggi si conosce un solo candidato (vrend-sync); 8 lascia spazio a scoprirne
+ * altri senza inseguire un numero esatto. Se thread_altri_fuori_tabella nella
+ * riga di riepilogo e' > 0 vuol dire che ce ne sono di piu' di 8, e questo
+ * numero va alzato -- stessa logica di WINQ_CONTESTI in winq-glspia-gpu.c. */
+#define WINQ_THREAD_TABELLA 8
+
+/* QUINTA CORREZIONE DELL'11/08/2026: chi ha richiesto lo switch di contesto
+ * GL, non "quale contesto" -- il sospetto e' su una funzione chiamante
+ * (vrend_renderer_force_ctx_0(), invocata da QEMU prima di ogni comando),
+ * non su un contesto target. WINQ_CTX_FORCE0 marca esclusivamente le
+ * richieste che passano per quella funzione; ogni altro chiamante di
+ * vrend_hw_switch_context() (il percorso di decodifica, i trasferimenti, il
+ * ripristino dopo la distruzione di un contesto) e' WINQ_CTX_ALTRO -- vedi
+ * il commento sopra vrend_hw_switch_context() in vrend_renderer.c per
+ * l'elenco esatto dei chiamanti e la loro classificazione. */
+enum {
+    WINQ_CTX_FORCE0 = 0,
+    WINQ_CTX_ALTRO,
+    WINQ_CTX_N
+};
+
+struct winq_glspia {
+    uint64_t ns[WINQ_THREAD_N][WINQ_SPIA_N];
+    uint64_t chiamate[WINQ_THREAD_N][WINQ_SPIA_N];
+    uint64_t saltate;   /* query GPU non pronte quando la casella serviva */
+    uint64_t assurde;   /* campioni fuori banda o intervalli negativi */
+    /* CORREZIONE DELL'11/08/2026: la sottrazione virgl = cpu - gl - shader -
+     * attesa presupponeva che ogni chiamata GL avvolta cadesse dentro la
+     * finestra che "cpu" misura. Falso: virglrenderer chiama GL anche fuori
+     * da vrend_decode_ctx_submit_cmd (attesa sulle fence, trasferimenti,
+     * creazione di oggetti), e quel tempo veniva sottratto da un "cpu" che
+     * non lo includeva mai -- la causa dei 9 campioni su 10 con virgl=0. I
+     * tre campi sotto chiudono il buco: fuori_ns/fuori_chiamate contano cio'
+     * che i wrapper vedono a finestra chiusa (non e' un errore, quindi non
+     * passa da "assurde"), finestra_ns e' il tempo CPU dello stesso tratto
+     * che i secchi sopra misurano, cosi' che QEMU possa sottrarre da un
+     * denominatore che copre lo stesso perimetro del numeratore. Vedi
+     * winq_glspia_finestra_apri()/chiudi() e l'aggancio in vrend_decode.c.
+     *
+     * SECONDA CORREZIONE, STESSO GIORNO: la prima raccolta vera con la
+     * finestra corretta ha detto che "fuori" e' il 62% del secondo
+     * (623,9 ms/s contro 19,0 ms/s dentro, ~1.400 chiamate, 445 us/chiamata
+     * contro 2,7 us dentro) -- ma essendo fuori_ns/fuori_chiamate scalari,
+     * quel numero diceva solo QUANTO, non COSA. Ora sono array, PARALLELI a
+     * ns[]/chiamate[] con la stessa indicizzazione: fuori_ns[WINQ_SPIA_GL] e'
+     * il lavoro di disegno/buffer/texture visto a finestra chiusa,
+     * fuori_ns[WINQ_SPIA_SHADER] la compilazione shader fuori finestra, ecc.
+     * fuori_ns[WINQ_SPIA_GPU] resta sempre zero: le query GL_TIME_ELAPSED si
+     * aprono solo dentro la finestra (winq-glspia-gpu.c), quindi per quel
+     * secchio "fuori" non esiste come concetto -- non un buco, una riga
+     * dell'array semplicemente mai scritta. */
+    uint64_t fuori_ns[WINQ_THREAD_N][WINQ_SPIA_N];       /* lavoro GL per thread e secchio, a finestra chiusa */
+    uint64_t fuori_chiamate[WINQ_THREAD_N][WINQ_SPIA_N]; /* numero di quelle chiamate */
+    uint64_t finestra_ns;    /* tempo CPU del tratto cronometrato (decodifica) */
+    /* SONDA glGetError, aggiunta l'11/08/2026: t_gpu non si raccoglie quasi
+     * mai (saltate resta alto anche con l'anello a 256 caselle, smentendo
+     * l'ipotesi che fosse solo un problema di dimensione), e uno dei sospetti
+     * rimasti e' che glBeginQuery/glEndQuery falliscano in silenzio. Letta
+     * UNA volta per ciclo di riepilogo (non per submit: vedi
+     * winq_glspia_sonda_richiesta() e il commento in winq-glspia-gpu.c), non
+     * per ogni chiamata -- sarebbe percorso caldo altrimenti. sonda_eseguita
+     * dice se il ciclo appena letto ne conteneva una (0/1): senza questo
+     * campo un ciclo senza sonda e uno con GL_NO_ERROR (0) sarebbero
+     * indistinguibili leggendo solo i codici. */
+    uint64_t sonda_eseguita;
+    uint64_t sonda_errore_inizio; /* glGetError() subito dopo glBeginQuery */
+    uint64_t sonda_errore_fine;   /* glGetError() subito dopo glEndQuery */
+    /* QUARTA CORREZIONE DELL'11/08/2026: il registro dei thread. A differenza
+     * dei campi sopra, questi NON si azzerano a ogni lettura (winq_glspia_azzera()
+     * li salta apposta): sono un'identita' di processo, non un accumulo al
+     * secondo -- azzerarli ogni ciclo farebbe "sparire" dalla riga di
+     * riepilogo un thread visto nel ciclo precedente ma silente in questo. */
+    uint64_t thread_principale;      /* id, 0 = non ancora registrato */
+    uint64_t thread_altri_n;         /* quanti "altri" thread distinti in thread_altri_id[] */
+    uint64_t thread_altri_id[WINQ_THREAD_TABELLA]; /* i loro id; 0 = casella non usata */
+    uint64_t thread_altri_fuori_tabella; /* chiamate da un "altro" thread non riconosciuto a tabella piena */
+    /* QUINTA CORREZIONE DELL'11/08/2026: il primo consumatore del ciclo
+     * principale non era SUBMIT_3D ma 0x202 CTX_ATTACH_RESOURCE (923 us/
+     * chiamata), con un'asimmetria netta rispetto al detach (231 us) pur
+     * facendo lo stesso lavoro O(1) in tabella hash. Il sospetto, dedotto dal
+     * codice non misurato: virgl_renderer_force_ctx_0() (chiamata da QEMU
+     * incondizionatamente prima di OGNI comando, virtio-gpu-virgl.c:1471)
+     * azzera current_ctx/current_hw_ctx PRIMA di richiedere lo switch a ctx0
+     * -- quindi vrend_hw_switch_context() non puo' mai prendere la sua
+     * scorciatoia "e' gia' il contesto giusto", e vrend_finish_context_switch()
+     * chiama sempre wglMakeCurrent(), anche quando il contesto GL a livello
+     * di sistema operativo era gia' quello giusto (nel qual caso l'OS/driver
+     * puo' comunque farla franca in fretta -- questi contatori misurano il
+     * lato virglrenderer della storia, non il costo vero di wglMakeCurrent()).
+     * ctx_richiesti conta ogni chiamata a vrend_hw_switch_context();
+     * ctx_veri conta quante di quelle arrivano davvero a
+     * vrend_clicbs->make_current() (non scorciatoiate); ctx_ns e' il tempo
+     * cumulativo dentro quella chiamata. Tutti e tre per origine
+     * (WINQ_CTX_FORCE0/WINQ_CTX_ALTRO): il discriminante che decide se la
+     * cura sta in force_ctx_0() o altrove. */
+    uint64_t ctx_richiesti[WINQ_CTX_N];
+    uint64_t ctx_veri[WINQ_CTX_N];
+    uint64_t ctx_ns[WINQ_CTX_N];
+};
+
+/* Letta una volta sola dalla variabile WINQ_GPU_DIAG. Sul percorso caldo si
+ * legge questa, non getenv: getenv per chiamata GL costerebbe piu' della
+ * chiamata stessa. */
+int winq_glspia_accesa(void);
+
+uint64_t winq_glspia_ora(void);
+
+/* Il thread corrente, per l'etichetta dentro/altri della quarta correzione
+ * dell'11/08/2026 (vedi il commento sopra l'enum WINQ_THREAD_*). Lettura pura
+ * del TEB via GetCurrentThreadId(), NESSUN effetto collaterale -- a
+ * differenza di winq_glspia_thread_indice() sotto, non tocca il registro. E'
+ * la primitiva che sia il percorso caldo (via thread_indice()) sia
+ * winq_glspia_taratura_ns() chiamano, cosi' il costo che la taratura riporta
+ * e' lo stesso che il percorso caldo paga davvero. */
+uint64_t winq_glspia_thread_id(void);
+
+/* WINQ_THREAD_PRINCIPALE se il thread corrente e' quello registrato da
+ * winq_glspia_finestra_apri(), WINQ_THREAD_ALTRI altrimenti. Effetto
+ * collaterale se altri: registra l'id nel registro (struct winq_glspia,
+ * thread_altri_*) se non gia' visto -- una scansione di al piu'
+ * WINQ_THREAD_TABELLA elementi, niente allocazione, niente I/O. Chiamata una
+ * volta per chiamata GL avvolta (winq-glspia.h), non due: il chiamante passa
+ * il risultato ad aggiungi() o aggiungi_fuori(), non richiama questa. */
+int winq_glspia_thread_indice(void);
+
+void winq_glspia_aggiungi(int thread, int secchio, uint64_t t0, uint64_t t1);
+/* Come aggiungi(), converte un intervallo fra due letture di winq_glspia_ora()
+ * in nanosecondi -- ma senza sommarlo in un secchio: serve a chi ha bisogno
+ * del solo numero. L'aggancio di virgl_renderer_submit_cmd lo usa per passare
+ * a winq_glspia_gpu_chiudi() il tempo CPU vero in nanosecondi, non i tick
+ * grezzi di QueryPerformanceCounter: la banda di plausibilita' di
+ * winq-glspia-gpu.c confronta questo numero con i nanosecondi veri della
+ * query GL, e su Windows un tick non e' un nanosecondo (vedi
+ * qemu/probe/sonda-gltimer.c, che fa la stessa conversione per lo stesso
+ * motivo). Stessa guardia di aggiungi() sull'orologio che torna indietro:
+ * intervallo negativo -> 0, non un numero enorme. */
+uint64_t winq_glspia_intervallo_ns(uint64_t t0, uint64_t t1);
+
+/* L'interruttore di finestra. winq_glspia_finestra_apri()/chiudi() li alza e
+ * li abbassa l'aggancio in vrend_decode.c, sugli stessi confini di
+ * winq_glspia_gpu_apri()/gpu_chiudi(): e' lo stesso tratto, la stessa
+ * garanzia sul contesto GL corrente (vedi il commento in cima a
+ * vrend_decode_ctx_submit_cmd). winq_glspia_in_finestra() e' letta dalle
+ * macro di winq-glspia.h a ogni chiamata GL avvolta -- una lettura di
+ * variabile, niente di piu', per restare sul percorso caldo. */
+void winq_glspia_finestra_apri(void);
+void winq_glspia_finestra_chiudi(void);
+int winq_glspia_in_finestra(void);
+
+void winq_glspia_conta_saltata(void);
+void winq_glspia_conta_assurda(void);
+/* Come aggiungi(), stesso thread e stesso secchio, ma per il lavoro GL visto
+ * a finestra chiusa: scrive in fuori_ns[thread][secchio]/
+ * fuori_chiamate[thread][secchio] invece di ns[thread][secchio]/
+ * chiamate[thread][secchio]. Un thread o un secchio fuori bounds (indice
+ * invalido, un errore di chi chiama) si conta come assurda, esattamente come
+ * in aggiungi() -- la struttura e' un array a due dimensioni, e un indice
+ * sbagliato su uno dei due assi scriverebbe fuori dai bordi senza quella
+ * guardia. Le altre due guardie di aggiungi() (orologio indietro, frequenza
+ * non tarata) restano invece guardie silenziose qui: un campione scartato
+ * per quelle non e' un errore, e' lavoro fuori perimetro, e non tocca
+ * spia.assurde. */
+void winq_glspia_aggiungi_fuori(int thread, int secchio, uint64_t t0, uint64_t t1);
+/* I nanosecondi arrivano gia' convertiti dalla query GL, quindi non passano
+ * per aggiungi(), che converte da tick. */
+void winq_glspia_somma_gpu(uint64_t ns);
+/* Il tempo CPU della finestra di decodifica: stesso ns che l'aggancio passa a
+ * winq_glspia_gpu_chiudi() per la banda di plausibilita', sommato qui perche'
+ * QEMU lo legga e sottragga da un denominatore che copre lo stesso perimetro
+ * dei secchi sopra -- invece del proprio "cpu" misurato attorno a
+ * virgl_renderer_submit_cmd, che e' piu' largo della finestra (vedi la nota
+ * sulla struct winq_glspia). */
+void winq_glspia_somma_finestra(uint64_t ns);
+
+/* La sonda glGetError, letta una volta per ciclo di riepilogo. Il ciclo di
+ * vita, per chi implementa il lato GL (winq-glspia-gpu.c):
+ *   1. winq_glspia_leggi() arma la richiesta (per il ciclo che comincia ora).
+ *   2. Il primo gpu_apri() dopo l'armamento vede winq_glspia_sonda_richiesta()
+ *      vera, e chiama davvero epoxy_glGetError() subito dopo glBeginQuery --
+ *      passandone il risultato a winq_glspia_sonda_registra_inizio().
+ *   3. Lo stesso submit, in gpu_chiudi(), chiama epoxy_glGetError() subito
+ *      dopo glEndQuery e lo passa a winq_glspia_sonda_registra_fine(), che
+ *      DISARMA la richiesta: nessun altro submit la vedra' vera finche' la
+ *      prossima winq_glspia_leggi() non la riarma.
+ * Il chiamante deve leggere winq_glspia_sonda_richiesta() una volta in
+ * gpu_apri() e ricordare la risposta (es. in un campo della propria tabella
+ * per contesto) invece di richiamarla in gpu_chiudi(): la richiesta resta
+ * vera fra le due, ma un secondo contesto che si intromettesse nel frattempo
+ * (gpu_apri()/gpu_chiudi() di un'altra submit) altrimenti la vedrebbe vera
+ * anche lui e la sonderebbe due volte nello stesso ciclo. */
+int winq_glspia_sonda_richiesta(void);
+void winq_glspia_sonda_registra_inizio(uint64_t errore);
+void winq_glspia_sonda_registra_fine(uint64_t errore);
+
+/* Diagnostica dello switch di contesto GL, aggiunta l'11/08/2026 -- vedi il
+ * commento sopra l'enum WINQ_CTX_* e sulla struct. Chiamate da
+ * vrend_hw_switch_context() (vrend_renderer.c), gia' dietro
+ * winq_glspia_accesa() nel chiamante: qui dentro non c'e' un'altra guardia
+ * sulla diagnostica, solo sui bordi dell'array, come per aggiungi(). Un
+ * origine fuori bounds e' un errore di chi chiama (indice invalido) e si
+ * conta come assurda, non come richiesta o switch vero. */
+void winq_glspia_ctx_richiesto(int origine);
+/* ns e' il tempo dentro vrend_clicbs->make_current(), gia' convertito --
+ * stessa forma di somma_gpu()/somma_finestra(), non passa da aggiungi(). */
+void winq_glspia_ctx_vero(int origine, uint64_t ns);
+
+void winq_glspia_azzera(void);
+uint64_t winq_glspia_taratura_ns(void);
+
+/* Fotografia che azzera. Esportata: la chiama QEMU con GetProcAddress. */
+WINQ_SPIA_ESPORTA void winq_glspia_leggi(struct winq_glspia *fuori);
+
+/* Solo per le prove: rendono deterministica la conversione tick -> ns. */
+void winq_glspia_freq_forza(uint64_t hz);
+void winq_glspia_freq_vera(void);
+
+/* Solo per le prove: rendono deterministico il thread "corrente" che
+ * winq_glspia_thread_id() restituisce, senza dover creare un secondo thread
+ * vero per simulare "altri" -- stesso schema di freq_forza()/freq_vera().
+ * tid == 0 in winq_glspia_thread_forza() equivale a chiamare
+ * winq_glspia_thread_vero(): 0 non e' mai un id di thread vero su Windows,
+ * la stessa sentinella che thread_principale usa per "non registrato". */
+void winq_glspia_thread_forza(uint64_t tid);
+void winq_glspia_thread_vero(void);
+/* Solo per le prove: in produzione il registro (thread_principale e
+ * thread_altri_*) non si azzera mai -- vedi il commento sulla struct. Le
+ * prove hanno bisogno di uno stato di partenza noto fra un caso e l'altro. */
+void winq_glspia_thread_azzera_registro(void);
+
+/* L'anello delle query GL_TIME_ELAPSED. Vive in winq-glspia-gpu.c, che e'
+ * l'unico file dello shim che tocca GL -- percio' le prove di
+ * research/scripts/test-glspia.sh non lo compilano. */
+void winq_glspia_gpu_apri(void);
+void winq_glspia_gpu_chiudi(uint64_t t_cpu_ns);
+
+#endif /* WINQ_GLSPIA_CONTA_H */
diff --git a/src/winq-glspia-gpu.c b/src/winq-glspia-gpu.c
new file mode 100644
index 0000000..96fdb17
--- /dev/null
+++ b/src/winq-glspia-gpu.c
@@ -0,0 +1,280 @@
+/* winq-glspia-gpu.c -- l'anello delle query GL_TIME_ELAPSED, per contesto GL.
+ *
+ * PERCHE' PER CONTESTO E NON PER PROCESSO. Un query object GL non si
+ * condivide fra contesti (a differenza di texture e buffer, non fa parte del
+ * gruppo di condivisione): un id generato nel contesto A e' invalido nel
+ * contesto B, e glBeginQuery su un contesto che non e' quello per cui l'id
+ * fu creato fallisce con GL_INVALID_OPERATION -- che nessuno legge. Ogni
+ * vrend_sub_context ha il proprio HGLRC (vrend_renderer.c, vrend_create_sub_ctx)
+ * e su Android piu' contesti si alternano a ogni frame: non e' un caso
+ * limite, e' la normalita'. Percio' l'anello, l'inizializzazione
+ * dell'estensione e lo stato "query in corso" sono per contesto, indicizzati
+ * dall'HGLRC restituito da wglGetCurrentContext().
+ *
+ * PERCHE' UN ANELLO E NON UNA LETTURA DIRETTA. Leggere GL_QUERY_RESULT subito
+ * dopo glEndQuery blocca finche' la GPU non ha finito: serializzerebbe la
+ * catena e cambierebbe la cosa che si sta misurando, restituendo numeri
+ * plausibili e falsi. Si apre la casella i, e prima di riusarla si guarda se
+ * il risultato di allora e' pronto. Se non lo e' si SALTA e si conta -- non si
+ * aspetta mai.
+ *
+ * PERCHE' NIENTE GUARDIA "DISGIUNTO". GL_GPU_DISJOINT appartiene a
+ * EXT_disjoint_timer_query, che e' un'estensione di OpenGL ES. Qui il contesto
+ * dell'host e' desktop 4.6 core via WGL (qemu/WGL.md) e GL_ARB_timer_query non
+ * offre alcun segnale di disgiunzione. Al suo posto una banda di plausibilita':
+ * zero, o piu' di dieci volte il tempo CPU della submit, e' un campione che si
+ * butta contandolo.
+ */
+#include "winq-glspia-conta.h"
+
+#include <epoxy/gl.h>
+/* epoxy/wgl.h e non <windows.h> a mano: risolve wglGetCurrentContext() come
+ * epoxy_wglGetCurrentContext() (dispatch pigro di epoxy, wgl_generated.h),
+ * la stessa via che questo shim usa gia' per ogni altra chiamata GL -- niente
+ * dipendenza di collegamento nuova verso opengl32.lib da giustificare in una
+ * patch che vive sopra l'upstream. Porta con se' <windows.h> (per HGLRC),
+ * quindi non va incluso a parte. */
+#include <epoxy/wgl.h>
+
+/* WINQ_ANELLO: quante caselle nell'anello per contesto, cioe' ogni quante
+ * submit una casella viene riusata (raccogli() sulla casella piu' vecchia,
+ * poi glBeginQuery ci riapre sopra -- vedi gpu_apri() sotto).
+ *
+ * DIMENSIONATO L'11/08/2026 sulla misura di produzione, dopo la correzione
+ * della finestra: submit=609/s. Con il valore precedente (8 caselle)
+ * l'intervallo di riuso era 8/609 s ~= 13,1 ms -- troppo poco perche' la
+ * query GL_TIME_ELAPSED fosse quasi mai pronta: saltate=487/s, assurde=96/s,
+ * 9-13 campioni raccolti su 609 (1,5-2%). t_gpu non era utilizzabile come
+ * aggregato.
+ *
+ * 256 caselle portano l'intervallo di riuso a 256/609 s ~= 420 ms, ~32 volte
+ * quello che falliva: margine ampio anche per code GPU sotto carico. Preferito
+ * ad allungare l'intervallo campionando una submit ogni N (che avrebbe
+ * scartato lavoro a monte, non solo risultati in ritardo) perche' qui il
+ * costo e' solo memoria, non rappresentativita': ogni submit apre ancora la
+ * sua query, nessuna viene saltata all'apertura per campionamento. Il costo:
+ * sizeof(GLuint) + sizeof(uint64_t) + sizeof(int) = 4 + 8 + 4 = 16 byte per
+ * casella (vedi i tre array in struct winq_ctx sotto), quindi 256 * 16 = 4 KB
+ * per contesto, 32 KB su WINQ_CONTESTI (8) contesti, e nel caso peggiore
+ * 256 * 8 = 2048 query object GL in tutto -- trascurabile per un driver che
+ * ne supporta tipicamente migliaia. Se una futura misura mostrasse ancora
+ * "saltati" > 0 a un tasso di submit piu' alto di questo, va rifatto lo
+ * stesso conto con il nuovo tasso, non alzato a occhio. */
+#define WINQ_ANELLO 256
+#define WINQ_BANDA  10   /* t_gpu oltre 10 x t_cpu non e' un numero, e' un errore */
+
+/* WINQ_CONTESTI: quanti contesti GL distinti questo shim puo' cronometrare
+ * contemporaneamente. Ogni vrend_sub_context ha il proprio HGLRC e su
+ * Android piu' contesti si alternano a ogni frame (vedi il commento in cima
+ * al file): 8 copre comodamente un client con piu' sub-contesti vivi insieme
+ * senza riservare memoria per un caso mai osservato. Se la riga di riepilogo
+ * mostra "contesti saltati" > 0, questo numero va alzato, non ignorato --
+ * vedi trova_o_crea() sotto. */
+#define WINQ_CONTESTI 8
+
+struct winq_ctx {
+    HGLRC contesto;                     /* NULL = voce libera */
+    GLuint query[WINQ_ANELLO];
+    uint64_t cpu_ns[WINQ_ANELLO];       /* il t_cpu della submit di quella casella */
+    int aperta[WINQ_ANELLO];
+    int prossima;
+    int pronto;      /* -1 = estensione assente PER QUESTO contesto, 0 = da inizializzare, 1 = ok */
+    int in_corso;
+    /* SONDA glGetError, aggiunta l'11/08/2026 (vedi il commento sopra
+     * winq_glspia_sonda_richiesta() in winq-glspia-conta.h). Deciso qui, non
+     * riletto in gpu_chiudi(): la richiesta resta vera fra apri() e chiudi()
+     * della stessa submit, ma rileggerla in chiudi() invece di ricordare la
+     * risposta di apri() rischierebbe di sondare due volte se un'altra
+     * submit (altro contesto) si intromettesse nel frattempo e vedesse la
+     * stessa richiesta ancora armata. */
+    int sonda_in_corso;
+};
+
+static struct winq_ctx tabella[WINQ_CONTESTI];
+
+/* Trova la voce di 'corrente' nella tabella, o ne assegna una libera se
+ * 'corrente' e' un contesto mai visto. Restituisce NULL se il contesto non
+ * c'era e la tabella e' piena: il chiamante conta il fatto e rinuncia, non
+ * apre query per i contesti in eccesso.
+ *
+ * NIENTE liberazione di voci alla distruzione di un contesto: questo file
+ * non ha un aggancio per sapere quando un HGLRC muore (vrend_destroy_sub_context
+ * non chiama nulla di winq), e un pugno di query object persi a fine sessione
+ * -- al piu' WINQ_CONTESTI * WINQ_ANELLO, liberati dal driver alla chiusura
+ * del processo -- non e' un problema che giustifichi l'aggancio. Decisione
+ * esplicita, non una svista: vedi la review che ha introdotto questo file. */
+static struct winq_ctx *trova_o_crea(HGLRC corrente)
+{
+    int libera = -1;
+    int i;
+
+    for (i = 0; i < WINQ_CONTESTI; i++) {
+        if (tabella[i].contesto == corrente)
+            return &tabella[i];
+        if (libera < 0 && tabella[i].contesto == NULL)
+            libera = i;
+    }
+    if (libera < 0)
+        return NULL;
+
+    tabella[libera].contesto = corrente;
+    return &tabella[libera];
+}
+
+static int inizializza(struct winq_ctx *c)
+{
+    if (c->pronto) {
+        return c->pronto > 0;
+    }
+    /* Per contesto e non per processo: contesti diversi (driver diversi, o
+     * lo stesso driver con capacita' negoziate diversamente) possono in
+     * teoria esporre insiemi diversi di estensioni. */
+    if (!epoxy_has_gl_extension("GL_ARB_timer_query")) {
+        c->pronto = -1;
+        return 0;
+    }
+    /* epoxy_glGenQueries e non glGenQueries: winq-glspia.h non avvolge questa
+     * funzione, ma scriverla per esteso rende il file leggibile da solo. */
+    epoxy_glGenQueries(WINQ_ANELLO, c->query);
+    c->pronto = 1;
+    return 1;
+}
+
+/* Raccoglie il risultato della casella, se c'e'. Non aspetta mai. */
+static void raccogli(struct winq_ctx *c, int i)
+{
+    GLint disponibile = 0;
+    GLuint64 ns = 0;
+
+    if (!c->aperta[i]) {
+        return;
+    }
+    epoxy_glGetQueryObjectiv(c->query[i], GL_QUERY_RESULT_AVAILABLE, &disponibile);
+    if (!disponibile) {
+        winq_glspia_conta_saltata();
+        c->aperta[i] = 0;
+        return;
+    }
+    epoxy_glGetQueryObjectui64v(c->query[i], GL_QUERY_RESULT, &ns);
+    c->aperta[i] = 0;
+
+    /* cpu_ns[i] == 0 capita quando l'orologio e' tornato indietro fra apri()
+     * e chiudi() di quella casella (guardia di winq_glspia_intervallo_ns) o
+     * quando la submit e' stata piu' veloce della risoluzione del tick: in
+     * entrambi i casi non c'e' un t_cpu valido con cui giudicare la
+     * plausibilita' del campione GPU. Si SCARTA anziche' accettarlo senza
+     * controllo superiore -- la banda esiste per contare i campioni assurdi,
+     * non per lasciare un varco dove non sa rispondere. */
+    if (ns == 0 || c->cpu_ns[i] == 0 || ns > c->cpu_ns[i] * WINQ_BANDA) {
+        winq_glspia_conta_assurda();
+        return;
+    }
+    /* aggiungi vuole due tick e converte; qui i nanosecondi ci sono gia'.
+     * Con la frequenza forzata a un miliardo il tick E' il nanosecondo, ma
+     * forzarla qui romperebbe gli altri secchi: si passa 0 e ns come istanti,
+     * il che e' esatto solo se la frequenza e' 1 GHz. Percio' NON si usa
+     * aggiungi: si somma direttamente nel secchio dedicato. */
+    winq_glspia_somma_gpu(ns);
+}
+
+void winq_glspia_gpu_apri(void)
+{
+    HGLRC corrente;
+    struct winq_ctx *c;
+
+    if (!winq_glspia_accesa()) {
+        return;
+    }
+
+    corrente = wglGetCurrentContext();
+    if (!corrente) {
+        /* Nessun contesto corrente: aprire una query qui sarebbe esattamente
+         * il difetto trovato in review (glBeginQuery sul contesto lasciato
+         * dalla submit precedente, o su nessuno alla primissima chiamata).
+         * Si conta come un salto: un campione perso, non un errore da
+         * nascondere. */
+        winq_glspia_conta_saltata();
+        return;
+    }
+
+    c = trova_o_crea(corrente);
+    if (!c) {
+        /* Tabella piena: questo contesto resta senza cronometraggio. Si
+         * conta con lo stesso contatore dei salti -- e' un campione perso
+         * per lo stesso motivo di fondo (nessuna casella disponibile), non
+         * un evento diverso da distinguere in questa fase. */
+        winq_glspia_conta_saltata();
+        return;
+    }
+
+    if (!inizializza(c) || c->in_corso) {
+        return;
+    }
+    raccogli(c, c->prossima);
+    /* Letta una volta, ricordata in c->sonda_in_corso: chiudi() la user
+     * senza richiamare winq_glspia_sonda_richiesta(), vedi il commento sul
+     * campo in struct winq_ctx sopra. Il costo a diagnostica accesa e' una
+     * lettura di variabile per submit, come winq_glspia_in_finestra(); le
+     * due chiamate GL vere a glGetError() (sotto e in chiudi()) scattano
+     * solo sulla submit che trova la richiesta armata, una volta per ciclo
+     * di riepilogo. */
+    c->sonda_in_corso = winq_glspia_sonda_richiesta();
+    epoxy_glBeginQuery(GL_TIME_ELAPSED, c->query[c->prossima]);
+    if (c->sonda_in_corso) {
+        winq_glspia_sonda_registra_inizio((uint64_t)epoxy_glGetError());
+    }
+    c->aperta[c->prossima] = 1;
+    c->in_corso = 1;
+}
+
+/* La guardia winq_glspia_accesa() qui in cima e' asimmetrica rispetto ad
+ * apri(), che ce l'ha da sempre (vedi :185): AGGIUNTA perche' mancava, ed era
+ * un effetto collaterale di STATO a diagnostica completamente spenta.
+ * Senza di essa questa funzione, chiamata incondizionatamente da
+ * vrend_decode_ctx_submit_cmd (vrend_decode.c) a ogni submit, eseguiva
+ * comunque wglGetCurrentContext() e soprattutto trova_o_crea(), che CREA
+ * voci: la tabella dei WINQ_CONTESTI (8) si riempiva anche in una corsa senza
+ * WINQ_GPU_DIAG. E poiche' le voci non si liberano mai (dichiarato sopra
+ * trova_o_crea), da quel momento ogni contesto nuovo era senza
+ * cronometraggio -- comprese le corse in cui la diagnostica veniva accesa
+ * dopo. Uno strumento spento non deve lasciare tracce, men che meno tracce
+ * che rompono lo strumento acceso.
+ *
+ * DIFETTO NOTO, NON RIPARATO QUI, e va scritto perche' non si perda. I due
+ * ritorni silenziosi qui sotto (nessun contesto corrente, oppure contesto
+ * diverso da quello che aveva aperto) lasciano c->in_corso a 1 sulla voce di
+ * QUEL contesto: da quel momento ogni apri() su di esso esce a :210 senza
+ * aprire nulla, per sempre. E' un candidato per il fatto misurato che t_gpu
+ * riporti zero campioni su 769 cicli consecutivi -- l'altro candidato e' la
+ * tabella piena a WINQ_CONTESTI (8), che non si libera mai. I due si
+ * distinguono solo sdoppiando il contatore "saltate" nelle sue cause, che
+ * richiede campi nuovi nella struttura e non entra in questa patch. Sbloccare
+ * a tappeto NON e' il rimedio: la query GL_TIME_ELAPSED su quel contesto
+ * resterebbe aperta, e il glBeginQuery successivo fallirebbe con
+ * GL_INVALID_OPERATION -- si sposterebbe il guasto, non lo si toglierebbe. */
+void winq_glspia_gpu_chiudi(uint64_t t_cpu_ns)
+{
+    HGLRC corrente;
+    struct winq_ctx *c;
+
+    if (!winq_glspia_accesa()) {
+        return;
+    }
+
+    corrente = wglGetCurrentContext();
+    if (!corrente) {
+        return;
+    }
+    c = trova_o_crea(corrente);
+    if (!c || !c->in_corso) {
+        return;
+    }
+    epoxy_glEndQuery(GL_TIME_ELAPSED);
+    if (c->sonda_in_corso) {
+        winq_glspia_sonda_registra_fine((uint64_t)epoxy_glGetError());
+        c->sonda_in_corso = 0;
+    }
+    c->cpu_ns[c->prossima] = t_cpu_ns;
+    c->prossima = (c->prossima + 1) % WINQ_ANELLO;
+    c->in_corso = 0;
+}
