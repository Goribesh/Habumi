+
+    printf("la lettura azzera anche i campi nuovi:\n");
+    winq_glspia_freq_forza(1000000);
+    winq_glspia_azzera();
+
+    winq_glspia_aggiungi_fuori(WINQ_THREAD_PRINCIPALE, WINQ_SPIA_WAITSYNC, 0, 1000);
+    winq_glspia_somma_finestra(500000);
