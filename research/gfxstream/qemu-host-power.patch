+bool whpx_host_suspend_time(void)
+{
+    HRESULT hr;
+    g_assert(bql_locked());
+    if (!whpx_allowed || whpx_global.running_cpus ||
+        !whp_dispatch.WHvSuspendPartitionTime) {
+        return false;
+    }
+    hr = whp_dispatch.WHvSuspendPartitionTime(whpx_global.partition);
+    if (FAILED(hr)) {
+        error_report("winq/power: WHPX partition time suspend failed: 0x%08lx", hr);
+        return false;
+    }
+    /* WHvRunVirtualProcessor resumes partition time on the next vm_start. */
+    return true;
+}
