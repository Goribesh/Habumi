+/* winq: LE FASI DENTRO IL GESTORE DI UN COMANDO, dietro WINQ_GPU_DIAG.
+ *
+ * PERCHE'. winq-cmd/s (virtio-gpu.c) dice quanto costa un TIPO di comando;
+ * winq-tempo/s dice cosa succede dentro virgl_renderer_submit_cmd. Fra i due
+ * c'e' un buco, e sotto carico e' il buco piu' grosso rimasto: il gestore di
+ * SUBMIT_3D costa ~800 us e cpu_qemu ne spiega ~290. I ~510 us restanti
+ * stanno in tratti che NESSUNA delle due diagnostiche avvolge -- la
+ * force_ctx_0() prima dello switch, la copia degli iov, la coda che crea la
+ * fence. Non si deduce quale pesi: si cronometra uno per uno.
+ *
+ * PERCHE' SOLO PER SUBMIT_3D. E' il comando su cui verte la domanda, e
+ * filtrare tiene i contatori a cinque caselle invece di 1024x5: la riga si
+ * legge senza sommare a mano. Gli altri tipi restano coperti da winq-cmd/s.
+ *
+ * LE FASI SI ANNIDANO, e va saputo leggendo la riga: DISPATCH contiene IOV e
+ * SUBMIT (sono dentro il gestore chiamato dallo switch). FORCE0 e CODA sono
+ * invece disgiunte da tutto. Quindi il conto che deve tornare e'
+ * FORCE0 + DISPATCH + CODA ~= il numero di winq-cmd/s per il tipo 0x207,
+ * e dentro DISPATCH resta IOV + SUBMIT + il resto del gestore.
+ *
+ * LA SUBMIT CHE STAMPA IL RIEPILOGO NON SI CONTA. Le otto (ora nove)
+ * error_report del riepilogo escono da dentro virgl_cmd_submit_3d, cioe' da
+ * dentro la fase DISPATCH di quella submit: misurate 22 us con il lettore
+ * della pipe veloce e fino a 2,85 ms con il lettore lento, quanto un'intera
+ * submit. Contare quel campione sposterebbe la media di DISPATCH. Si salta e
+ * si conta quante volte (winq_fase_scartate), invece di nasconderlo.
+ * NON e' il rimedio completo: quel burst resta dentro il numero di
+ * winq-cmd/s per 0x207 e dentro peggior_blocco, come prima di questa patch.
+ * Il rimedio vero -- emettere il riepilogo da virtio_gpu_gl_handle_ctrl,
+ * fuori da ogni finestra per-comando -- e' una ristrutturazione piu' grande e
+ * resta da fare. */
+enum {
+    WINQ_FASE_FORCE0 = 0,   /* virgl_renderer_force_ctx_0(), prima dello switch */
+    WINQ_FASE_IOV,          /* g_malloc + iov_to_buf del command buffer */
+    WINQ_FASE_SUBMIT,       /* virgl_renderer_submit_cmd() -- lo stesso di cpu_qemu */
+    WINQ_FASE_DISPATCH,     /* lo switch dei tipi per intero: contiene IOV e SUBMIT */
+    WINQ_FASE_CODA,         /* risposta sulla virtqueue e creazione della fence */
+    WINQ_FASE_N
+};
+
+static uint64_t winq_fase_us[WINQ_FASE_N];
+static uint64_t winq_fase_n[WINQ_FASE_N];
+static unsigned long winq_fase_scartate;
+static int winq_fase_sporca;    /* questa submit ha stampato il riepilogo */
+
+/* Le due meta' di virtio_gpu_fence_poll(), che winq-gpu/s somma in un termine
+ * solo chiamandolo "fence". Vedi il commento dentro virtio_gpu_fence_poll(). */
+static uint64_t winq_poll_us;        /* virgl_renderer_poll() vero */
+static uint64_t winq_poll_cmdq_us;   /* il secondo giro di comandi che ci sta dentro */
+static uint64_t winq_poll_n;
+
+/* Il controllo della variabile d'ambiente, memorizzato in una statica.
+ *
+ * MISURATO su questa macchina: getenv() su UCRT costa 2,7 us -- ventidue
+ * volte GetEnvironmentVariableA -- perche' rimaterializza il blocco
+ * d'ambiente stretto a ogni chiamata, e il costo non dipende dal fatto che la
+ * variabile ci sia. I siti non memorizzati di questo albero ne facevano
+ * ~2400 al secondo sul ciclo principale: 8,1 ms/s pagati SEMPRE, anche a
+ * diagnostica spenta. E' una tassa sulla linea di base, quindi falsa il
+ * confronto con un QEMU non strumentato (i confronti A/B fra due corse
+ * strumentate invece si annullano). Quello dentro virgl_cmd_submit_3d cadeva
+ * per giunta DENTRO la finestra che winq-cmd/s cronometra per il tipo 0x207:
+ * gonfiava di 2,7 us proprio il numero che stiamo inseguendo.
+ *
+ * SEMANTICA INVARIATA DI PROPOSITO: "impostata", non "vale 1" -- come faceva
+ * il getenv() nudo che questa funzione sostituisce. Il fork invece pretende
+ * '1' (winq_glspia_accesa(), src/winq-glspia-conta.c). La divergenza esiste
+ * da prima ed e' qui DICHIARATA, non corretta: allinearla dentro una patch
+ * che vuole cambiare solo il costo introdurrebbe un cambio di comportamento
+ * silenzioso, ed e' esattamente il genere di cosa che costa ore. */
+static bool winq_gpu_diag(void)
+{
+    static int acceso = -1;
+
+    if (acceso < 0) {
+        acceso = getenv("WINQ_GPU_DIAG") ? 1 : 0;
+    }
+    return acceso != 0;
+}
+
+/* Un intervallo negativo non e' un campione corto: e' l'orologio che e'
+ * tornato indietro fra i due core. Sommato senza segno diventerebbe un numero
+ * enorme e falserebbe l'intero secondo -- stessa guardia di
+ * winq_glspia_aggiungi() nel fork. Si scarta in silenzio: qui non c'e' un
+ * secchio "assurde" da alimentare. */
+static void winq_fase_somma(uint32_t tipo, int fase, int64_t us)
+{
+    if (tipo != VIRTIO_GPU_CMD_SUBMIT_3D) {
+        return;
+    }
+    if (fase < 0 || fase >= WINQ_FASE_N || us < 0) {
+        return;
+    }
+    winq_fase_us[fase] += (uint64_t)us;
+    winq_fase_n[fase]++;
+}
