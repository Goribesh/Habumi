+/* La coda del gestore di un comando, estratta perche' abbia un cronometro.
+ *
+ * PERCHE' UNA FUNZIONE E NON UN CRONOMETRO IN LINEA. Questo tratto ha CINQUE
+ * uscite: comando sospeso o gia' finito, errore, nessuna fence richiesta,
+ * fence con ring_idx, fence normale. Un cronometro in linea andrebbe chiuso
+ * su tutte e cinque, e la sesta che qualcuno aggiungera' domani non lo
+ * chiuderebbe: quel tempo sparirebbe in silenzio invece di dare un errore.
+ * Spostando le uscite dentro una funzione, il cronometro si chiude una volta
+ * sola al sito di chiamata e non puo' essere saltato.
+ *
+ * NESSUN CAMBIO DI COMPORTAMENTO: il corpo e' quello di prima, spostato senza
+ * modifiche. `ret` era una locale di virtio_gpu_virgl_process_cmd usata solo
+ * qui dentro, e si e' spostata con lui. */
+static void winq_process_cmd_coda(VirtIOGPU *g,
+                                  struct virtio_gpu_ctrl_command *cmd,
+                                  bool cmd_suspended)
+{
+    int ret;
+
+    if (cmd_suspended || cmd->finished) {
+        return;
+    }
+    if (cmd->error) {
+        fprintf(stderr, "%s: ctrl 0x%x, error 0x%x\n", __func__,
+                cmd->cmd_hdr.type, cmd->error);
+        virtio_gpu_ctrl_response_nodata(g, cmd, cmd->error);
+        return;
+    }
+    if (!(cmd->cmd_hdr.flags & VIRTIO_GPU_FLAG_FENCE)) {
+        virtio_gpu_ctrl_response_nodata(g, cmd, VIRTIO_GPU_RESP_OK_NODATA);
+        return;
+    }
+
+    trace_virtio_gpu_fence_ctrl(cmd->cmd_hdr.fence_id, cmd->cmd_hdr.type);
+#if VIRGL_VERSION_MAJOR >= 1
+    if (cmd->cmd_hdr.flags & VIRTIO_GPU_FLAG_INFO_RING_IDX) {
+        const uint32_t flags = VIRGL_RENDERER_FENCE_FLAG_MERGEABLE;
+
+        ret = virgl_renderer_context_create_fence(cmd->cmd_hdr.ctx_id, flags,
+                                                  cmd->cmd_hdr.ring_idx,
+                                                  cmd->cmd_hdr.fence_id);
+        if (ret) {
+            qemu_log_mask(LOG_GUEST_ERROR,
+                          "%s: virgl_renderer_context_create_fence error: %s",
+                          __func__, strerror(-ret));
+        }
+        return;
+    }
+#endif
+
+    /*
+     * Unlike other virglrenderer functions, this one returns a positive
+     * error code.
+     */
+    ret = virgl_renderer_create_fence(cmd->cmd_hdr.fence_id, 0);
+    if (ret) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: virgl_renderer_create_fence error: %s",
+                      __func__, strerror(ret));
+    }
+}
