 # @egl-headless: No user interface, offload GL operations to a local
 #     DRI device.  Graphical display need to be paired with VNC or
 #     Spice.  (Since 3.1)
@@ -1521,6 +1524,7 @@
     { 'name': 'none' },
     { 'name': 'gtk', 'if': 'CONFIG_GTK' },
     { 'name': 'sdl', 'if': 'CONFIG_SDL' },
+    { 'name': 'winq' },
     { 'name': 'egl-headless', 'if': 'CONFIG_OPENGL' },
