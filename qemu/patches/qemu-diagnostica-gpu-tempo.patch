+#define WINQ_THREAD_TABELLA 8
+enum { WINQ_CTX_FORCE0 = 0, WINQ_CTX_ALTRO, WINQ_CTX_N };
+
+struct winq_glspia {
+    uint64_t ns[WINQ_THREAD_N][WINQ_SPIA_N];
+    uint64_t chiamate[WINQ_THREAD_N][WINQ_SPIA_N];
+    uint64_t saltate;
+    uint64_t assurde;
+    uint64_t fuori_ns[WINQ_THREAD_N][WINQ_SPIA_N];
+    uint64_t fuori_chiamate[WINQ_THREAD_N][WINQ_SPIA_N];
+    uint64_t finestra_ns;
+    uint64_t sonda_eseguita;
+    uint64_t sonda_errore_inizio;
+    uint64_t sonda_errore_fine;
+    uint64_t thread_principale;
+    uint64_t thread_altri_n;
+    uint64_t thread_altri_id[WINQ_THREAD_TABELLA];
+    uint64_t thread_altri_fuori_tabella;
+    uint64_t ctx_richiesti[WINQ_CTX_N];
+    uint64_t ctx_veri[WINQ_CTX_N];
+    uint64_t ctx_ns[WINQ_CTX_N];
+};
+
+typedef void (*winq_spia_leggi_fn)(struct winq_glspia *);
+
+/* Risolto una volta sola. GetModuleHandle e non LoadLibrary: la DLL e' gia'
+ * caricata, e caricarla una seconda volta darebbe un'altra istanza dei
+ * contatori, cioe' zeri per sempre. */
+static winq_spia_leggi_fn winq_spia_leggi;
+static int winq_spia_stato;   /* 0 = da risolvere, 1 = c'e', -1 = assente */
+
+static int winq_spia_pronta(void)
+{
+#ifdef _WIN32
+    HMODULE dll;
+
+    if (winq_spia_stato) {
+        return winq_spia_stato > 0;
+    }
+    dll = GetModuleHandleA("libvirglrenderer-1.dll");
+    if (dll) {
+        winq_spia_leggi = (winq_spia_leggi_fn)
+            GetProcAddress(dll, "winq_glspia_leggi");
+    }
+    if (!winq_spia_leggi) {
+        /* Si DICE, invece di stampare zeri che sembrerebbero una misura. */
+        error_report("winq-tempo: shim assente in libvirglrenderer-1.dll, "
+                     "diagnostica spenta");
+        winq_spia_stato = -1;
+        return 0;
+    }
+    winq_spia_stato = 1;
+    return 1;
+#else
+    return 0;
+#endif
+}
